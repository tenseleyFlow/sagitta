# SPEC: §4, §16
# COVERS: buf.current buf.list buf.open buf.close buf.save buf.path buf.name
# COVERS: buf.lang buf.len buf.lines buf.text buf.line buf.span buf.line_span
# COVERS: buf.insert buf.delete buf.find buf.find_all buf.dirty buf.readonly
# COVERS: buf.mark win.current win.list win.buf win.cursors win.selection
# COVERS: win.split win.close win.focus win.viewport win.set_cursors cur.pos
# COVERS: cur.line cur.col cur.anchor cur.span cur.goto cur.move cur.word
# COVERS: cur.line_span cur.insert cur.is_primary cur.valid span.lo span.hi
# COVERS: span.len span.text span.lines span.replace span.replace_lines
# COVERS: span.prepend span.append span.delete span.yank span.valid opt.get opt.set
# COVERS: ed.run ed.commands bind unbind set record replay
# COVERS: ai.backend
# COVERS: kind:handle
# ERROR_KIND: handle
# ERROR: no editor
# EXIT: 1
#
# THE EDITOR API, AS A HEADLESS SCRIPT SEES IT.
#
# The conformance runner has no editor, and that is the point of this
# half of the file: `buf` EXISTS -- it is a builtin module like `io` --
# and every native on it refuses cleanly with spec §9's "handle" rather
# than being an undefined name.  Invariant 3's rule is that an
# unavailable path says so; "undefined name 'buf'" would send a user
# hunting a spelling mistake that is not there.
#
# What an editor-attached run does instead is Sprint 34's pty and unit
# coverage.  A conformance file cannot assert it, because there is no
# editor here to attach -- so it asserts the contract that holds
# EVERYWHERE, which is that the refusal is catchable and typed.
import io
import buf
import win
import cur
import span
import opt
import ed
import ai
import list

fn refuses(kind, thunk) {
    try {
        thunk()
        error("editor native unexpectedly succeeded")
    } catch e {
        if e.kind != kind { error("editor native raised the wrong kind") }
    }
}

# -- the module is real, and its natives refuse without an editor ------
try {
    io.print(buf.current())
} catch e {
    # OUT: handle
    io.print(e.kind)
}

# -- a non-handle is a TYPE error, not a handle one --------------------
# The distinction is what amendment A2 exists for: `catch` has to tell
# "you passed the wrong thing" from "the buffer closed under you".  Only
# the first is the script's fault.
try {
    io.print(buf.len(42))
} catch e {
    # OUT: type
    io.print(e.kind)
}
try {
    io.print(buf.path("not a handle"))
} catch e {
    # OUT: type
    io.print(e.kind)
}
try {
    io.print(buf.text(nil))
} catch e {
    # OUT: type
    io.print(e.kind)
}

# -- every remaining editor native is present and safely typed ----------
# These are 47 independent headless scenarios in addition to the four
# above.  Wrong receiver types must be rejected before any editor pointer
# can be consulted; free functions must report the unavailable host.
refuses("handle", fn() { buf.list() })
refuses("handle", fn() { ai.backend("local", {}) })
refuses("handle", fn() { buf.open("missing") })
refuses("type", fn() { buf.close(42) })
refuses("type", fn() { buf.save(42) })
refuses("type", fn() { buf.name(42) })
refuses("type", fn() { buf.lang(42) })
refuses("type", fn() { buf.lines(42) })
refuses("type", fn() { buf.line(42, 1) })
refuses("type", fn() { buf.span(42, 0, 0) })
refuses("type", fn() { buf.line_span(42, 1) })
refuses("type", fn() { buf.insert(42, 0, "x") })
refuses("type", fn() { buf.delete(42, nil) })
refuses("type", fn() { buf.find(42, nil) })
refuses("type", fn() { buf.find_all(42, nil) })
refuses("type", fn() { buf.dirty(42) })
refuses("type", fn() { buf.readonly(42) })
refuses("type", fn() { buf.mark(42, 0) })

refuses("handle", fn() { win.current() })
refuses("handle", fn() { win.list() })
refuses("type", fn() { win.buf(42) })
refuses("type", fn() { win.cursors(42) })
refuses("type", fn() { win.selection(42) })
refuses("type", fn() { win.split(42, "right") })
refuses("type", fn() { win.close(42) })
refuses("type", fn() { win.focus(42) })
refuses("type", fn() { win.viewport(42) })
refuses("type", fn() { win.set_cursors(42, []) })

refuses("type", fn() { cur.pos(42) })
refuses("type", fn() { cur.line(42) })
refuses("type", fn() { cur.col(42) })
refuses("type", fn() { cur.anchor(42) })
refuses("type", fn() { cur.span(42) })
refuses("type", fn() { cur.goto(42, 0) })
refuses("type", fn() { cur.move(42, "word", "next") })
refuses("type", fn() { cur.word(42) })
refuses("type", fn() { cur.line_span(42) })
refuses("type", fn() { cur.insert(42, "x") })
refuses("type", fn() { cur.is_primary(42) })
refuses("type", fn() { cur.valid(42) })

refuses("type", fn() { span.lo(42) })
refuses("type", fn() { span.hi(42) })
refuses("type", fn() { span.len(42) })
refuses("type", fn() { span.text(42) })
refuses("type", fn() { span.lines(42) })
refuses("type", fn() { span.replace(42, "x") })
refuses("type", fn() { span.replace_lines(42, ["x"]) })
refuses("type", fn() { span.prepend(42, "x") })
refuses("type", fn() { span.append(42, "x") })
refuses("type", fn() { span.delete(42) })
refuses("type", fn() { span.yank(42) })
refuses("type", fn() { span.valid(42) })

refuses("handle", fn() { opt.get("tabwidth") })
refuses("handle", fn() { opt.set("tabwidth", 4) })

refuses("handle", fn() { ed.run("ed.mode.normal", {}) })
if list.len(ed.commands()) == 0 { error("editor command registry is empty") }

# -- config primitives are live and refuse cleanly without an editor --
refuses("handle", fn() { bind("H", "s", fn() { return 1 }) })
refuses("handle", fn() { unbind("H", "s") })
refuses("handle", fn() { set({tabwidth: 4}) })
refuses("handle", fn() { record("q") })
refuses("handle", fn() { replay("q") })
refuses("handle", fn() { replay("q", 2) })

# -- the headless condition is an honest ERROR_KIND case --------------
# Uncaught on purpose: the directives above prove that the observable
# process error is `handle`, in addition to the caught case proving that
# scripts can recover from it.
buf.current()
