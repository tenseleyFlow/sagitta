# SPEC: §6
# COVERS: program stmt let_stmt assign_stmt target if_stmt while_stmt
# COVERS: for_stmt return_stmt expr_stmt block TERM list_lit map_lit entry
# COVERS: op:JUMP op:JUMP_BACK op:JUMP_IF_FALSE op:JUMP_IF_TRUE
# COVERS: op:ITER_NEW op:ITER_NEXT1 op:ITER_NEXT2 op:GET_LOCAL
# COVERS: op:SET_LOCAL op:DEF_GLOBAL op:GET_GLOBAL op:SET_GLOBAL
# COVERS: op:LIST op:MAP op:LIST_APPEND op:INDEX_GET op:INDEX_SET
# COVERS: op:FIELD_GET op:FIELD_SET op:POPN op:NIL_N op:DUP
# COVERS: op:TRACE_LINE op:HALT op:NOT_NIL
import io
import list

# -- let, with and without an initialiser ----------------------------
let a = 1
let b
# An uninitialised `let` is nil, not unset: there is no such thing as
# reading an undefined local, so it cannot be a runtime error.
# OUT: 1 nil
io.print(a, b)

# -- assignment to each of the three targets --------------------------
b = 2
let l = [0, 0]
let m = {k: 0}
l[1] = 7
m.k = 9
# OUT: 2 [0, 7] {k: 9}
io.print(b, l, m)
# The index target evaluates its subscript, so it is an expression.
l[a - 1] = 5
# OUT: [5, 7]
io.print(l)

# -- TERM: a newline, a semicolon, or end of file ---------------------
let x = 1; let y = 2
# OUT: 1 2
io.print(x, y)

# -- if / else if / else ----------------------------------------------
if a == 1 {
    # OUT: one
    io.print("one")
}
if a == 2 {
    io.print("wrong branch")
} else if a == 1 {
    # OUT: else-if taken
    io.print("else-if taken")
} else {
    io.print("wrong branch")
}
if a == 2 {
    io.print("wrong branch")
} else {
    # OUT: else taken
    io.print("else taken")
}

# -- while, with break and continue -----------------------------------
let i = 0
let sum = 0
while i < 5 {
    i = i + 1
    if i == 2 {
        continue
    }
    if i == 4 {
        break
    }
    sum = sum + i
}
# 1 and 3 are summed; 2 is skipped and 4 breaks before adding.
# OUT: 4 4
io.print(sum, i)

# -- for over a list: one binding is the VALUE ------------------------
let seen = []
for v in [10, 20, 30] {
    list.push(seen, v)
}
# OUT: [10, 20, 30]
io.print(seen)

# -- for with two bindings is INDEX, VALUE over a list ----------------
let pairs = []
for k, v in ["a", "b"] {
    list.push(pairs, [k, v])
}
# OUT: [[0, "a"], [1, "b"]]
io.print(pairs)

# -- for over a map is KEY, VALUE, in insertion order -----------------
let ks = []
for k, v in {z: 1, a: 2} {
    list.push(ks, k + "=" + fmtnum(v))
}
# OUT: ["z=1", "a=2"]
io.print(ks)

# -- for over a string walks GRAPHEMES, not bytes ---------------------
let gs = []
for g in "a👍🏽b" {
    list.push(gs, g)
}
# OUT: 3
io.print(list.len(gs))

# -- break and continue inside a for ----------------------------------
let got = []
for v in [1, 2, 3, 4] {
    if v == 2 {
        continue
    }
    if v == 4 {
        break
    }
    list.push(got, v)
}
# OUT: [1, 3]
io.print(got)

# -- a bare expression statement is evaluated and discarded ------------
1 + 1
io.print("expression statement did not disturb the stack")
# CHECK: expression statement did not disturb the stack

fn fmtnum(n) {
    return "" + fmt_int(n)
}

fn fmt_int(n) {
    import fmt
    return fmt.int(n)
}
