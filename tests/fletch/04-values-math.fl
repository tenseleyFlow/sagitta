# SPEC: §4, §11
# COVERS: math.abs math.min math.max math.clamp math.sign math.floor
# COVERS: math.ceil math.round math.trunc math.int math.float math.sqrt
# COVERS: math.exp math.log math.log2 math.log10 math.pow math.sin
# COVERS: math.cos math.tan math.asin math.acos math.atan math.atan2
# COVERS: math.hypot math.is_nan math.is_inf math.seed math.random
#
# Every math function with a checked result, plus the six constants.
#
# The values chosen are the ones with EXACT binary representations --
# sqrt(4), log2(8), cos(0) -- because a conformance suite that pins
# 0.30000000000000004 is pinning this machine's libm, not the language.
# The irrational constants are the deliberate exception: they are
# literals in the table, so their digits are the contract.
import io
import math

# -- int/float distinction is preserved, and it is visible ----------
# `abs` and friends return the SAME type they were given: an int
# arithmetic chain that silently became float would break `str.repeat`
# and every other int-only argument downstream.
# OUT: 2 2.5 -1 1 0
io.print(math.abs(-2), math.abs(-2.5), math.sign(-2), math.sign(7),
         math.sign(0))
# OUT: 3 3.0
io.print(math.int(3.9), math.float(3))

# -- selection ------------------------------------------------------
# min/max are variadic, which is why they are not just two-argument.
# OUT: 1 3 1 4
io.print(math.min(3, 1, 2), math.max(3, 1, 2), math.min(1, 2),
         math.max(4, 2))
# OUT: 3 0 2
io.print(math.clamp(5, 0, 3), math.clamp(-5, 0, 3), math.clamp(2, 0, 3))

# -- rounding, all four, including the negative direction -----------
# OUT: 1.0 2.0 2.0 -1.0
io.print(math.floor(1.7), math.ceil(1.2), math.round(1.5),
         math.trunc(-1.7))
# floor goes DOWN and trunc goes toward zero; they differ exactly here.
# OUT: -2.0 -1.0
io.print(math.floor(-1.7), math.trunc(-1.7))

# -- roots, powers, logs --------------------------------------------
# OUT: 2.0 8.0 1.0 0.0
io.print(math.sqrt(4.0), math.pow(2, 3), math.exp(0), math.log(1))
# OUT: 3.0 2.0
io.print(math.log2(8), math.log10(100))

# -- trigonometry ----------------------------------------------------
# OUT: 0.0 1.0 0.0
io.print(math.sin(0), math.cos(0), math.tan(0))
# OUT: 0.0 0.0 0.0
io.print(math.asin(0), math.acos(1), math.atan(0))
# OUT: 0.0 5.0
io.print(math.atan2(0, 1), math.hypot(3, 4))

# -- the non-finite predicates ---------------------------------------
# OUT: false false
io.print(math.is_nan(0.0), math.is_inf(0.0))
# nan is not equal to itself, so is_nan is the ONLY way to detect it.
# OUT: true true
io.print(math.is_nan(math.nan), math.is_inf(math.inf))
# OUT: false
io.print(math.nan == math.nan)

# -- the six constants ------------------------------------------------
# OUT: 3.141592653589793 2.718281828459045
io.print(math.pi, math.e)
# OUT: 9223372036854775807 -9223372036854775808
io.print(math.int_max, math.int_min)

# -- seeded randomness is REPRODUCIBLE, which is the whole contract ---
# The determinism lane runs the suite twice and byte-compares, so a
# generator that reseeded from the clock would fail here rather than
# intermittently somewhere else.
math.seed(1)
let a = math.random(1, 6)
math.seed(1)
let b = math.random(1, 6)
# OUT: true
io.print(a == b)
# In range, and an int when given int bounds.
# OUT: true
io.print(a >= 1 and a <= 6)
math.seed(7)
let f = math.random()
# OUT: true
io.print(f >= 0.0 and f < 1.0)
