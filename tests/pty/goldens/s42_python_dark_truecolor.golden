    4 @pkg.decorate                                                             
    5 class Widget(Base):                                                       
    6     async def method(self, cls: list[int]) -> str:                        
    7         raw = r"raw"                                                      
    8         byte = b'bytes'                                                   
    9         escaped = "\n\x41\N{SNOWMAN}\q"                                   
   10         triple = """first                                                 
   11 second \t                                                                 
   12 third"""                                                                  
   13         prefixed = rb'''raw bytes                                         
   14 body'''                                                                   
   15         fmt = f"{{literal}} { {'same': "quote", 'nested': {'x': 1}}!r:>{2}
   16         fmt3 = fr'''outer {"same"}                                        
   17 {value:{width}}'''                                                        
   18         nums = (0b1010_0011, 0o755, 0xCA_FE, 1.2e-3j, 42j)                
   19         if self is not None and cls:                                      
   20             return str(nums) := value                                     
   21         else:                                                             
   22             yield Ellipsis                                                
