--- text
    1 module Demo.Core where                                                    
    1 import qualified Data.Map as Map                                          
    2                                                                           
    3 data Choice = Yes | No deriving (Show)                                    
    4 answer x = if x >= 1.5e2 then True else False                             
    5 compose = fmap (+ 1) . Map.lookup "key\n"; pair = (Yes, No)               
    6 letter = '\t'                                                             
    7 symbols a b = a >>= b <> a $ b                                            
    8                                                                           
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
