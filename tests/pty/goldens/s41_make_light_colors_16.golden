# yew pty golden v1
size 80x24 alt=1 cursor=1,7 vis=1
modes 2004,1002,1006,1004 kitty=21 sync_pairs=n/a
--- text
 1 mk_kitchen.mk  +                                                             
     1 ifeq ($(MODE_0),debug)                                                   
     1 CFLAGS_1 += -g                                                           
     2 endif                                                                    
     3 define emit_3                                                            
     4     @printf "%s\n" "$@ $< $^"                                            
     5 endef                                                                    
     6 target_6: dep_6                                                          
     7     $(CC) $(CFLAGS) -o target_7 dep_7                                    
     8 ifeq ($(MODE_8),debug)                                                   
     9 CFLAGS_9 += -g                                                           
    10 endif                                                                    
    11 define emit_11                                                           
    12     @printf "%s\n" "$@ $< $^"                                            
    13 endef                                                                    
    14 target_14: dep_14                                                        
    15     $(CC) $(CFLAGS) -o target_15 dep_15                                  
    16 ifeq ($(MODE_16),debug)                                                  
    17 CFLAGS_17 += -g                                                          
    18 endif                                                                    
    19 define emit_19                                                           
    20     @printf "%s\n" "$@ $< $^"                                            
    21 endef                                                                    
 L  mk_kitchen.mk                                            utf-8  lf  1:1  top
