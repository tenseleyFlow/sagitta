# yew pty golden v1
size 80x24 alt=1 cursor=0,6 vis=1
modes 2004,1002,1006,1004 kitty=21 sync_pairs=n/a
--- text
    1 //go:build linux                                                          
    1 // +build amd64                                                           
    2 // ordinary comment                                                       
    3 package main                                                              
    4                                                                           
    5 /* block comment */                                                       
    6 const answer = 42                                                         
    7 const tag = `json:"name"\nraw`                                            
    8 var text = "line\n\u00e9\q"                                               
    9 var runeValue = '\U0001F642'                                              
   10 var badRune = '\q'                                                        
   11 var flags = true || false                                                 
   12 var absent = nil                                                          
   13 var nums = []any{0xff_ff, 0b1010, 0o755, 1_000.5e-2i, .5i}                
   14                                                                           
   15 func main() {                                                             
   16 start:                                                                    
   17     println(append(nums, iota), text, tag, runeValue)                     
   18     if answer >= len(nums) { goto start }                                 
   19 }                                                                         
   20                                                                           
                                                                                
                                                                                
