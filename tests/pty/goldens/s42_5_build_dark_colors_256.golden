# yew pty golden v1
size 80x24 alt=1 cursor=0,6 vis=1
modes 2004,1002,1006,1004 kitty=21 sync_pairs=n/a
--- text
    1 # Terraform-shaped kitchen sink.                                          
    1 terraform { required_version = ">= 1.6" }                                 
    2 resource "demo_widget" "main" {                                           
    3   enabled = true                                                          
    4   empty = null                                                            
    5   count = 0x2a + 3.5e-2                                                   
    6   choice = flag ? "yes" : "no"                                            
    7   rule = for item in values : item if item != 0                           
    8   tags = { owner = "ops" }                                                
    9 }                                                                         
   10 /* TODO: keep the provider pin                                            
   11    FIXME before release */                                                
   12                                                                           
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
 L  01-kitchen.tf                                            utf-8  lf  1:1  all
