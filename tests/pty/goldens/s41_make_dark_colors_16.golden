--- text
     1 ifeq ($(MODE_0),debug)                                                   
     2 CFLAGS_1 += -g                                                           
     3 endif                                                                    
     4 define emit_3                                                            
     5     @printf "%s\n" "$@ $< $^"                                            
     6 endef                                                                    
