{    syntax: 1,    language: {        name:       "jsonc",        extensions: ["jsonc"],        filenames:  ["tsconfig.json", "jsconfig.json", ".eslintrc.json",                     "devcontainer.json", "*.jsonc"],        priority:   30,        comment:    { line: "//", block: ["/*", "*/"] },    },    contexts: {        main: {            default: "text",            rules: [ "include:jsonc_rules" ],        },        jsonc_rules: {            rules: [                { match: "(\"(\\\\[\"\\\\/bfnrt]|\\\\u[0-9A-Fa-f]{4}|[^\"\\\\\\x00-\\x1F])*\")\\s*:",                  captures: { 1: "variable.member" }, consume: 1 },                { match: "//.*$", attr: "comment" },                { match: "/\\*", attr: "comment", push: "block_comment" },                { match: "\"", attr: "string", push: "string" },                { match: "\\+[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?", attr: "error" },                { match: "-?0[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?", attr: "error" },                { match: "-?0[xX][0-9A-Fa-f]+", attr: "error" },                { match: "-?\\.[0-9]+([eE][+-]?[0-9]+)?", attr: "error" },                { match: "(-?[0-9]+\\.)(\\s|[,}\\]]|$)", attr: "error",                  consume: 1 },                { match: "(-?[0-9]+(\\.[0-9]+)?[eE][+-]?)(\\s|[,}\\]]|$)",                  attr: "error", consume: 1 },                { match: "-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?",                  attr: "number" },                { match: "\\b(true|false)\\b", attr: "boolean" },                { match: "\\bnull\\b", attr: "constant.builtin" },                { match: "\\b[A-Za-z_][A-Za-z0-9_]*\\b", attr: "error" },                { match: "[{}\\[\\]]", attr: "punct.bracket" },                { match: "[:,]", attr: "punct.delim" },            ],        },        string: {            default: "string", at_eol: "pop", unit: "atom",            rules: [                { match: "\\\\u[0-9A-Fa-f]{4}", attr: "string.escape" },                { match: "\\\\[\"\\\\/bfnrt]", attr: "string.escape" },                { match: "\\\\.", attr: "error" },                { match: "[\\x00-\\x1F]", attr: "error" },                { match: "\"", attr: "string", pop: 1 },            ],        },        block_comment: {            default: "comment", at_eol: "stay", unit: "atom",            rules: [ { match: "\\*/", attr: "comment", pop: 1 } ],        },    },}
