{    syntax: 1,    language: {        name: "cmake",        extensions: ["cmake"],        filenames: ["CMakeLists.txt"],        priority: 0,        comment: { line: "#" },    },    contexts: {        main: {            default: "text",            rules: [                { match: "#\\[\\[", attr: "comment", push: "bracket_comment_zero" },                { match: "#\\[(=+)\\[", attr: "comment", captures: { 1: "comment" },                  set_aux: 1, push: "bracket_comment" },                { match: "#.*$", attr: "comment" },                { match: "\\[\\[", attr: "string", push: "bracket_string_zero" },                { match: "\\[(=+)\\[", attr: "string", captures: { 1: "string" },                  set_aux: 1, push: "bracket_string" },                { match: "\\b(if|elseif|else|endif|foreach|endforeach|while|endwhile|function|endfunction|macro|endmacro|return|break|continue)\\b",                  attr: "keyword.control", icase: true },                { match: "([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",                  captures: { 1: "function" }, consume: 1 },                { match: "\\b(ON|OFF|TRUE|FALSE|YES|NO|NOTFOUND)\\b", attr: "boolean", icase: true },                { match: "\"", attr: "string", push: "dq" },                "include:variables",                { match: "[()]", attr: "punct.bracket" },                { match: "[0-9]+(\\.[0-9]+)*", attr: "number" },            ],        },        variables: {            rules: [                { match: "\\$(ENV|CACHE)?\\{[A-Za-z_][A-Za-z0-9_.-]*}", attr: "variable" },                { match: "\\$<[^>\\n]+>", attr: "string.interp" },            ],        },        dq: {            default: "string", at_eol: "pop", unit: "atom",            rules: [                { match: "\\\\.", attr: "string.escape" },                "include:variables",                { match: "\"", attr: "string", pop: 1 },            ],        },        bracket_string_zero: {            default: "string.special", at_eol: "stay", unit: "atom",            rules: [ { match: "\\]\\]", attr: "string", pop: 1 } ],        },        bracket_string: {            default: "string.special", at_eol: "stay", unit: "atom",            rules: [ { aux: "literal", aux_pre: "]", aux_post: "]", attr: "string", pop: 1 } ],        },        bracket_comment_zero: {            default: "comment", at_eol: "stay", unit: "atom",            rules: [ { match: "\\]\\]", attr: "comment", pop: 1 } ],        },        bracket_comment: {            default: "comment", at_eol: "stay", unit: "atom",            rules: [ { aux: "literal", aux_pre: "]", aux_post: "]", attr: "comment", pop: 1 } ],        },    },}
