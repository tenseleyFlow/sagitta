{    syntax: 1,    language: {        name: "xml", extensions: ["xml", "xsd", "xsl", "xslt", "svg"], priority: 0,        comment: { block: ["<!--", "-->"] },    },    contexts: {        main: {            default: "text", at_eol: "stay",            rules: [                { match: "<!--", attr: "comment", push: "comment" },                { match: "<!\\[CDATA\\[", attr: "string.special", push: "cdata" },                { match: "<\\?", attr: "preproc", push: "pi" },                { match: "<![A-Za-z]", attr: "preproc", push: "declaration" },                { match: "(</?)([A-Za-z_:][A-Za-z0-9_.:-]*)", attr: "tag", captures: { 1: "punct.bracket", 2: "tag" }, push: "tag" },                { match: "&(#x[0-9A-Fa-f]+|#[0-9]+|[A-Za-z_:][A-Za-z0-9_.:-]*);", attr: "constant" },            ],        },        comment: {            default: "comment", at_eol: "stay", unit: "atom",            rules: [                { match: "\\b(TODO|FIXME|XXX)\\b", attr: "comment.todo" },                { match: "-->", attr: "comment", pop: 1 },            ],        },        cdata: {            default: "string.special", at_eol: "stay", unit: "atom",            rules: [ { match: "\\]\\]>", attr: "string.special", pop: 1 } ],        },        pi: {            default: "preproc", at_eol: "stay", unit: "atom",            rules: [ { match: "\\?>", attr: "preproc", pop: 1 } ],        },        declaration: {            default: "preproc", at_eol: "stay", unit: "span",            rules: [ { match: ">", attr: "punct.bracket", pop: 1 } ],        },        tag: {            default: "tag", at_eol: "stay", unit: "span",            rules: [                { match: "/?>", attr: "punct.bracket", pop: 1 },                { match: "[A-Za-z_:][A-Za-z0-9_.:-]*", attr: "tag.attr" },                { match: "=", attr: "operator" },                { match: "\"", attr: "string", push: "attr_dq" },                { match: "'", attr: "string", push: "attr_sq" },            ],        },        attr_dq: {            default: "string", at_eol: "stay", unit: "atom",            rules: [                { match: "&(#x[0-9A-Fa-f]+|#[0-9]+|[A-Za-z_:][A-Za-z0-9_.:-]*);", attr: "constant" },                { match: "\"", attr: "string", pop: 1 },            ],        },        attr_sq: {            default: "string", at_eol: "stay", unit: "atom",            rules: [                { match: "&(#x[0-9A-Fa-f]+|#[0-9]+|[A-Za-z_:][A-Za-z0-9_.:-]*);", attr: "constant" },                { match: "'", attr: "string", pop: 1 },            ],        },    },}
