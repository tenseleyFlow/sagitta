{    syntax: 1,    language: {        name: "ruby",        extensions: ["rb", "rake", "gemspec"],        filenames: ["Rakefile", "Gemfile", "Guardfile", "Vagrantfile", "Berksfile", "Capfile", "Podfile"],        shebangs: ["ruby", "jruby"],        priority: 20,        comment: { line: "#", block: ["=begin", "=end"] },    },    contexts: {        main: { default: "text", rules: ["include:ruby"] },        ruby: {            rules: [                { match: "^=begin\\b", attr: "comment", push: "block_comment" },                { match: "#.*$", attr: "comment" },                { match: "<<[-~]\\s*'([A-Za-z_][A-Za-z0-9_]*)'", attr: "operator",                  captures: { 1: "string" }, set_aux: 1, push: "heredoc_ws_pending_raw" },                { match: "<<[-~]\\s*\"([A-Za-z_][A-Za-z0-9_]*)\"", attr: "operator",                  captures: { 1: "string" }, set_aux: 1, push: "heredoc_ws_pending" },                { match: "<<[-~]\\s*([A-Za-z_][A-Za-z0-9_]*)", attr: "operator",                  captures: { 1: "string" }, set_aux: 1, push: "heredoc_ws_pending" },                { match: "<<\\s*'([A-Za-z_][A-Za-z0-9_]*)'", attr: "operator",                  captures: { 1: "string" }, set_aux: 1, push: "heredoc_pending_raw" },                { match: "<<\\s*\"([A-Za-z_][A-Za-z0-9_]*)\"", attr: "operator",                  captures: { 1: "string" }, set_aux: 1, push: "heredoc_pending" },                { match: "<<\\s*([A-Za-z_][A-Za-z0-9_]*)", attr: "operator",                  captures: { 1: "string" }, set_aux: 1, push: "heredoc_pending" },                { match: "%Q\\{", attr: "string", push: "percent_q_interp" },                { match: "%q\\{", attr: "string.special", push: "percent_q_raw" },                { match: ":\"", attr: "constant", push: "symbol_dq" },                { match: "\"", attr: "string", push: "dq" },                { match: "'", attr: "string.special", push: "sq" },                { match: ":[A-Za-z_][A-Za-z0-9_!?=]*", attr: "constant" },                { match: "(^|[=(,:;!&|?{}\\[])\\s*/([^/\\\\\\n]|\\\\.)+/[imoxesuyn]*",                  attr: "string.special" },                { match: "@[A-Za-z_][A-Za-z0-9_]*|@@[A-Za-z_][A-Za-z0-9_]*|\\$[A-Za-z_][A-Za-z0-9_]*",                  attr: "variable.builtin" },                { match: "\\b(class|module|def|alias|undef)\\b", attr: "keyword.storage" },                { match: "\\b(if|unless|else|elsif|case|when|while|until|for|begin|rescue|ensure|retry|redo|next|break|return|yield|then|do|end)\\b",                  attr: "keyword.control" },                { match: "\\b(require|require_relative|include|extend|prepend)\\b", attr: "keyword" },                { match: "\\b(true|false)\\b", attr: "boolean" },                { match: "\\b(nil|self|__FILE__|__LINE__|__ENCODING__)\\b", attr: "constant.builtin" },                { match: "\\b0[xX][0-9A-Fa-f_]+\\b|\\b0[bB][01_]+\\b|\\b0[oO][0-7_]+\\b|\\b[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?[ri]?\\b", attr: "number" },                { match: "(<=>|===|==|!=|<=|>=|=>|=~|!~|\\*\\*|&&|\\|\\||<<|>>|&\\.|::|[+*/%&|^~<>=!-])", attr: "operator" },                { match: "[(){}\\[\\]]", attr: "punct.bracket" },                { match: "[,;.]", attr: "punct.delim" },                { match: "[A-Z][A-Za-z0-9_]*", attr: "type" },                { match: "[A-Za-z_][A-Za-z0-9_!?=]*", attr: "variable" },            ],        },        block_comment: { default: "comment", at_eol: "stay", unit: "atom",            rules: [ { match: "^=end\\b.*$", attr: "comment", pop: 1 } ] },        dq: { default: "string", at_eol: "pop", unit: "atom", rules: ["include:interp", { match: "\\\\.", attr: "string.escape" }, { match: "\"", attr: "string", pop: 1 }] },        sq: { default: "string.special", at_eol: "pop", unit: "atom", rules: [{ match: "\\\\['\\\\]", attr: "string.escape" }, { match: "'", attr: "string.special", pop: 1 }] },        symbol_dq: { default: "constant", at_eol: "pop", unit: "atom", rules: ["include:interp", { match: "\\\\.", attr: "string.escape" }, { match: "\"", attr: "constant", pop: 1 }] },        percent_q_interp: { default: "string", at_eol: "stay", unit: "atom", rules: [{ match: "\\{", attr: "punct.bracket", push: "percent_q_interp" }, "include:interp", { match: "\\\\.", attr: "string.escape" }, { match: "}", attr: "string", pop: 1 }] },        percent_q_raw: { default: "string.special", at_eol: "stay", unit: "atom", rules: [{ match: "\\{", attr: "punct.bracket", push: "percent_q_raw" }, { match: "\\\\[{}\\\\]", attr: "string.escape" }, { match: "}", attr: "string.special", pop: 1 }] },        interp: { rules: [{ match: "#\\{", attr: "string.interp", push: "interp_expr" }, { match: "#(@@?[A-Za-z_][A-Za-z0-9_]*|\\$[A-Za-z_][A-Za-z0-9_]*)", attr: "variable" }] },        interp_expr: { default: "code", at_eol: "stay", unit: "span", rules: [{ match: "}", attr: "string.interp", pop: 1 }, { match: "\\{", attr: "punct.bracket", push: "interp_brace" }] },        interp_brace: { default: "code", at_eol: "stay", unit: "span", rules: [{ match: "}", attr: "punct.bracket", pop: 1 }, { match: "\\{", attr: "punct.bracket", push: "interp_brace" }] },        heredoc_pending: { default: "text", at_eol: "set:heredoc", rules: [] },        heredoc_pending_raw: { default: "text", at_eol: "set:heredoc_raw", rules: [] },        heredoc_ws_pending: { default: "text", at_eol: "set:heredoc_ws", rules: [] },        heredoc_ws_pending_raw: { default: "text", at_eol: "set:heredoc_ws_raw", rules: [] },        heredoc: { default: "string.special", at_eol: "stay", unit: "atom", rules: [{ aux: "line_eq", attr: "string", pop: 1 }, "include:interp", { match: "\\\\.", attr: "string.escape" }] },        heredoc_raw: { default: "string.special", at_eol: "stay", unit: "atom", rules: [{ aux: "line_eq", attr: "string", pop: 1 }] },        heredoc_ws: { default: "string.special", at_eol: "stay", unit: "atom", rules: [{ aux: "line_eq_ws", attr: "string", pop: 1 }, "include:interp", { match: "\\\\.", attr: "string.escape" }] },        heredoc_ws_raw: { default: "string.special", at_eol: "stay", unit: "atom", rules: [{ aux: "line_eq_ws", attr: "string", pop: 1 }] },    },}
