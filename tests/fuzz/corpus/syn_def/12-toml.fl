{    syntax: 1,    language: {        name:       "toml",        extensions: ["toml"],        filenames:  ["Cargo.lock", "Pipfile", "poetry.lock"],        priority:   10,        comment:    { line: "#" },    },    contexts: {        main: {            default: "text",            rules: [                { match: "^\\s*\\[\\[", attr: "punct.bracket",                  push: "array_table" },                { match: "^\\s*\\[", attr: "punct.bracket",                  push: "table" },                { match: "^\\s*((([A-Za-z0-9_-]+|\"(\\\\.|[^\"\\\\])*\"|'[^']*'))(\\s*\\.\\s*([A-Za-z0-9_-]+|\"(\\\\.|[^\"\\\\])*\"|'[^']*'))*)\\s*=",                  captures: { 1: "variable.member" }, consume: 1 },                { match: "=", attr: "operator" },                { match: "#.*$", attr: "comment" },                { match: "(\"\"\")", attr: "string", set_aux: 1,                  push: "ml_basic" },                { match: "(''')", attr: "string", set_aux: 1,                  push: "ml_literal" },                { match: "\"", attr: "string", push: "basic" },                { match: "'", attr: "string", push: "literal" },                { match: "\\b[0-9]{4}-[0-9]{2}-[0-9]{2}([Tt ]+[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})?)?\\b",                  attr: "constant" },                { match: "\\b[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\b",                  attr: "constant" },                { match: "\\b(true|false)\\b", attr: "boolean" },                { match: "[-+]?(inf|nan)\\b", attr: "number" },                { match: "[-+]?0[xX][0-9A-Fa-f]([0-9A-Fa-f_]*[0-9A-Fa-f])?\\b",                  attr: "number" },                { match: "[-+]?0[oO][0-7]([0-7_]*[0-7])?\\b", attr: "number" },                { match: "[-+]?0[bB][01]([01_]*[01])?\\b", attr: "number" },                { match: "[-+]?(0|[1-9][0-9_]*)(\\.[0-9]([0-9_]*[0-9])?)?([eE][-+]?[0-9]([0-9_]*[0-9])?)?\\b",                  attr: "number" },                { match: "[\\[\\]{}]", attr: "punct.bracket" },                { match: "[,.]", attr: "punct.delim" },            ],        },        basic_escapes: {            rules: [                { match: "\\\\(b|t|n|f|r|\"|\\\\|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",                  attr: "string.escape" },                { match: "\\\\.", attr: "error" },            ],        },        table_parts: {            rules: [                { match: "\"(\\\\.|[^\"\\\\])*\"|'[^']*'|[A-Za-z0-9_-]+",                  attr: "namespace" },                { match: "\\.", attr: "punct.delim" },            ],        },        table: {            default: "text", at_eol: "pop", unit: "span",            rules: [                { match: "\\]", attr: "punct.bracket", pop: 1 },                "include:table_parts",            ],        },        array_table: {            default: "text", at_eol: "pop", unit: "span",            rules: [                { match: "\\]\\]", attr: "punct.bracket", pop: 1 },                "include:table_parts",            ],        },        basic: {            default: "string", at_eol: "pop", unit: "atom",            rules: [                "include:basic_escapes",                { match: "[\\x00-\\x08\\x0A-\\x1F\\x7F]", attr: "error" },                { match: "\"", attr: "string", pop: 1 },            ],        },        literal: {            default: "string", at_eol: "pop", unit: "atom",            rules: [ { match: "'", attr: "string", pop: 1 } ],        },        ml_basic: {            default: "string", at_eol: "stay", unit: "atom",            rules: [                { aux: "literal", attr: "string", pop: 1 },                { match: "\\\\[ \\t]*$", attr: "string.escape" },                "include:basic_escapes",                { match: "[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F]", attr: "error" },            ],        },        ml_literal: {            default: "string", at_eol: "stay", unit: "atom",            rules: [ { aux: "literal", attr: "string", pop: 1 } ],        },    },}
