{    syntax: 1,    language: {        name: "sh",        extensions: ["sh", "bash"],        filenames: [".bashrc", ".bash_profile", ".profile", "PKGBUILD"],        shebangs: ["sh", "bash", "dash", "ksh"],        priority: 0,        comment: { line: "#" },    },    contexts: {        main: {            default: "text",            rules: [                { match: "^#!.*$", attr: "preproc", first_line: true },                { match: "<<-\\s*'([A-Za-z_][A-Za-z0-9_]*)'",                  attr: "operator", captures: { 1: "string" }, set_aux: 1,                  strip: true, push: "heredoc_pending_raw" },                { match: "<<-\\s*\"([A-Za-z_][A-Za-z0-9_]*)\"",                  attr: "operator", captures: { 1: "string" }, set_aux: 1,                  strip: true, push: "heredoc_pending_raw" },                { match: "<<\\s*'([A-Za-z_][A-Za-z0-9_]*)'",                  attr: "operator", captures: { 1: "string" }, set_aux: 1,                  push: "heredoc_pending_raw" },                { match: "<<\\s*\"([A-Za-z_][A-Za-z0-9_]*)\"",                  attr: "operator", captures: { 1: "string" }, set_aux: 1,                  push: "heredoc_pending_raw" },                { match: "<<-\\s*([A-Za-z_][A-Za-z0-9_]*)",                  attr: "operator", captures: { 1: "string" }, set_aux: 1,                  strip: true, push: "heredoc_pending" },                { match: "<<\\s*([A-Za-z_][A-Za-z0-9_]*)",                  attr: "operator", captures: { 1: "string" }, set_aux: 1,                  push: "heredoc_pending" },                { match: "^\\s*([A-Za-z_][A-Za-z0-9_]*)(\\+?=)",                  captures: { 1: "variable", 2: "operator" }, consume: 2 },                "include:shell_tail",                { match: "[A-Za-z_][A-Za-z_]*", attr: "text" },            ],        },        shell_tail: {            rules: [                { match: "#.*$", attr: "comment" },                { match: "\\$'", attr: "string", push: "ansi_sq" },                { match: "'", attr: "string", push: "sq" },                { match: "\"", attr: "string", push: "dq" },                { match: "\\\\.", attr: "string.escape" },                { match: "`", attr: "string.interp", push: "backtick",                  embed: { lang: "@self", end: "inline",                           fallback: "string.special" } },                { match: "\\$\\(\\(", attr: "string.interp", push: "arith" },                { match: "\\$\\(", attr: "string.interp", push: "cmd_sub",                  embed: { lang: "@self", end: "inline",                           fallback: "text" } },                { match: "\\$\\{", attr: "string.interp", push: "parameter" },                { match: "\\$[A-Za-z_][A-Za-z0-9_]*|\\$[0-9@*#?$!_-]",                  attr: "variable" },                { match: "([A-Za-z_][A-Za-z0-9_]*)\\s*\\(\\s*\\)",                  captures: { 1: "function" }, consume: 1 },                { match: "\\b(if|then|elif|else|fi|case|esac|for|while|until|do|done|in|function|select|time)\\b",                  attr: "keyword.control" },                { match: "\\b(local|declare|typeset|export|readonly)\\b",                  attr: "keyword.storage" },                { match: "\\b(cd|printf|read|test|echo|set|shift|trap|unset|source|alias|command|builtin|exec|eval|wait|pwd|true|false|break|continue|return|exit)\\b",                  attr: "function.builtin" },                { match: "\\b(awk|cat|chmod|cp|cut|date|env|find|grep|head|ln|mkdir|mv|rm|sed|sort|tail|tee|touch|tr|wc|xargs)\\b",                  attr: "function.builtin" },                { match: "\\[\\[|\\]\\]|\\[|\\]", attr: "punct.bracket" },                { match: "--[A-Za-z0-9][A-Za-z0-9_-]*|-[A-Za-z0-9]+",                  attr: "constant" },                { match: "[0-9]+", attr: "number" },                { match: "&&|\\|\\||;;|;&|;;&|[|&;<>]", attr: "operator" },                { match: "[(){}]", attr: "punct.bracket" },            ],        },        heredoc_pending: { include: "shell_tail", at_eol: "set:heredoc" },        heredoc_pending_raw: {            include: "shell_tail", at_eol: "set:heredoc_raw"        },        heredoc: {            default: "string.special", at_eol: "stay", unit: "atom",            rules: [                { aux: "line_eq", attr: "string", pop: 1 },                { match: "\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?|\\$[0-9@*#?$!_-]",                  attr: "variable" },                { match: "\\\\[$`\"\\\\]", attr: "string.escape" },            ],        },        heredoc_raw: {            default: "string.special", at_eol: "stay", unit: "atom",            rules: [ { aux: "line_eq", attr: "string", pop: 1 } ],        },        sq: {            default: "string", at_eol: "stay", unit: "atom",            rules: [ { match: "'", attr: "string", pop: 1 } ],        },        dq: {            default: "string", at_eol: "stay", unit: "atom",            rules: [                { match: "\\\\$", attr: "string.escape" },                { match: "\\\\[$`\"\\\\]", attr: "string.escape" },                { match: "\\$\\(\\(", attr: "string.interp", push: "arith" },                { match: "\\$\\(", attr: "string.interp", push: "cmd_sub",                  embed: { lang: "@self", end: "inline",                           fallback: "text" } },                { match: "\\$\\{", attr: "string.interp", push: "parameter" },                { match: "\\$[A-Za-z_][A-Za-z0-9_]*|\\$[0-9@*#?$!_-]",                  attr: "variable" },                { match: "`", attr: "string.interp", push: "backtick",                  embed: { lang: "@self", end: "inline",                           fallback: "string.special" } },                { match: "\"", attr: "string", pop: 1 },            ],        },        ansi_sq: {            default: "string", at_eol: "pop", unit: "atom",            rules: [                { match: "\\\\(a|b|e|E|f|n|r|t|v|\\\\|'|\"|\\?|[0-7]{1,3}|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{1,4}|U[0-9A-Fa-f]{1,8})",                  attr: "string.escape" },                { match: "\\\\.", attr: "error" },                { match: "'", attr: "string", pop: 1 },            ],        },        parameter: {            default: "variable", at_eol: "stay", unit: "span",            rules: [                { match: "\\[[@*]\\]", attr: "variable.builtin" },                { match: "[:#%/,+?=^-]+", attr: "operator" },                { match: "}", attr: "string.interp", pop: 1 },            ],        },        cmd_sub: {            default: "text", at_eol: "stay", unit: "span",            rules: [                { match: "\\)", attr: "string.interp", pop: 1, end: true },            ],        },        arith: {            default: "text", at_eol: "stay", unit: "span",            rules: [                { match: "\\(\\(", attr: "punct.bracket",                  set: "arith_nested" },                { match: "\\)\\)", attr: "string.interp", pop: 1 },                "include:arith_rules",            ],        },        arith_nested: {            default: "text", at_eol: "stay", unit: "span",            rules: [                { match: "\\)\\)", attr: "punct.bracket", set: "arith" },                "include:arith_rules",            ],        },        arith_rules: {            rules: [                { match: "[A-Za-z_][A-Za-z0-9_]*", attr: "variable" },                { match: "0[xX][0-9A-Fa-f]+|[0-9]+", attr: "number" },                { match: "[+*/%<>=!&|?:~-]+", attr: "operator" },            ],        },        backtick: {            default: "string.special", at_eol: "stay", unit: "span",            rules: [                { match: "`", attr: "string.interp", pop: 1, end: true },            ],        },    },}
