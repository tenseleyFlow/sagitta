{    syntax: 1,    language: {        name: "make",        extensions: ["mk", "mak"],        filenames: ["Makefile", "makefile", "GNUmakefile", "*.mk"],        priority: 10,        comment: { line: "#" },    },    contexts: {        main: {            default: "text",            rules: [                { match: "^\\s*define\\b", attr: "preproc",                  push: "define_pending" },                { match: "^\\s*(ifeq|ifneq|ifdef|ifndef|else|endif)\\b",                  attr: "keyword.control" },                { match: "^\\s*(-?include|sinclude|vpath|export|unexport|override|endef)\\b",                  attr: "preproc" },                { match: "^(\\t)([@+-]*)", attr: "text",                  captures: { 1: "whitespace.special", 2: "operator" },                  consume: 2, push: "recipe",                  embed: { lang: "sh", end: "line-continuation",                           fallback: "text" } },                { match: "^\\s*([A-Za-z_][A-Za-z0-9_.-]*)\\s*([:?+!]?=)",                  captures: { 1: "variable", 2: "operator" }, consume: 2 },                { match: "\\.(PHONY|SUFFIXES|DEFAULT|PRECIOUS|SECONDARY|NOTPARALLEL|ONESHELL|DELETE_ON_ERROR)\\b",                  attr: "attribute" },                { match: "^([^\\t:=#][^:=#]*)(::?)",                  captures: { 1: "label", 2: "operator" }, consume: 2,                  push: "target_tail" },                "include:make_expr",                { match: "#.*$", attr: "comment" },                { match: "[|:;]", attr: "operator" },            ],        },        target_tail: {            default: "text", at_eol: "set:after_target",            rules: [                "include:make_expr",                { match: "#.*$", attr: "comment" },                { match: "[|;]", attr: "operator" },            ],        },        after_target: {            default: "text", at_eol: "pop",            rules: [                { match: "^(\\t)([@+-]*)", attr: "text",                  captures: { 1: "whitespace.special", 2: "operator" },                  consume: 2, push: "recipe",                  embed: { lang: "sh", end: "line-continuation",                           fallback: "text" } },                { match: "^ {2,}[^ \\t#].*$", attr: "warning" },                { match: "\\.(PHONY|SUFFIXES|DEFAULT|PRECIOUS|SECONDARY|NOTPARALLEL|ONESHELL|DELETE_ON_ERROR)\\b",                  attr: "attribute" },                { match: "^([^\\t:=#][^:=#]*)(::?)",                  captures: { 1: "label", 2: "operator" }, consume: 2,                  set: "target_tail" },                "include:main_rules",            ],        },        main_rules: {            rules: [                { match: "^\\s*define\\b", attr: "preproc",                  push: "define_pending" },                { match: "^\\s*(ifeq|ifneq|ifdef|ifndef|else|endif)\\b",                  attr: "keyword.control" },                { match: "^\\s*(-?include|sinclude|vpath|export|unexport|override|endef)\\b",                  attr: "preproc" },                { match: "^\\s*([A-Za-z_][A-Za-z0-9_.-]*)\\s*([:?+!]?=)",                  captures: { 1: "variable", 2: "operator" }, consume: 2 },                "include:make_expr",                { match: "#.*$", attr: "comment" },            ],        },        recipe: {            default: "text", at_eol: "pop", unit: "span",            rules: [                "include:make_expr",                { match: "\"", attr: "string", push: "dq" },                { match: "'", attr: "string", push: "sq" },                { match: "#.*$", attr: "comment" },                { match: "[|&;<>]", attr: "operator" },            ],        },        define_pending: {            default: "text", at_eol: "set:define_body",            rules: [ "include:make_expr", { match: "#.*$", attr: "comment" } ],        },        define_body: {            default: "string.special", at_eol: "stay", unit: "atom",            rules: [                { match: "^\\s*endef\\b", attr: "preproc", pop: 1 },                "include:make_expr",            ],        },        make_expr: {            rules: [                { match: "\\$[({]([A-Za-z_][A-Za-z0-9_-]*)\\s",                  captures: { 1: "function.builtin" } },                { match: "\\$[({][^)}]*[)}]", attr: "variable" },                { match: "\\$[@<^?*+%]", attr: "variable.builtin" },                { match: "\\$[A-Za-z_]", attr: "variable" },            ],        },        dq: {            default: "string", at_eol: "pop", unit: "atom",            rules: [                { match: "\\\\.", attr: "string.escape" },                "include:make_expr",                { match: "\"", attr: "string", pop: 1 },            ],        },        sq: {            default: "string", at_eol: "pop", unit: "atom",            rules: [ { match: "'", attr: "string", pop: 1 } ],        },    },}
