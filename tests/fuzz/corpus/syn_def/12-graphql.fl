{    syntax: 1,    language: {        name: "graphql", extensions: ["graphql", "gql"], priority: 0,        comment: { line: "#" },    },    contexts: {        main: {            default: "text",            rules: [                { match: "#.*$", attr: "comment" },                { match: "\"\"\"", attr: "string.special", push: "block_string" },                { match: "\"", attr: "string", push: "dq" },                { match: "\\$[A-Za-z_][A-Za-z0-9_]*", attr: "variable" },                { match: "@[A-Za-z_][A-Za-z0-9_]*", attr: "attribute" },                { match: "\\b(fragment)\\s+([A-Za-z_][A-Za-z0-9_]*)", attr: "keyword.storage", captures: { 2: "namespace" } },                { match: "\\b(query|mutation|subscription|schema|scalar|type|interface|union|enum|input|directive|extend|implements|on|repeatable)\\b", attr: "keyword.storage" },                { match: "\\b(true|false)\\b", attr: "boolean" },                { match: "\\bnull\\b", attr: "constant.builtin" },                { match: "[+-]?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?", attr: "number" },                { match: "[!$&=|]", attr: "operator" },                { match: "[(){}\\[\\]]", attr: "punct.bracket" },                { match: "[:,]", attr: "punct.delim" },                { match: "[A-Za-z_][A-Za-z0-9_]*", attr: "variable.member" },            ],        },        dq: {            default: "string", at_eol: "pop", unit: "atom",            rules: [                { match: "\\\\(\"|\\\\|/|b|f|n|r|t|u[0-9A-Fa-f]{4})", attr: "string.escape" },                { match: "\"", attr: "string", pop: 1 },            ],        },        block_string: {            default: "string.special", at_eol: "stay", unit: "atom",            rules: [                { match: "\\\\\"\"\"", attr: "string.escape" },                { match: "\"\"\"", attr: "string.special", pop: 1 },            ],        },    },}
