{    syntax: 1,    language: { name: "java", extensions: ["java"], priority: 20,                comment: { line: "//", block: ["/*", "*/"] } },    contexts: {        main: { default: "text", rules: [            { match: "///.*$", attr: "comment.doc" },            { match: "//.*$", attr: "comment" },            { match: "/\\*\\*", attr: "comment.doc", push: "doc" },            { match: "/\\*", attr: "comment", push: "comment" },            { match: "\"\"\"", attr: "string.special", push: "text_block" },            { match: "\"", attr: "string", push: "string" },            { match: "'", attr: "character", push: "character" },            { match: "@[A-Za-z_][A-Za-z0-9_.]*", attr: "attribute" },            { match: "\\b(class|interface|enum|record)\\s+([A-Za-z_][A-Za-z0-9_]*)", attr: "keyword.storage", captures: { 2: "type" } },            { match: "\\b(if|else|switch|case|default|for|while|do|break|continue|return|try|catch|finally|throw|throws|yield|assert)\\b", attr: "keyword.control" },            { match: "\\b(abstract|const|extends|final|implements|import|instanceof|native|new|package|private|protected|public|static|strictfp|super|synchronized|this|transient|volatile|sealed|permits|non-sealed|var)\\b", attr: "keyword.storage" },            { match: "\\b(boolean|byte|char|double|float|int|long|short|void)\\b", attr: "type.builtin" },            { match: "\\b(true|false)\\b", attr: "boolean" },            { match: "\\bnull\\b", attr: "constant.builtin" },            { match: "\\b(0[xX][0-9A-Fa-f_]+(\\.[0-9A-Fa-f_]+)?[pP][+-]?[0-9_]+|0[bB][01_]+|[0-9][0-9_]*(\\.[0-9_]*)?([eE][+-]?[0-9_]+)?)[lLfFdD]?\\b", attr: "number" },            { match: "\\b[A-Z][A-Za-z0-9_]*\\b", attr: "type" },            { match: "([a-zA-Z_][A-Za-z0-9_]*)\\s*\\(", captures: { 1: "function" }, consume: 1 },            { match: "\\*/", attr: "error" },            { match: "(>>>?=|<<=|>>>|>>|<<|->|::|==|!=|<=|>=|&&|\\|\\||\\+\\+|--|[+*/%&|^~!=<>?-])", attr: "operator" },            { match: "[(){}\\[\\]]", attr: "punct.bracket" },            { match: "[,;:.]", attr: "punct.delim" },        ] },        string: { default: "string", at_eol: "pop", unit: "atom", rules: [            { match: "\\\\(u[0-9A-Fa-f]{4}|[btnfr'\"\\\\]|[0-7]{1,3})", attr: "string.escape" },            { match: "\\\\.", attr: "error" }, { match: "\"", attr: "string", pop: 1 },        ] },        character: { default: "character", at_eol: "pop", unit: "atom", rules: [            { match: "\\\\(u[0-9A-Fa-f]{4}|[btnfr'\"\\\\]|[0-7]{1,3})", attr: "string.escape" },            { match: "\\\\.", attr: "error" }, { match: "'", attr: "character", pop: 1 },        ] },        text_block: { default: "string.special", at_eol: "stay", unit: "atom", rules: [            { match: "\\\\.", attr: "string.escape" }, { match: "\"\"\"", attr: "string.special", pop: 1 },        ] },        comment: { default: "comment", at_eol: "stay", unit: "atom", rules: [            { match: "\\b(TODO|FIXME)\\b", attr: "comment.todo" }, { match: "\\*/", attr: "comment", pop: 1 },        ] },        doc: { default: "comment.doc", at_eol: "stay", unit: "atom", rules: [            { match: "@[A-Za-z]+", attr: "attribute" }, { match: "\\*/", attr: "comment.doc", pop: 1 },        ] },    },}
