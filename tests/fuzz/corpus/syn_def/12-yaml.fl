{    syntax: 1,    language: {        name:       "yaml",        extensions: ["yaml", "yml"],        priority:   10,        comment:    { line: "#" },    },    contexts: {        main: {            default: "text",            rules: [ "include:yaml" ],        },        yaml: {            rules: [                { match: "^\\s*(---|\\.\\.\\.)\\s*(#.*)?$", attr: "preproc",                  captures: { 2: "comment" } },                { match: "^\\s*%(YAML|TAG)\\b.*$", attr: "preproc" },                { match: "^(\\s*)([^\\s#][^:#]*)(:)(\\s*)([|>][+-]?([1-9]?)[+-]?)(\\s*#.*)?$",                  captures: { 2: "variable.member", 3: "punct.delim",                              5: "string", 7: "comment" }, set_aux: 1,                  aux_int: true, aux_add: 1, aux_add_capture: 6,                  push: "block_scalar" },                { match: "^(\\s*)(-)\\s+([|>][+-]?([1-9]?)[+-]?)(\\s*#.*)?$",                  captures: { 2: "punct.delim", 3: "string", 5: "comment" },                  set_aux: 1, aux_int: true, aux_add: 1,                  aux_add_capture: 4, push: "block_scalar" },                { match: "^(\\s*)([^\\s#][^:#]*)(:)(\\s|$)",                  captures: { 2: "variable.member", 3: "punct.delim" },                  consume: 3 },                { match: "^\\s*(-)(\\s|$)", captures: { 1: "punct.delim" } },                { match: "([ \\t]+)(#.*)$", captures: { 2: "comment" } },                { match: "^\\s*#.*$", attr: "comment" },                { match: "\"", attr: "string", push: "dq" },                { match: "'", attr: "string", push: "sq" },                { match: "&[A-Za-z0-9_.-]+", attr: "label" },                { match: "\\*[A-Za-z0-9_.-]+", attr: "label" },                { match: "!![A-Za-z0-9_.-]+|![A-Za-z0-9_!:/.-]+", attr: "type" },                { match: "<<", attr: "keyword.op" },                { match: "\\[", attr: "punct.bracket", push: "flow1" },                { match: "\\{", attr: "punct.bracket", push: "flow1" },                "include:scalars",                { match: "[}\\]]", attr: "punct.bracket" },                { match: "[:,]", attr: "punct.delim" },            ],        },        scalars: {            rules: [                { match: "\\b[0-9]{4}-[0-9]{2}-[0-9]{2}([Tt ]+[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})?)?\\b",                  attr: "constant" },                { match: "\\b[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\b",                  attr: "constant" },                { match: "\\b(true|false)\\b", attr: "boolean", icase: true },                { match: "\\bnull\\b|~", attr: "constant.builtin", icase: true },                { match: "[-+]?(\\.inf|\\.nan)\\b", attr: "number", icase: true },                { match: "[-+]?(0|[1-9][0-9_]*)(\\.[0-9_]+)?([eE][-+]?[0-9]+)?\\b",                  attr: "number" },            ],        },        dq: {            default: "string", at_eol: "pop", unit: "atom",            rules: [                { match: "\\\\(0|a|b|t|n|v|f|r|e| |\"|/|\\\\|N|_|L|P|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",                  attr: "string.escape" },                { match: "\\\\.", attr: "string.escape" },                { match: "\"", attr: "string", pop: 1 },            ],        },        sq: {            default: "string", at_eol: "pop", unit: "atom",            rules: [                { match: "''", attr: "string.escape" },                { match: "'", attr: "string", pop: 1 },            ],        },        flow_common: {            rules: [                { match: "(\"(\\\\.|[^\"\\\\])*\")\\s*:",                  captures: { 1: "variable.member" }, consume: 1 },                { match: "('[^']*'|[A-Za-z_][A-Za-z0-9_.-]*)\\s*:",                  captures: { 1: "variable.member" }, consume: 1 },                { match: "\"", attr: "string", push: "dq" },                { match: "'", attr: "string", push: "sq" },                { match: "&[A-Za-z0-9_.-]+|\\*[A-Za-z0-9_.-]+", attr: "label" },                { match: "!![A-Za-z0-9_.-]+|![A-Za-z0-9_!:/.-]+", attr: "type" },                "include:scalars",                { match: "[:,]", attr: "punct.delim" },            ],        },        flow1: {            default: "text", at_eol: "pop", unit: "span",            rules: [                { match: "[}\\]]", attr: "punct.bracket", pop: 1 },                { match: "[\\[{]", attr: "punct.bracket", push: "flow2" },                "include:flow_common",            ],        },        flow2: {            default: "text", at_eol: "pop:2", unit: "span",            rules: [                { match: "[}\\]]", attr: "punct.bracket", pop: 1 },                { match: "[\\[{]", attr: "punct.bracket", push: "flow3" },                "include:flow_common",            ],        },        flow3: {            default: "text", at_eol: "pop:3", unit: "span",            rules: [                { match: "[}\\]]", attr: "punct.bracket", pop: 1 },                { match: "[\\[{]", attr: "punct.bracket", push: "flow4" },                "include:flow_common",            ],        },        flow4: {            default: "text", at_eol: "pop:4", unit: "span",            rules: [                { match: "[}\\]]", attr: "punct.bracket", pop: 1 },                { match: "[\\[{]", attr: "punct.bracket" },                "include:flow_common",            ],        },        block_scalar: {            default: "string", at_eol: "stay", unit: "atom",            rules: [ { aux: "indent_lt", pop: 1 } ],        },    },}
