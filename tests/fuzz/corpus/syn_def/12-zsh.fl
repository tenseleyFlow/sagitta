{    syntax: 1,    language: {        name: "zsh",        extensions: ["zsh"],        filenames: [".zshenv", ".zprofile", ".zshrc", ".zlogin", ".zlogout"],        shebangs: ["zsh"],        priority: 0,        comment: { line: "#" },    },    contexts: {        main: {            default: "text",            rules: [                { match: "^#!.*$", attr: "preproc", first_line: true },                { match: "<<-\\s*([A-Za-z_][A-Za-z0-9_]*)", attr: "operator",                  captures: { 1: "string" }, set_aux: 1, strip: true,                  push: "heredoc_pending" },                { match: "<<\\s*([A-Za-z_][A-Za-z0-9_]*)", attr: "operator",                  captures: { 1: "string" }, set_aux: 1,                  push: "heredoc_pending" },                "include:tail",            ],        },        tail: {            rules: [                { match: "#.*$", attr: "comment" },                { match: "'", attr: "string", push: "sq" },                { match: "\"", attr: "string", push: "dq" },                { match: "\\\\.", attr: "string.escape" },                { match: "\\$\\(", attr: "string.interp", push: "cmd_sub" },                { match: "`", attr: "string.interp", push: "backtick" },                { match: "\\$\\{", attr: "string.interp", push: "parameter" },                { match: "\\$[A-Za-z_][A-Za-z0-9_]*|\\$[0-9@*#?$!_-]", attr: "variable" },                { match: "\\b(if|then|elif|else|fi|for|foreach|while|until|repeat|do|done|case|esac|select|function|time|coproc)\\b",                  attr: "keyword.control" },                { match: "\\b(typeset|local|integer|float|readonly|export|autoload)\\b",                  attr: "keyword.storage" },                { match: "\\b(setopt|unsetopt|bindkey|zstyle|emulate|whence|print|read|source|alias|unalias|dirs|pushd|popd)\\b",                  attr: "function.builtin" },                { match: "\\([A-Za-z/,.:^@*+-]+\\)", attr: "attribute" },                { match: "([*?]|\\[[^]\\n]+\\])+", attr: "string.special" },                { match: "[0-9]+", attr: "number" },                { match: "&&|\\|\\||[|&;<>]=?", attr: "operator" },                { match: "[(){}\\[\\]]", attr: "punct.bracket" },            ],        },        heredoc_pending: { at_eol: "set:heredoc" },        heredoc: {            default: "string.special", at_eol: "stay", unit: "atom",            rules: [                { aux: "line_eq", attr: "string", pop: 1 },                { match: "\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?", attr: "variable" },                { match: "\\\\[$`\"\\\\]", attr: "string.escape" },            ],        },        sq: {            default: "string", at_eol: "stay", unit: "atom",            rules: [ { match: "'", attr: "string", pop: 1 } ],        },        dq: {            default: "string", at_eol: "stay", unit: "atom",            rules: [                { match: "\\\\[$`\"\\\\]", attr: "string.escape" },                { match: "\\$\\(", attr: "string.interp", push: "cmd_sub" },                { match: "\\$\\{", attr: "string.interp", push: "parameter" },                { match: "\\$[A-Za-z_][A-Za-z0-9_]*|\\$[0-9@*#?$!_-]", attr: "variable" },                { match: "\"", attr: "string", pop: 1 },            ],        },        parameter: {            default: "variable", at_eol: "stay", unit: "span",            rules: [                { match: "\\([A-Za-z@*^~=:-]+\\)", attr: "attribute" },                { match: "[:#%/,+?=^-]+", attr: "operator" },                { match: "}", attr: "string.interp", pop: 1 },            ],        },        cmd_sub: {            default: "text", at_eol: "stay", unit: "span",            rules: [ { match: "\\)", attr: "string.interp", pop: 1 } ],        },        backtick: {            default: "string.special", at_eol: "stay", unit: "span",            rules: [                { match: "\\\\.", attr: "string.escape" },                { match: "`", attr: "string.interp", pop: 1 },            ],        },    },}
