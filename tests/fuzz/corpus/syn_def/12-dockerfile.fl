{    syntax: 1,    language: {        name: "dockerfile",        filenames: ["Dockerfile", "Containerfile", "Dockerfile.*", "*.Dockerfile", "Containerfile.*", "*.Containerfile"],        priority: 0,        comment: { line: "#" },    },    contexts: {        main: {            default: "text",            rules: [                { match: "^#\\s*(syntax|escape)=.*$", attr: "preproc" },                { match: "^\\s*#.*$", attr: "comment" },                { match: "^\\s*(FROM|RUN|CMD|LABEL|MAINTAINER|EXPOSE|ENV|ADD|COPY|ENTRYPOINT|VOLUME|USER|WORKDIR|ARG|ONBUILD|STOPSIGNAL|HEALTHCHECK|SHELL)(\\s+)",                  attr: "preproc", captures: { 1: "keyword.control" },                  consume: 2, push: "body", icase: true },            ],        },        body_parts: {            rules: [                { match: "#.*$", attr: "comment" },                { match: "\\\\\\s*$", attr: "string.escape", set: "continuation_pending" },                { match: "\\$\\{[A-Za-z_][A-Za-z0-9_]*([:+?=-][^}]*)?}", attr: "variable" },                { match: "\\$[A-Za-z_][A-Za-z0-9_]*", attr: "variable" },                { match: "\"", attr: "string", push: "dq" },                { match: "'", attr: "string", push: "sq" },                { match: "--[A-Za-z0-9][A-Za-z0-9_.-]*(=[^ \\t]+)?", attr: "attribute" },                { match: "[\\[\\]{},]", attr: "punct.bracket" },            ],        },        body: {            default: "code", at_eol: "pop", unit: "span",            rules: [ "include:body_parts" ],        },        body_cont: {            default: "code", at_eol: "pop", unit: "span",            rules: [ "include:body_parts" ],        },        continuation_pending: {            default: "code", at_eol: "stay",            rules: [ { aux: "line_start", set: "body_cont" } ],        },        dq: {            default: "string", at_eol: "pop", unit: "atom",            rules: [                { match: "\\\\.", attr: "string.escape" },                { match: "\\$\\{?[A-Za-z_][A-Za-z0-9_]*}?", attr: "variable" },                { match: "\"", attr: "string", pop: 1 },            ],        },        sq: {            default: "string", at_eol: "pop", unit: "atom",            rules: [ { match: "'", attr: "string", pop: 1 } ],        },    },}
