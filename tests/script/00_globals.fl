# Sprint 37: batch globals and assertion basics.
import list
import str

t.eq(batch, true)
t.eq(list.len(args), 0)
t.eq(list.len(files), 0)
t.ne(script_path, "")
t.eq(str.starts_with(script_path, "/"), true)
t.eq(1 + 1, 2, "integer equality")
t.ne("sag", "Sag")
t.ne([1, 2], [1, 2])
t.ne({mode: "batch"}, {mode: "batch"})
t.eq(nil, nil)
