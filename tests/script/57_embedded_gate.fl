# Sprint 57 constrained-target rows 6 and 7.  The 4 MiB fixture is also
# opened and saved here; the guest compares its hash before and after while
# the live PTY row independently exercises render, EOF motion, and save.
import buf
import ed
import io
import list
import map
import re
import span
import str

if list.len(files) != 1 { error("embedded gate needs exactly one file") }
let b = buf.current()
let original_len = buf.len(b)
t.eq(original_len, 4194304)

# The marker begins 22 bytes before EOF.  Walk the entire buffer in bounded
# overlapping spans so the constrained target proves a whole-file regex
# traversal without materializing a second 4 MiB string in the VM.
let at = 0
let hit_lo = -1
let hit_hi = -1
while at < original_len {
    let hi = at + 65536
    if hi > original_len { hi = original_len }
    let lo = at
    if lo > 17 { lo = lo - 17 }
    let source = span.text(buf.span(b, lo, hi))
    let hit = re.find(source, "YEW_EMBED_SENTINEL")
    if hit != nil {
        hit_lo = lo + map.get(hit, "lo")
        hit_hi = lo + map.get(hit, "hi")
        at = original_len
    } else {
        at = hi
    }
}
t.eq(hit_lo, 4194282)
t.eq(hit_hi, 4194300)
io.print("search", hit_lo, hit_hi)

# One edit block is one undo transaction.  Keep all 500 nodes live, undo to
# the exact original, save it, then redo every node and verify the tail.
let i = 0
while i < 500 {
    edit { buf.insert(b, buf.len(b), "x") }
    i = i + 1
}
t.undo(b, 501)
i = 0
while i < 500 {
    ed.run("ed.edit.undo", {})
    i = i + 1
}
t.eq(buf.len(b), original_len)
buf.save(b)
t.eq(buf.dirty(b), false)
io.print("roundtrip", original_len, buf.len(b))

i = 0
while i < 500 {
    ed.run("ed.edit.redo", {})
    i = i + 1
}
t.eq(buf.len(b), original_len + 500)
let tail = buf.span(b, original_len, original_len + 500)
t.eq(span.text(tail), str.repeat("x", 500))
t.undo(b, 501)
i = 0
while i < 500 {
    ed.run("ed.edit.undo", {})
    i = i + 1
}
t.eq(buf.len(b), original_len)
t.eq(buf.dirty(b), false)
io.print("undo-redo", 500)
