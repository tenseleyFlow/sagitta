# yew's shipped AI deny patterns. User rows append unless
# ai.deny_replace is explicitly enabled in the global config.
[
  { name: "aws-access-key", re: "\\b(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA|AGPA|AIDA|AIPA|ANPA|ANVA|AROA)[A-Z0-9]{16}\\b", flags: "", note: "AWS access key id" },
  { name: "aws-secret", re: "(?i:aws_?secret_?access_?key)[^\\n]{0,20}[:=][^\\n]{0,4}[A-Za-z0-9/+=]{40}", flags: "", note: "labelled AWS secret" },
  { name: "pem-private-key", re: "-----BEGIN [A-Z0-9 ]{0,32}PRIVATE KEY-----", flags: "", note: "PEM private-key header" },
  { name: "ssh-private-key", re: "\\bssh-rsa AAAA[A-Za-z0-9+/]{100,}", flags: "", note: "SSH private-key blob" },
  { name: "bearer-token", re: "(?i:bearer)[ \\t]+[A-Za-z0-9._~+/-]{16,}={0,2}", flags: "", note: "bearer token" },
  { name: "authorization-header", re: "(?i:authorization)[ \\t]*[:=][ \\t]*[\"']?[A-Za-z0-9._~+/-]{16,}", flags: "", note: "authorization header" },
  { name: "jwt", re: "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b", flags: "", note: "JSON web token" },
  { name: "env-assignment", re: "(?i:^[ \\t]*(export[ \\t]+)?[A-Za-z_][A-Za-z0-9_]*(SECRET|TOKEN|PASSWORD|PASSWD|PRIVATE_KEY|API_?KEY|CREDENTIAL)[A-Za-z0-9_]*[ \\t]*=[ \\t]*[\"']?[^\\n\"' \\t]{8,})", flags: "", note: "secret-named environment assignment" },
  { name: "conn-string-creds", re: "\\b[a-z][a-z0-9+.-]{1,31}://[^\\n/:@ ]{1,64}:[^\\n/@ ]{1,128}@", flags: "", note: "credentialed connection string" },
  { name: "github-token", re: "\\bgh[pousr]_[A-Za-z0-9]{36,255}\\b", flags: "", note: "GitHub token" },
  { name: "slack-token", re: "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b", flags: "", note: "Slack token" },
  { name: "google-api-key", re: "\\bAIza[A-Za-z0-9_-]{35}\\b", flags: "", note: "Google API key" },
  { name: "openai-key", re: "\\bsk-[A-Za-z0-9_-]{20,}\\b", flags: "", note: "OpenAI-compatible key" },
  { name: "anthropic-key", re: "\\bsk-ant-[A-Za-z0-9_-]{20,}\\b", flags: "", note: "Anthropic key" },
  { name: "private-key-var", re: "(?i:private_?key)[ \\t]*[:=][ \\t]*[\"'][^\\n\"']{32,}", flags: "", note: "private key literal" },
  { name: "htpasswd-bcrypt", re: "\\$2[aby]?\\$[0-9]{2}\\$[A-Za-z0-9./]{53}", flags: "", note: "bcrypt credential hash" },
]
