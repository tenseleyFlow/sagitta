bind("E", "<left>", "ed.move.char.prev")
bind("E", "<right>", "ed.cmdline.ghost.accept")
bind("E", "<home>", "ed.move.line.home_toggle")
bind("E", "<end>", "ed.move.line.end")
bind("E", "C-a", "ed.move.line.home")
bind("E", "C-e", "ed.move.line.end")
bind("E", "<bs>", "ed.edit.delete.grapheme_left")
bind("E", "<del>", "ed.edit.delete.grapheme")
bind("E", "C-w", "ed.del.word_prev")
bind("E", "C-u", "ed.del.to_home")
bind("E", "C-k", "ed.del.to_end")
bind("E", "<up>", "ed.cmdline.up")
bind("E", "<down>", "ed.cmdline.down")
bind("E", "<tab>", "ed.cmdline.complete_next")
bind("E", "S-<tab>", "ed.cmdline.complete_prev")
bind("E", "C-n", "ed.cmdline.complete_next")
bind("E", "C-p", "ed.cmdline.complete_prev")
bind("E", "<pgdn>", "ed.cmdline.menu.page_next")
bind("E", "<pgup>", "ed.cmdline.menu.page_prev")
bind("E", "C-r", "ed.cmdline.insert_register")
bind("E", "C-v", "ed.cmdline.literal_next")
bind("E", "C-z", "ed.edit.undo")
bind("E", "C-y", "ed.edit.redo")
bind("E", "C-g", "ed.cmdline.cancel")

bind("F", "<esc>", "ed.git.mode.leave")
bind("F", "C-w s", "ed.git.open_split_h")
bind("F", "C-w v", "ed.git.open_split_v")

# -- 6. macros ----------------------------------------------------------
bind("*", "q", "ed.macro.record")
bind("*", "@", "ed.macro.replay")
bind("*", "@ @", "ed.macro.replay_last")
bind("*", "Q", "ed.macro.list")

# -- 7. hooks -----------------------------------------------------------
# Hooks are intentionally absent by default: examples must not produce
# messages or mutate options in an otherwise idle editor.

# -- 8. functions -------------------------------------------------------
# User helpers belong in the personal init.fl above this shipped baseline.
