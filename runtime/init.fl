# yew default configuration.  This file IS the keymap: every default
# binding below is real, and copying a line into your own init.fl and
# changing it is the whole customization story.
#
# Version: Sprint 36 configuration surface.
# Budget: this file is parsed and run before the first paint and must stay
# under 1 ms (see Sprint 33's config-load gate).  It imports nothing on
# purpose -- every import is a file read on the startup path.

# -- 1. options ---------------------------------------------------------
set({
    tabwidth: 4,
    expandtab: false,
    autoindent: true,
    autopair: true,
    wrap: false,
    scrolloff: 3,
    number: "both",
    "statusline.column": "gcol",
    errorbells: false,
    ambiguous_wide: false,
    subword: false,
    chord_timeout_ms: 500,
    "undo.break_on_newline": true,
    "undo.bytes_max": 67108864,
    "undo.min_nodes": 200,
    "undo.persist_bytes_max": 16777216,
    "registers.ring_depth": 32,
    "registers.ring_bytes_max": 8388608,
    "registers.clip_read_max": 67108864,
    "clipboard.sync": "yank",
    "search.ignorecase": false,
    "search.smartcase": true,
    "hooks.error_limit": 5,
    theme: "quiver-dark",
    "macro.dir": "",
    "shadow.enable": true,
    "shadow.providers": "index lsp ai",
    "shadow.max_lines": 8,
    "shadow.midline": false,
    "shadow.lsp_debounce_ms": 120,
    "shadow.ai_debounce_ms": 350,
    "compl.auto_trigger": false,
    "compl.trigger_chars": ". -> ::",
})

# YEW-F-075: module-owned options keep their descriptor defaults here.  A
# user config may set them when that module is built, but this core default
# file must also execute unchanged when every optional module is excluded.

# -- 2. unit modes (L line, W word, B block) ----------------------------
bind("L", "<left>", "ed.move.unit.home")
bind("L", "<right>", "ed.move.unit.end")
bind("L", "<up>", "ed.move.unit.prev")
bind("L", "<down>", "ed.move.unit.next")
bind("L", "S-<left>", "ed.sel.extend.left")
bind("L", "S-<right>", "ed.sel.extend.right")
bind("L", "S-<up>", "ed.sel.extend.up")
bind("L", "S-<down>", "ed.sel.extend.down")
bind("L", "C-v", "ed.clip.paste")
bind("L", "A-<left>", "ed.move.unit.home_alt")
bind("L", "A-<right>", "ed.shadow.accept_word")
bind("L", "A-S-<right>", "ed.shadow.accept_word_alt")
bind("L", "A-<up>", "ed.git.hunk.prev")
bind("L", "A-<down>", "ed.git.hunk.next")
bind("L", "A-S-<up>", "ed.move.unit.prev_alt")
bind("L", "A-S-<down>", "ed.shadow.accept_line")
bind("L", "A-<cr>", "ed.shadow.accept_all")
bind("L", "A-]", "ed.shadow.next")
bind("L", "A-[", "ed.shadow.prev")
# <home> alternates between the first non-blank and column 0 in every
# mode that binds it.  A-<left> keeps ed.move.unit.home_alt and the
# bare `0` below keeps ed.move.unit.home: only <home> toggles.
bind("L", "<home>", "ed.move.line.home_toggle")
bind("L", "<end>", "ed.move.unit.end")
bind("L", "<pgup>", "ed.view.page_up")
bind("L", "<pgdn>", "ed.view.page_down")
bind("L", "i", "ed.mode.enter", { sarg: "I" })
bind("L", "a", "ed.edit.insert.after")
bind("L", "o", "ed.edit.line.open_below")
bind("L", "O", "ed.edit.line.open_above")
bind("L", "x", "ed.edit.delete.grapheme")
bind("L", "d d", "ed.edit.line.delete")
bind("L", "u", "ed.edit.undo")
bind("L", "C-r", "ed.edit.redo")
bind("L", "<esc>", "ed.mode.escape")
bind("L", "g a", "ed.sel.all")
bind("L", "g g", "ed.move.buf.home")
bind("L", "m", "ed.mark.set")
bind("L", "'", "ed.mark.jump")
bind("L", "/", "ed.search.open")
bind("L", "?", "ed.search.open_back")
bind("L", "n", "ed.search.next")
bind("L", "N", "ed.search.prev")
bind("L", "*", "ed.search.word_next")
bind("L", "#", "ed.search.word_prev")
bind("L", "K", "ed.lsp.hover")
bind("L", "g d", "ed.lsp.goto_def")
bind("L", "g D", "ed.lsp.goto_decl")
bind("L", "g y", "ed.lsp.goto_type")
bind("L", "g i", "ed.lsp.goto_impl")
bind("L", "g r", "ed.lsp.references")
bind("L", "g R", "ed.lsp.rename")
bind("L", "g s", "ed.lsp.symbols")
bind("L", "C-o", "ed.jump.back")
bind("L", "C-i", "ed.jump.fwd")
bind("L", "g ;", "ed.change.older")
bind("L", "g ,", "ed.change.newer")
bind("L", "G", "ed.move.buf.end")
bind("L", "s", "ed.file.save")
bind("L", "C-z", "ed.suspend")
bind("L", "C-l", "ed.redraw")
bind("L", "C-g", "ed.ui.message_expand")
bind("L", "0", "ed.move.unit.home")
bind("L", "w", "ed.mode.enter", { sarg: "W" })
bind("L", "b", "ed.mode.enter", { sarg: "B" })
bind("L", "h", "ed.mode.enter", { sarg: "H" })
bind("L", "!", "ed.shell.open")
bind("L", "e", "ed.mode.enter", { sarg: "E" })
bind("L", "f", "ed.mode.enter", { sarg: "F" })

bind("W", "<left>", "ed.move.unit.prev")
bind("W", "<right>", "ed.move.unit.next")
bind("W", "<up>", "ed.move.line.up")
bind("W", "<down>", "ed.move.line.down")
bind("W", "S-<left>", "ed.sel.extend.left")
bind("W", "S-<right>", "ed.sel.extend.right")
bind("W", "S-<up>", "ed.sel.extend.up")
bind("W", "S-<down>", "ed.sel.extend.down")
bind("W", "C-v", "ed.clip.paste")
bind("W", "A-<left>", "ed.move.unit.prev_alt")
bind("W", "A-<right>", "ed.shadow.accept_word")
bind("W", "A-S-<right>", "ed.shadow.accept_word_alt")
bind("W", "A-<up>", "ed.git.hunk.prev")
bind("W", "A-<down>", "ed.git.hunk.next")
bind("W", "A-S-<down>", "ed.shadow.accept_line")
bind("W", "A-<cr>", "ed.shadow.accept_all")
bind("W", "A-]", "ed.shadow.next")
bind("W", "A-[", "ed.shadow.prev")
bind("W", "C-<left>", "ed.move.word.sub_prev")
bind("W", "C-<right>", "ed.move.word.sub_next")
bind("W", "<home>", "ed.move.line.home_toggle")
bind("W", "<end>", "ed.move.unit.end")
bind("W", "l", "ed.mode.enter", { sarg: "L" })
bind("W", "b", "ed.mode.enter", { sarg: "B" })
bind("W", "i", "ed.mode.enter", { sarg: "I" })
bind("W", "h", "ed.mode.enter", { sarg: "H" })
bind("W", "f", "ed.mode.enter", { sarg: "F" })
bind("W", "e", "ed.mode.enter", { sarg: "E" })
bind("W", ":", "ed.mode.enter", { sarg: "E" })
bind("W", "!", "ed.shell.open")
bind("W", "<esc>", "ed.mode.escape")
bind("W", "C-g", "ed.ui.message_expand")

bind("B", "<left>", "ed.move.unit.home")
bind("B", "<right>", "ed.move.unit.end")
bind("B", "<up>", "ed.move.unit.prev")
bind("B", "<down>", "ed.move.unit.next")
bind("B", "S-<left>", "ed.sel.extend.left")
bind("B", "S-<right>", "ed.sel.extend.right")
bind("B", "S-<up>", "ed.sel.extend.up")
bind("B", "S-<down>", "ed.sel.extend.down")
bind("B", "C-v", "ed.clip.paste")
bind("B", "A-<left>", "ed.move.block.match_prev")
bind("B", "A-<right>", "ed.shadow.accept_word")
bind("B", "A-S-<right>", "ed.shadow.accept_word_alt")
bind("B", "A-<up>", "ed.git.hunk.prev")
bind("B", "A-<down>", "ed.git.hunk.next")
bind("B", "A-S-<up>", "ed.sel.unit.expand")
bind("B", "A-S-<down>", "ed.shadow.accept_line")
bind("B", "A-<cr>", "ed.shadow.accept_all")
bind("B", "A-]", "ed.shadow.next")
bind("B", "A-[", "ed.shadow.prev")
bind("B", "l", "ed.mode.enter", { sarg: "L" })
bind("B", "w", "ed.mode.enter", { sarg: "W" })
bind("B", "i", "ed.mode.enter", { sarg: "I" })
bind("B", "h", "ed.mode.enter", { sarg: "H" })
bind("B", "f", "ed.mode.enter", { sarg: "F" })
bind("B", "e", "ed.mode.enter", { sarg: "E" })
bind("B", ":", "ed.mode.enter", { sarg: "E" })
bind("B", "!", "ed.shell.open")
bind("B", "<esc>", "ed.mode.escape")
bind("B", "C-g", "ed.ui.message_expand")

# -- 3. I mode ----------------------------------------------------------
bind("I", "A-h", "ed.mode.enter", { sarg: "H" })
bind("I", "<esc>", "ed.shadow.dismiss")
bind("I", "C-g", "ed.ui.message_expand")
# Alt+arrow is the word jump in I mode.  Alt+Right stays contextual: it
# accepts one word of a suggestion only while one is showing, and is
# the word jump otherwise, so the key is never dead.
bind("I", "A-<left>", "ed.move.word.prev")
# Readline spelling of the same motions.  A terminal that will not
# send CSI 1;3D for alt+arrow almost always sends ESC b / ESC f,
# which the decoder already reports as A-b / A-f -- so these are
# what actually reach yew under Terminal.app and tmux.
bind("I", "A-b", "ed.move.word.prev")
bind("I", "A-f", "ed.move.word.next")
bind("I", "A-<right>", "ed.shadow.accept_or_word")
bind("I", "A-S-<right>", "ed.shadow.accept_word_alt")
bind("I", "A-<down>", "ed.shadow.accept_line")
bind("I", "A-<cr>", "ed.shadow.accept_all")
bind("I", "A-]", "ed.shadow.next")
bind("I", "A-[", "ed.shadow.prev")
bind("I", "C-<space>", "ed.lsp.complete")
# Signature help moves off C-k, which every readline user's fingers
# already spend on kill-to-end.
bind("I", "A-k", "ed.lsp.signature")
bind("I", "<cr>", "ed.edit.insert.newline")
bind("I", "<tab>", "ed.edit.insert.tab")
bind("I", "<bs>", "ed.edit.delete.grapheme_left")
bind("I", "<del>", "ed.edit.delete.grapheme")
bind("I", "<left>", "ed.move.unit.prev")
bind("I", "<right>", "ed.move.unit.next")
bind("I", "<up>", "ed.move.line.up")
bind("I", "<down>", "ed.move.line.down")
bind("I", "S-<left>", "ed.sel.extend.left")
bind("I", "S-<right>", "ed.sel.extend.right")
bind("I", "S-<up>", "ed.sel.extend.up")
bind("I", "S-<down>", "ed.sel.extend.down")
bind("I", "C-v", "ed.clip.paste")
bind("I", "<home>", "ed.move.line.home_toggle")
bind("I", "<end>", "ed.move.line.end")
# Ctrl+arrow is the LINE's start and end here, the same pair <home>/<end>
# give above -- NOT the word jump the usual convention puts on Ctrl+arrow.
# In yew the word jump is Alt+arrow (below), so leave these alone.
# The unix line keys, which every terminal sends as plain control
# bytes -- unlike ctrl+arrow, which Terminal.app and an unconfigured
# tmux swallow entirely.  Same pair the command line already uses.
bind("I", "C-a", "ed.move.line.home_toggle")
bind("I", "C-e", "ed.move.line.end")
bind("I", "C-<left>", "ed.move.line.home_toggle")
bind("I", "C-<right>", "ed.move.line.end")

# The rest of the readline/Emacs editing set.  These are DOCUMENT
# commands, not the command line's ed.del.* -- they fan out to every
# live cursor and they are recordable, which E mode's do not need to be.
# Alt+Backspace and C-w are the same kill; a terminal sends one or the
# other depending on how it was configured, so both are bound.
bind("I", "C-w", "ed.edit.kill.word_prev")
bind("I", "A-<bs>", "ed.edit.kill.word_prev")
bind("I", "A-d", "ed.edit.kill.word_next")
# C-u is kill-to-START of line, the unix line-discard, NOT the whole
# line -- what is already typed to the right of the caret survives.
bind("I", "C-u", "ed.edit.kill.to_home")
bind("I", "C-k", "ed.edit.kill.to_end")
# C-d deletes one grapheme forward and NOTHING else.  In a shell it is
# also EOF; here that would close a buffer on a keystroke meant to
# delete a character, so it is only ever the delete.
bind("I", "C-d", "ed.edit.delete.grapheme")
# C-y yanks the most recent kill from the unnamed register.  C-v stays
# the SYSTEM clipboard paste above, and E mode's C-y stays redo -- the
# divergence is deliberate: in Insert mode the readline meaning wins.
bind("I", "C-y", "ed.edit.kill.yank")
bind("I", "C-p", "ed.move.line.up")
bind("I", "C-n", "ed.move.line.down")
# Undo.  A terminal in legacy mode sends 0x1F for both ctrl+_ and
# ctrl+/, which the decoder reports as C-_; under the kitty keyboard
# protocol ctrl+/ arrives as itself.  Bind both so the chord works
# whichever protocol is negotiated.
bind("I", "C-_", "ed.edit.undo")
bind("I", "C-/", "ed.edit.undo")
bind("I", "C-t", "ed.edit.transpose.chars")
bind("I", "A-t", "ed.edit.transpose.words")
bind("I", "A-u", "ed.edit.case.upper_word")
bind("I", "A-l", "ed.edit.case.lower_word")
bind("I", "A-c", "ed.edit.case.cap_word")

# -- 4. H mode ----------------------------------------------------------
# H-mode motions remain unit-sensitive: the C motion table is rebuilt when
# a line, word, block, or character selection enters H.  Its operators are
# likewise kept in that adaptive table so a config layer cannot mask them.

# -- 5. global navigation and E/F modes ---------------------------------
bind("L", "C-w s", "ed.pane.split_h")
bind("L", "C-w v", "ed.pane.split_v")
bind("L", "C-w c", "ed.pane.close")
bind("L", "C-w <left>", "ed.pane.focus_left")
bind("L", "C-w <right>", "ed.pane.focus_right")
bind("L", "C-w <up>", "ed.pane.focus_up")
bind("L", "C-w <down>", "ed.pane.focus_down")
bind("L", "C-w w", "ed.pane.focus_next")
bind("L", "C-w =", "ed.pane.grow")
bind("L", "C-w -", "ed.pane.shrink")
bind("L", "t n", "ed.tab.next")
bind("L", "t p", "ed.tab.prev")
bind("L", "t t", "ed.tab.new")
bind("L", "t c", "ed.tab.close")
bind("L", "C-<pgdn>", "ed.file.next")
bind("L", "C-<pgup>", "ed.file.prev")
bind("L", "t <right>", "ed.file.next")
bind("L", "t <left>", "ed.file.prev")
bind("L", "t <down>", "ed.group.enter")
bind("L", "t <up>", "ed.group.leave")
bind("L", "t g", "ed.group.new")
bind("L", "t e", "ed.group.edit")
bind("L", "t d", "ed.group.dissolve")
bind("L", "t r", "ed.group.remove_tab")
bind("L", "t m", "ed.ui.context_menu")
bind("L", "t l", "ed.group.rename")
bind("L", "t o", "ed.tab.close_others")
bind("L", "t y", "ed.tab.copy_path")
bind("L", "A-1", "ed.tab.goto", { iarg: 1 })
bind("L", "A-2", "ed.tab.goto", { iarg: 2 })
bind("L", "A-3", "ed.tab.goto", { iarg: 3 })
bind("L", "A-4", "ed.tab.goto", { iarg: 4 })
bind("L", "A-5", "ed.tab.goto", { iarg: 5 })
bind("L", "A-6", "ed.tab.goto", { iarg: 6 })
bind("L", "A-7", "ed.tab.goto", { iarg: 7 })
bind("L", "A-8", "ed.tab.goto", { iarg: 8 })
bind("L", "A-9", "ed.tab.goto", { iarg: 9 })
bind("L", "A-0", "ed.tab.goto")
bind("L", "C-1", "ed.tab.goto_bar", { iarg: 1 })
bind("L", "C-2", "ed.tab.goto_bar", { iarg: 2 })
bind("L", "C-3", "ed.tab.goto_bar", { iarg: 3 })
bind("L", "C-4", "ed.tab.goto_bar", { iarg: 4 })
bind("L", "C-5", "ed.tab.goto_bar", { iarg: 5 })
bind("L", "C-6", "ed.tab.goto_bar", { iarg: 6 })
bind("L", "C-7", "ed.tab.goto_bar", { iarg: 7 })
bind("L", "C-8", "ed.tab.goto_bar", { iarg: 8 })
bind("L", "C-9", "ed.tab.goto_bar", { iarg: 9 })
bind("L", "C-0", "ed.tab.goto_bar")

# The numbered jumps are navigation, not editing, so every document
# mode reaches them -- Insert included, where leaving the mode to
# change tab was the whole complaint.  E is excluded: a digit there
# is a character of the command being typed.
bind("W", "A-1", "ed.tab.goto", { iarg: 1 })
bind("W", "A-2", "ed.tab.goto", { iarg: 2 })
bind("W", "A-3", "ed.tab.goto", { iarg: 3 })
bind("W", "A-4", "ed.tab.goto", { iarg: 4 })
bind("W", "A-5", "ed.tab.goto", { iarg: 5 })
bind("W", "A-6", "ed.tab.goto", { iarg: 6 })
bind("W", "A-7", "ed.tab.goto", { iarg: 7 })
bind("W", "A-8", "ed.tab.goto", { iarg: 8 })
bind("W", "A-9", "ed.tab.goto", { iarg: 9 })
bind("W", "A-0", "ed.tab.goto")
bind("W", "C-1", "ed.tab.goto_bar", { iarg: 1 })
