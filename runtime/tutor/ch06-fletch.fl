# Chapter 6: recordings are Fletch source.  Recorder/register state queries
# are supplied by the public editor module, not by a tutor-only back door.
import ed
import str

let tasks = [
    { id: "ch06.t1", line: 6, prompt: "Start recording register a with q a.",
      keys: "q a", check: fn(b, w) ed.recording() == "a" },
    { id: "ch06.t2", line: 7, prompt: "Insert X at the start of the title.",
      keys: "i X <esc>", check: fn(b, w) {
          return b.lines() > 0 and str.starts_with(b.line(1), "X")
      } },
    { id: "ch06.t3", line: 8, prompt: "Stop recording with q.",
      keys: "q", check: fn(b, w) {
          let source = ed.register("a");
          return ed.recording() == nil and source != nil and
                 str.contains(source, "@[" )
      } },
    { id: "ch06.t4", line: 9, prompt: "Replay register a with @ a.",
      keys: "@ a", check: fn(b, w) {
          return b.lines() > 0 and str.starts_with(b.line(1), "XX")
      } },
    { id: "ch06.t5", line: 10, prompt: "Paste register a into this buffer with quote-a-p.",
      keys: "\" a p", check: fn(b, w) str.contains(b.text(), "# yew-macro:") },
    { id: "ch06.t6", line: 11, prompt: "Find the generated Fletch motion block with /@[.",
      keys: "/ @ [ <cr>", check: fn(b, w) str.contains(b.text(), "@[") },
    { id: "ch06.t7", line: 12, prompt: "Save the edited lesson with s.",
      keys: "s", check: fn(b, w) not b.dirty() },
]
