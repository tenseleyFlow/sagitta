# Chapter 4: directional search, smartcase, replacement, and undo.
import list
import str

fn cursor(w) {
    let cursors = w.cursors()
    if list.len(cursors) == 0 { return nil }
    return cursors[0]
}

fn on_line(w, line) {
    let c = cursor(w)
    return c != nil and c.line() == line
}

let tasks = [
    { id: "ch04.t1", line: 6, prompt: "Search forward for needle.",
      keys: "/ n e e d l e <cr>", check: fn(b, w) on_line(w, 14) },
    { id: "ch04.t2", line: 7, prompt: "Press n to reach the second lowercase match.",
      keys: "n", check: fn(b, w) on_line(w, 16) },
    { id: "ch04.t3", line: 8, prompt: "Press n again to reach the third match.",
      keys: "n", check: fn(b, w) on_line(w, 17) },
    { id: "ch04.t4", line: 9, prompt: "Press N once to return to the second match.",
      keys: "N", check: fn(b, w) on_line(w, 16) },
    { id: "ch04.t5", line: 10, prompt: "Search for Needle and observe smartcase.",
      keys: "/ N e e d l e <cr>", check: fn(b, w) on_line(w, 15) },
    { id: "ch04.t6", line: 11,
      prompt: "Replace every lowercase needle with pin.",
      keys: ": % s / n e e d l e / p i n / g <cr>", check: fn(b, w) {
          if b.lines() < 17 { return false }
          return not str.contains(b.line(14), "needle") and
                 str.contains(b.line(15), "Needle") and
                 not str.contains(b.line(16), "needle") and
                 not str.contains(b.line(17), "needle")
      } },
    { id: "ch04.t7", line: 12,
      prompt: "Undo both the task mark and replacement with 2u.",
      keys: "2 u", check: fn(b, w) {
          if b.lines() < 17 { return false }
          return str.contains(b.line(14), "needle") and
                 str.contains(b.line(16), "needle") and
                 str.contains(b.line(17), "needle")
      } },
]
