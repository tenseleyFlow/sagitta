# Chapter 5: panes, tab groups, and persistent workspace state.
import ed
import list
import win

fn cursor(w) {
    let cursors = w.cursors()
    if list.len(cursors) == 0 { return nil }
    return cursors[0]
}

fn notes_group() {
    for group in ed.workspace().groups {
        if group.name == "notes" { return group }
    }
    return nil
}

fn active_panes() {
    for tab in ed.workspace().tabs {
        if tab.active { return tab.panes }
    }
    return []
}

let tasks = [
    { id: "ch05.t1", line: 6,
      prompt: "Dissolve the seeded tutor group with t d.",
      keys: "t d", check: fn(b, w) list.len(ed.workspace().groups) == 0 },
    { id: "ch05.t2", line: 7,
      prompt: "Create notes from ch01–ch03 with t g and the picker.",
      keys: "t g <down> <space> <space> <space> <tab> <bs> <bs> <bs> <bs> <bs> <bs> n o t e s <cr>",
      check: fn(b, w) {
          let group = notes_group();
          return group != nil and group.members == 3
      } },
    { id: "ch05.t3", line: 8,
      prompt: "Split this tab side by side with Ctrl-W s.",
      keys: "C-w s", check: fn(b, w) {
          let panes = active_panes();
          if list.len(panes) != 2 { return false }
          let a = panes[0];
          let z = panes[1];
          return a.w > 0 and a.h > 0 and z.w > 0 and z.h == a.h and
                 z.y == a.y and z.x == a.x + a.w + 1
      } },
    { id: "ch05.t4", line: 9,
      prompt: "Move Down in one pane to give it distinct state.",
      keys: "<down>", check: fn(b, w) {
          let c = cursor(w); return c != nil and c.line() == 2 and
                                    list.len(win.list()) == 8
      } },
    { id: "ch05.t5", line: 10,
      prompt: "Focus the other pane with Ctrl-W w.",
      keys: "C-w w", check: fn(b, w) {
          let c = cursor(w); return c != nil and c.line() == 1 and
                                    list.len(win.list()) == 8
      } },
    { id: "ch05.t6", line: 11,
      prompt: "Focus back with Ctrl-W w; its line-2 cursor returns.",
      keys: "C-w w", check: fn(b, w) {
          let c = cursor(w); return c != nil and c.line() == 2 and
                                    list.len(active_panes()) == 2
      } },
    { id: "ch05.t7", line: 12,
      prompt: "Move to the RESUME MARKER with 14G.",
      keys: "1 4 G", check: fn(b, w) {
          let c = cursor(w); return c != nil and c.line() == 14
      } },
]
