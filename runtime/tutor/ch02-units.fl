# Chapter 2: unit modes, Highlight mode, and multi-cursor lifting.
import ed
import list
import str

fn cursor(w) {
    let cursors = w.cursors()
    if list.len(cursors) == 0 { return nil }
    return cursors[0]
}

let tasks = [
    { id: "ch02.t1", line: 6, prompt: "Press w to enter W mode.",
      keys: "w", check: fn(b, w) ed.mode() == "W" },
    { id: "ch02.t2", line: 7, prompt: "Move Right once to the next word.",
      keys: "<right>", check: fn(b, w) {
          let c = cursor(w); return c != nil and c.col() > 0
      } },
    { id: "ch02.t3", line: 8, prompt: "Press b to layer Block mode over the arrows.",
      keys: "b", check: fn(b, w) ed.mode() == "B" },
    { id: "ch02.t4", line: 9, prompt: "Move Down to the next block.",
      keys: "<down>", check: fn(b, w) {
          let c = cursor(w); return c != nil and c.line() > 1
      } },
    { id: "ch02.t5", line: 10, prompt: "Press h to enter Highlight mode.",
      keys: "h", check: fn(b, w) ed.mode() == "H" },
    { id: "ch02.t6", line: 11, prompt: "Extend the selection with Shift-Down.",
      keys: "S-<down>", check: fn(b, w) w.selection() != nil },
    { id: "ch02.t7", line: 12,
      prompt: "Lift the selection with Enter, then type ! once.",
      keys: "<cr> !", check: fn(b, w) {
          return list.len(w.cursors()) > 1 and str.contains(b.text(), "!") and
                 b.undo_depth() > 0
      } },
]
