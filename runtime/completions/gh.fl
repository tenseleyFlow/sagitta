# gh 2.98.0 (2026-08-20) -- from `gh help` and `gh <command> <subcommand> --help`.
#
# runtime/completions/gh.fl: completion spec for the GitHub CLI. Every
# command and subcommand; the common flags only (embedded-size budget).
# No generators: every list gh could offer needs the network.
{
    completion: 1,
    command: "gh",
    description: "the GitHub CLI",

    flags: [
        { long: "help", global: true, desc: "show help for command" },
        { long: "version", desc: "show gh version" },
    ],

    subcommands: [
        { name: "auth", desc: "authenticate gh and git with GitHub",
          subcommands: [
            { name: "login", desc: "log in to a GitHub account",
              flags: [
                  { long: "git-protocol", short: "p", desc: "the protocol to use for git operations on this host", arg: { kind: "values", values: ["ssh", "https"] } },
                  { long: "hostname", short: "h", desc: "the GitHub hostname", arg: { kind: "none" } },
                  { long: "scopes", short: "s", desc: "additional authentication scopes to request", arg: { kind: "none" } },
                  { long: "web", short: "w", desc: "open in the web browser" },
                  { long: "with-token", desc: "read token from standard input" },
              ] },
            { name: "logout", desc: "log out of a GitHub account",
              flags: [
                  { long: "hostname", short: "h", desc: "the GitHub hostname", arg: { kind: "none" } },
                  { long: "user", short: "u", desc: "the account to log out of", arg: { kind: "none" } },
              ] },
            { name: "refresh", desc: "refresh stored authentication credentials",
              flags: [
                  { long: "hostname", short: "h", desc: "the GitHub hostname", arg: { kind: "none" } },
                  { long: "remove-scopes", short: "r", desc: "authentication scopes to remove from gh", arg: { kind: "none" } },
                  { long: "scopes", short: "s", desc: "additional authentication scopes for gh to have", arg: { kind: "none" } },
              ] },
            { name: "setup-git", desc: "setup git with GitHub CLI",
              flags: [
                  { long: "hostname", short: "h", desc: "the GitHub hostname", arg: { kind: "none" } },
              ] },
            { name: "status",
              desc: "display active account and auth state per host",
              flags: [
                  { long: "active", short: "a", desc: "display the active account only" },
                  { long: "hostname", short: "h", desc: "the GitHub hostname", arg: { kind: "none" } },
                  { long: "show-token", short: "t", desc: "display the auth token" },
              ] },
            { name: "switch", desc: "switch active GitHub account",
              flags: [
                  { long: "hostname", short: "h", desc: "the GitHub hostname", arg: { kind: "none" } },
                  { long: "user", short: "u", desc: "the account to switch to", arg: { kind: "none" } },
              ] },
            { name: "token", desc: "print the authentication token gh uses",
              flags: [
                  { long: "hostname", short: "h", desc: "the GitHub hostname", arg: { kind: "none" } },
                  { long: "user", short: "u", desc: "the account to output the token for", arg: { kind: "none" } },
              ] },
          ] },

        { name: "browse",
          desc: "open repos, issues, pull requests and more in the browser",
          flags: [
              { long: "actions", short: "a", desc: "open repository actions" },
              { long: "branch", short: "b", desc: "select another branch by passing in the branch name", arg: { kind: "none" } },
              { long: "commit", short: "c", desc: "select another commit (default: the last commit)", arg: { kind: "none" }, arg_optional: true },
              { long: "no-browser", short: "n", desc: "print destination URL instead of opening the browser" },
              { long: "projects", short: "p", desc: "open repository projects" },
              { long: "releases", short: "r", desc: "open repository releases" },
              { long: "repo", short: "R", desc: "select another repository ([HOST/]OWNER/REPO)", arg: { kind: "none" } },
              { long: "settings", short: "s", desc: "open repository settings" },
              { long: "wiki", short: "w", desc: "open repository wiki" },
          ],
          args: [ { kind: "path" } ] },

        { name: "codespace", aliases: ["cs"],
          desc: "connect to and manage codespaces",
          subcommands: [
            { name: "code", desc: "open a codespace in Visual Studio Code",
              flags: [
                  { long: "codespace", short: "c", desc: "name of the codespace", arg: { kind: "none" } },
                  { long: "web", short: "w", desc: "open in the web browser" },
              ] },
            { name: "cp",
              desc: "copy files between local and remote file systems",
              flags: [
                  { long: "codespace", short: "c", desc: "name of the codespace", arg: { kind: "none" } },
                  { long: "recursive", short: "r", desc: "recursively copy directories" },
              ],
              args: [ { kind: "path", repeat: true } ] },
            { name: "create", desc: "create a codespace",
              flags: [
                  { long: "branch", short: "b", desc: "repository branch", arg: { kind: "none" } },
                  { long: "machine", short: "m", desc: "hardware specifications for the VM", arg: { kind: "none" } },
                  { long: "web", short: "w", desc: "open in the web browser" },
              ] },
            { name: "delete", desc: "delete codespaces",
              flags: [
                  { long: "all", desc: "delete all codespaces" },
                  { long: "codespace", short: "c", desc: "name of the codespace", arg: { kind: "none" } },
                  { long: "force", short: "f", desc: "skip confirmation for codespaces with unsaved changes" },
              ] },
            { name: "edit", desc: "edit a codespace",
              flags: [
                  { long: "codespace", short: "c", desc: "name of the codespace", arg: { kind: "none" } },
                  { long: "machine", short: "m", desc: "set hardware specifications for the VM", arg: { kind: "none" } },
              ] },
            { name: "jupyter", desc: "open a codespace in JupyterLab",
              flags: [
                  { long: "codespace", short: "c", desc: "name of the codespace", arg: { kind: "none" } },
              ] },
            { name: "list", aliases: ["ls"], desc: "list codespaces",
              flags: [
                  { long: "json", desc: "output JSON with the specified fields", arg: { kind: "none" } },
                  { long: "limit", short: "L", desc: "maximum number of items to fetch", arg: { kind: "none" } },
                  { long: "web", short: "w", desc: "open in the web browser" },
              ] },
            { name: "logs", desc: "access codespace logs",
              flags: [
                  { long: "codespace", short: "c", desc: "name of the codespace", arg: { kind: "none" } },
                  { long: "follow", short: "f", desc: "tail and follow the logs" },
              ] },
            { name: "ports", desc: "list ports in a codespace",
              flags: [
                  { long: "codespace", short: "c", desc: "name of the codespace", arg: { kind: "none" } },
              ],
              subcommands: [
                { name: "forward", desc: "forward ports",
                  args: [ { kind: "none" }, { kind: "none", repeat: true } ] },
                { name: "visibility",
                  desc: "change the visibility of the forwarded port",
                  args: [ { kind: "none", repeat: true } ] },
              ] },
            { name: "rebuild", desc: "rebuild a codespace",
              flags: [
                  { long: "codespace", short: "c", desc: "name of the codespace", arg: { kind: "none" } },
              ] },
            { name: "ssh", desc: "SSH into a codespace",
              flags: [
                  { long: "codespace", short: "c", desc: "name of the codespace", arg: { kind: "none" } },
              ],
              after_dashdash: { kind: "none", repeat: true } },
            { name: "stop", desc: "stop a running codespace",
              flags: [
                  { long: "codespace", short: "c", desc: "name of the codespace", arg: { kind: "none" } },
              ] },
            { name: "view", desc: "view details about a codespace",
              flags: [
                  { long: "codespace", short: "c", desc: "name of the codespace", arg: { kind: "none" } },
                  { long: "json", desc: "output JSON with the specified fields", arg: { kind: "none" } },
              ] },
          ] },

        { name: "discussion", desc: "work with GitHub Discussions (preview)",
          flags: [
              { long: "repo", short: "R", global: true, desc: "select another repository ([HOST/]OWNER/REPO)", arg: { kind: "none" } },
          ],
          subcommands: [
            { name: "create", desc: "create a new discussion (preview)",
              flags: [
                  { long: "body", short: "b", desc: "body for the discussion", arg: { kind: "none" } },
                  { long: "body-file", short: "F", desc: "read body text from file", arg: { kind: "none" } },
                  { long: "category", short: "c", desc: "category name or slug for the discussion", arg: { kind: "none" } },
                  { long: "repo", short: "R", desc: "select another repository ([HOST/]OWNER/REPO)", arg: { kind: "none" } },
                  { long: "title", short: "t", desc: "title for the discussion", arg: { kind: "none" } },
              ] },
            { name: "list", aliases: ["ls"],
              desc: "list discussions in a repository (preview)",
              flags: [
                  { long: "json", desc: "output JSON with the specified fields", arg: { kind: "none" } },
                  { long: "limit", short: "L", desc: "maximum number of items to fetch", arg: { kind: "none" } },
                  { long: "repo", short: "R", desc: "select another repository ([HOST/]OWNER/REPO)", arg: { kind: "none" } },
                  { long: "search", short: "S", desc: "search discussions with query", arg: { kind: "none" } },
                  { long: "state", short: "s", desc: "filter by state", arg: { kind: "values", values: ["open", "closed", "all"] } },
                  { long: "web", short: "w", desc: "open in the web browser" },
              ] },
            { name: "comment",
              desc: "add, edit, or delete a discussion comment (preview)",
              flags: [
                  { long: "body", short: "b", desc: "comment body text", arg: { kind: "none" } },
                  { long: "body-file", short: "F", desc: "read body text from file", arg: { kind: "none" } },
                  { long: "repo", short: "R", desc: "select another repository ([HOST/]OWNER/REPO)", arg: { kind: "none" } },
              ],
              args: [ { kind: "none" } ] },
            { name: "edit", desc: "edit a discussion (preview)",
              flags: [
                  { long: "body", short: "b", desc: "new body for the discussion", arg: { kind: "none" } },
                  { long: "body-file", short: "F", desc: "read body text from file", arg: { kind: "none" } },
                  { long: "category", short: "c", desc: "new category name or slug for the discussion", arg: { kind: "none" } },
                  { long: "repo", short: "R", desc: "select another repository ([HOST/]OWNER/REPO)", arg: { kind: "none" } },
                  { long: "title", short: "t", desc: "new title for the discussion", arg: { kind: "none" } },
              ],
              args: [ { kind: "none" } ] },
            { name: "view", desc: "view a discussion (preview)",
              flags: [
                  { long: "comments", short: "c", desc: "view discussion comments" },
                  { long: "json", desc: "output JSON with the specified fields", arg: { kind: "none" } },
                  { long: "repo", short: "R", desc: "select another repository ([HOST/]OWNER/REPO)", arg: { kind: "none" } },
                  { long: "web", short: "w", desc: "open in the web browser" },
              ],
              args: [ { kind: "none" } ] },
          ] },

        { name: "gist", desc: "manage gists",
          subcommands: [
            { name: "clone", desc: "clone a gist locally",
              args: [ { kind: "none" }, { kind: "dir" } ],
              after_dashdash: { kind: "none", repeat: true } },
            { name: "create", aliases: ["new"], desc: "create a new gist",
              flags: [
                  { long: "desc", short: "d", desc: "a description for this gist", arg: { kind: "none" } },
                  { long: "public", short: "p", desc: "list the gist publicly" },
                  { long: "web", short: "w", desc: "open in the web browser" },
              ],
              args: [ { kind: "path", repeat: true } ] },
            { name: "delete", desc: "delete a gist",
              flags: [
                  { long: "yes", desc: "skip the confirmation prompt" },
              ],
              args: [ { kind: "none" } ] },
            { name: "edit", desc: "edit one of your gists",
              flags: [
                  { long: "add", short: "a", desc: "add a new file to the gist", arg: { kind: "none" } },
                  { long: "desc", short: "d", desc: "new description for the gist", arg: { kind: "none" } },
                  { long: "filename", short: "f", desc: "select a file to edit", arg: { kind: "none" } },
                  { long: "remove", short: "r", desc: "remove a file from the gist", arg: { kind: "none" } },
              ],
              args: [ { kind: "none" }, { kind: "none" } ] },
            { name: "list", aliases: ["ls"], desc: "list your gists",
              flags: [
                  { long: "limit", short: "L", desc: "maximum number of items to fetch", arg: { kind: "none" } },
                  { long: "public", desc: "show only public gists" },
                  { long: "secret", desc: "show only secret gists" },
              ] },
            { name: "rename", desc: "rename a file in a gist",
              args: [ { kind: "none" }, { kind: "none" }, { kind: "none" } ] },
            { name: "view", desc: "view a gist",
              flags: [
                  { long: "filename", short: "f", desc: "display a single file from the gist", arg: { kind: "none" } },
                  { long: "raw", short: "r", desc: "print raw instead of rendered gist contents" },
                  { long: "web", short: "w", desc: "open in the web browser" },
              ],
              args: [ { kind: "none" } ] },
          ] },

        { name: "issue", desc: "manage issues",
          flags: [
              { long: "repo", short: "R", global: true, desc: "select another repository ([HOST/]OWNER/REPO)", arg: { kind: "none" } },
          ],
          subcommands: [
            { name: "create", aliases: ["new"], desc: "create a new issue",
              flags: [
                  { long: "assignee", short: "a", desc: "assign people by their login", arg: { kind: "none" } },
                  { long: "body", short: "b", desc: "supply a body", arg: { kind: "none" } },
                  { long: "body-file", short: "F", desc: "read body text from file", arg: { kind: "path" } },
                  { long: "editor", short: "e", desc: "skip prompts and write title and body in the editor" },
                  { long: "label", short: "l", desc: "add labels by name", arg: { kind: "none" } },
                  { long: "title", short: "t", desc: "supply a title", arg: { kind: "none" } },
                  { long: "web", short: "w", desc: "open in the web browser" },
              ] },
            { name: "list", aliases: ["ls"], desc: "list issues in a repository",
              flags: [
                  { long: "assignee", short: "a", desc: "filter by assignee", arg: { kind: "none" } },
                  { long: "author", short: "A", desc: "filter by author (use --app to filter by a GitHub App)", arg: { kind: "none" } },
                  { long: "json", desc: "output JSON with the specified fields", arg: { kind: "none" } },
                  { long: "label", short: "l", desc: "filter by label", arg: { kind: "none" } },
                  { long: "limit", short: "L", desc: "maximum number of items to fetch", arg: { kind: "none" } },
                  { long: "search", short: "S", desc: "search issues with query", arg: { kind: "none" } },
                  { long: "state", short: "s", desc: "filter by state", arg: { kind: "values", values: ["open", "closed", "all"] } },
                  { long: "web", short: "w", desc: "open in the web browser" },
              ] },
            { name: "status", desc: "show status of relevant issues",
              flags: [
                  { long: "json", desc: "output JSON with the specified fields", arg: { kind: "none" } },
              ] },
            { name: "close", desc: "close issue",
              flags: [
                  { long: "comment", short: "c", desc: "leave a closing comment", arg: { kind: "none" } },
                  { long: "reason", short: "r", desc: "reason for closing: completed, not planned, duplicate", arg: { kind: "none" } },
              ],
              args: [ { kind: "none" } ] },
            { name: "comment", desc: "add a comment to an issue",
              flags: [
                  { long: "body", short: "b", desc: "the comment body text", arg: { kind: "none" } },
                  { long: "body-file", short: "F", desc: "read body text from file", arg: { kind: "path" } },
                  { long: "editor", short: "e", desc: "skip prompts and open the text editor to write the body in" },
                  { long: "web", short: "w", desc: "open in the web browser" },
                  { long: "yes", desc: "skip the --delete-last confirmation prompt" },
              ],
              args: [ { kind: "none" } ] },
            { name: "delete", desc: "delete issue",
              flags: [
                  { long: "yes", desc: "skip the confirmation prompt" },
              ],
              args: [ { kind: "none" } ] },
            { name: "develop", desc: "manage linked branches for an issue",
              flags: [
                  { long: "base", short: "b", desc: "the remote branch to make your new branch from", arg: { kind: "none" } },
                  { long: "checkout", short: "c", desc: "checkout the branch after creating it" },
                  { long: "list", short: "l", desc: "list linked branches for the issue" },
                  { long: "name", short: "n", desc: "name of the branch to create", arg: { kind: "none" } },
              ],
              args: [ { kind: "none" } ] },
            { name: "edit", desc: "edit issues",
              flags: [
                  { long: "add-assignee", desc: "add assigned users by their login", arg: { kind: "none" } },
                  { long: "add-label", desc: "add labels by name", arg: { kind: "none" } },
                  { long: "body", short: "b", desc: "set the new body", arg: { kind: "none" } },
                  { long: "body-file", short: "F", desc: "read body text from file", arg: { kind: "path" } },
                  { long: "remove-assignee", desc: "remove assigned users by their login", arg: { kind: "none" } },
                  { long: "remove-label", desc: "remove labels by name", arg: { kind: "none" } },
                  { long: "title", short: "t", desc: "set the new title", arg: { kind: "none" } },
              ],
              args: [ { kind: "none", repeat: true } ] },
            { name: "lock", desc: "lock issue conversation",
              flags: [
                  { long: "reason", short: "r", desc: "optional reason for locking conversation", arg: { kind: "values", values: ["off_topic", "resolved", "spam", "too_heated"] } },
              ],
              args: [ { kind: "none" } ] },
            { name: "pin", desc: "pin an issue",
              args: [ { kind: "none" } ] },
            { name: "reopen", desc: "reopen issue",
              flags: [
                  { long: "comment", short: "c", desc: "add a reopening comment", arg: { kind: "none" } },
              ],
              args: [ { kind: "none" } ] },
            { name: "transfer", desc: "transfer issue to another repository",
              args: [ { kind: "none" }, { kind: "none" } ] },
            { name: "unlock", desc: "unlock issue conversation",
              args: [ { kind: "none" } ] },
            { name: "unpin", desc: "unpin an issue",
              args: [ { kind: "none" } ] },
            { name: "view", desc: "view an issue",
              flags: [
                  { long: "comments", short: "c", desc: "view issue comments" },
                  { long: "json", desc: "output JSON with the specified fields", arg: { kind: "none" } },
                  { long: "web", short: "w", desc: "open in the web browser" },
              ],
              args: [ { kind: "none" } ] },
          ] },

        { name: "org", desc: "manage organizations",
          subcommands: [
            { name: "list", aliases: ["ls"],
              desc: "list organizations for the authenticated user",
              flags: [
                  { long: "limit", short: "L", desc: "maximum number of items to fetch", arg: { kind: "none" } },
              ] },
          ] },

        { name: "pr", desc: "manage pull requests",
          flags: [
              { long: "repo", short: "R", global: true, desc: "select another repository ([HOST/]OWNER/REPO)", arg: { kind: "none" } },
          ],
          subcommands: [
            { name: "create", aliases: ["new"], desc: "create a pull request",
              flags: [
                  { long: "assignee", short: "a", desc: "assign people by their login", arg: { kind: "none" } },
                  { long: "base", short: "B", desc: "the branch into which you want your code merged", arg: { kind: "none" } },
                  { long: "body", short: "b", desc: "body for the pull request", arg: { kind: "none" } },
                  { long: "body-file", short: "F", desc: "read body text from file", arg: { kind: "path" } },
                  { long: "draft", short: "d", desc: "mark pull request as a draft" },
                  { long: "dry-run", desc: "print details instead of creating the PR" },
                  { long: "editor", short: "e", desc: "skip prompts and write title and body in the editor" },
                  { long: "fill", short: "f", desc: "use commit info for title and body" },
                  { long: "fill-first", desc: "use first commit info for title and body" },
                  { long: "head", short: "H", desc: "the branch that contains commits for your pull request", arg: { kind: "none" } },
                  { long: "label", short: "l", desc: "add labels by name", arg: { kind: "none" } },
                  { long: "reviewer", short: "r", desc: "request reviews from people or teams by their handle", arg: { kind: "none" } },
                  { long: "title", short: "t", desc: "title for the pull request", arg: { kind: "none" } },
                  { long: "web", short: "w", desc: "open in the web browser" },
              ] },
            { name: "list", aliases: ["ls"],
              desc: "list pull requests in a repository",
              flags: [
                  { long: "assignee", short: "a", desc: "filter by assignee", arg: { kind: "none" } },
                  { long: "author", short: "A", desc: "filter by author (use --app to filter by a GitHub App)", arg: { kind: "none" } },
                  { long: "base", short: "B", desc: "filter by base branch", arg: { kind: "none" } },
                  { long: "draft", short: "d", desc: "filter by draft state" },
                  { long: "head", short: "H", desc: "filter by head branch", arg: { kind: "none" } },
                  { long: "json", desc: "output JSON with the specified fields", arg: { kind: "none" } },
                  { long: "label", short: "l", desc: "filter by label", arg: { kind: "none" } },
                  { long: "limit", short: "L", desc: "maximum number of items to fetch", arg: { kind: "none" } },
                  { long: "search", short: "S", desc: "search pull requests with query", arg: { kind: "none" } },
                  { long: "state", short: "s", desc: "filter by state", arg: { kind: "values", values: ["open", "closed", "merged", "all"] } },
                  { long: "web", short: "w", desc: "open in the web browser" },
              ] },
            { name: "status", desc: "show status of relevant pull requests",
              flags: [
                  { long: "json", desc: "output JSON with the specified fields", arg: { kind: "none" } },
              ] },
            { name: "checkout", aliases: ["co"],
              desc: "check out a pull request in git",
              flags: [
                  { long: "branch", short: "b", desc: "local branch name to use", arg: { kind: "none" } },
                  { long: "detach", desc: "checkout PR with a detached HEAD" },
                  { long: "force", short: "f", desc: "reset the local branch to the pull request's state" },
              ],
              args: [ { kind: "none" } ] },
            { name: "checks", desc: "show CI status for a single pull request",
              flags: [
                  { long: "json", desc: "output JSON with the specified fields", arg: { kind: "none" } },
                  { long: "required", desc: "only show checks that are required" },
                  { long: "watch", desc: "watch checks until they finish" },
                  { long: "web", short: "w", desc: "open in the web browser" },
              ],
              args: [ { kind: "none" } ] },
            { name: "close", desc: "close a pull request",
              flags: [
                  { long: "comment", short: "c", desc: "leave a closing comment", arg: { kind: "none" } },
                  { long: "delete-branch", short: "d", desc: "delete the local and remote branch after close" },
              ],
              args: [ { kind: "none" } ] },
            { name: "comment", desc: "add a comment to a pull request",
              flags: [
                  { long: "body", short: "b", desc: "the comment body text", arg: { kind: "none" } },
                  { long: "body-file", short: "F", desc: "read body text from file", arg: { kind: "path" } },
                  { long: "editor", short: "e", desc: "skip prompts and open the text editor to write the body in" },
                  { long: "web", short: "w", desc: "open in the web browser" },
                  { long: "yes", desc: "skip the --delete-last confirmation prompt" },
              ],
              args: [ { kind: "none" } ] },
            { name: "diff", desc: "view changes in a pull request",
              flags: [
                  { long: "name-only", desc: "display only names of changed files" },
                  { long: "web", short: "w", desc: "open in the web browser" },
              ],
              args: [ { kind: "none" } ] },
            { name: "edit", desc: "edit a pull request",
              flags: [
                  { long: "add-assignee", desc: "add assigned users by their login", arg: { kind: "none" } },
                  { long: "add-label", desc: "add labels by name", arg: { kind: "none" } },
