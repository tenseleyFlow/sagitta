        { name: "release", desc: "manage releases",
          flags: [
              { long: "repo", short: "R", global: true, desc: "select another repository ([HOST/]OWNER/REPO)", arg: { kind: "none" } },
          ],
          subcommands: [
            { name: "create", aliases: ["new"], desc: "create a new release",
              flags: [
                  { long: "draft", short: "d", desc: "save the release as a draft instead of publishing it" },
                  { long: "generate-notes", desc: "generate title and notes via the Release Notes API" },
                  { long: "notes", short: "n", desc: "release notes", arg: { kind: "none" } },
                  { long: "notes-file", short: "F", desc: "read release notes from file", arg: { kind: "path" } },
                  { long: "prerelease", short: "p", desc: "mark the release as a prerelease" },
                  { long: "target", desc: "target branch or full commit SHA", arg: { kind: "none" } },
                  { long: "title", short: "t", desc: "release title", arg: { kind: "none" } },
              ],
              args: [ { kind: "none" }, { kind: "path", repeat: true } ] },
            { name: "list", aliases: ["ls"],
              desc: "list releases in a repository",
              flags: [
                  { long: "json", desc: "output JSON with the specified fields", arg: { kind: "none" } },
                  { long: "limit", short: "L", desc: "maximum number of items to fetch", arg: { kind: "none" } },
                  { long: "order", short: "O", desc: "order of releases returned", arg: { kind: "values", values: ["asc", "desc"] } },
              ] },
            { name: "delete", desc: "delete a release",
              flags: [
                  { long: "yes", short: "y", desc: "skip the confirmation prompt" },
              ],
              args: [ { kind: "none" } ] },
            { name: "delete-asset", desc: "delete an asset from a release",
              flags: [
                  { long: "yes", short: "y", desc: "skip the confirmation prompt" },
              ],
              args: [ { kind: "none" }, { kind: "none" } ] },
            { name: "download", desc: "download release assets",
              flags: [
                  { long: "archive", short: "A", desc: "download the source code archive (zip or tar.gz)", arg: { kind: "values", values: ["zip", "tar.gz"] } },
                  { long: "dir", short: "D", desc: "the directory to download files into", arg: { kind: "dir" } },
                  { long: "output", short: "O", desc: "the file to write a single asset to", arg: { kind: "path" } },
                  { long: "pattern", short: "p", desc: "download only assets that match a glob pattern", arg: { kind: "none" } },
              ],
              args: [ { kind: "none" } ] },
            { name: "edit", desc: "edit a release",
              flags: [
                  { long: "draft", desc: "save the release as a draft instead of publishing it" },
                  { long: "notes", short: "n", desc: "release notes", arg: { kind: "none" } },
                  { long: "notes-file", short: "F", desc: "read release notes from file", arg: { kind: "path" } },
                  { long: "prerelease", desc: "mark the release as a prerelease" },
                  { long: "tag", desc: "the name of the tag", arg: { kind: "none" } },
                  { long: "title", short: "t", desc: "release title", arg: { kind: "none" } },
              ],
              args: [ { kind: "none" } ] },
            { name: "upload", desc: "upload assets to a release",
              flags: [
                  { long: "clobber", desc: "delete and re-upload existing assets of the same name" },
              ],
              args: [ { kind: "none" }, { kind: "path", repeat: true } ] },
            { name: "verify", desc: "verify the attestation for a release",
              args: [ { kind: "none" } ] },
            { name: "verify-asset",
              desc: "verify that a given asset originated from a release",
