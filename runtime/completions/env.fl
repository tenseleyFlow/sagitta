# env (macOS / FreeBSD env, Darwin 25.4) -- from `env`'s usage and env(1).
{
    completion: 1,
    command: "env",
    description: "set environment and execute command",

    precommand: {
        flags_with_args: ["-C", "-P", "-S", "-u"],
        assignments: true,
    },

    flags: [
        { short: "0", desc: "end each output line with NUL" },
        { short: "i", desc: "start from an empty environment" },
        { short: "v", desc: "verbose" },
        { short: "C", desc: "change to this directory first",
          arg: { kind: "dir" } },
        { short: "P", desc: "search this path for the utility",
          arg: { kind: "none" } },
        { short: "S", desc: "split this string into arguments",
          arg: { kind: "none" } },
        { short: "u", desc: "remove this variable", arg: { kind: "var" } },
    ],
}
