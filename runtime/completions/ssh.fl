# OpenSSH_10.2p1 (LibreSSL 3.3.6) -- from `ssh`'s usage and ssh(1).
#
# runtime/completions/ssh.fl: the destination completes from the hosts
# in ~/.ssh/config and ~/.ssh/known_hosts; words after it are the remote
# command, which is not a local one, so nothing is offered there.
{
    completion: 1,
    command: "ssh",
    description: "OpenSSH remote login client",

    flags: [
        { short: "4", desc: "use IPv4 addresses only" },
        { short: "6", desc: "use IPv6 addresses only" },
        { short: "A", desc: "forward the authentication agent" },
        { short: "a", desc: "do not forward the authentication agent" },
        { short: "B", desc: "bind to this interface", arg: { kind: "none" } },
        { short: "b", desc: "bind to this local address", arg: { kind: "none" } },
        { short: "C", desc: "compress all data" },
        { short: "c", desc: "cipher specification", arg: { kind: "none" } },
        { short: "D", desc: "dynamic (SOCKS) port forwarding",
          arg: { kind: "none" } },
        { short: "E", desc: "append debug logs to this file",
          arg: { kind: "path" } },
        { short: "e", desc: "escape character", arg: { kind: "none" } },
        { short: "F", desc: "per-user configuration file",
          arg: { kind: "path" } },
        { short: "f", desc: "go to background before the command" },
        { short: "G", desc: "print the configuration and exit" },
        { short: "g", desc: "let remote hosts use local forwarded ports" },
        { short: "I", desc: "PKCS#11 shared library", arg: { kind: "path" } },
        { short: "i", desc: "identity (private key) file",
          arg: { kind: "path" } },
        { short: "J", desc: "connect through this jump host",
          arg: { kind: "host" } },
        { short: "K", desc: "GSSAPI authentication and forwarding" },
        { short: "k", desc: "do not forward GSSAPI credentials" },
        { short: "L", desc: "local port forwarding", arg: { kind: "none" } },
        { short: "l", desc: "log in as this remote user", arg: { kind: "none" } },
        { short: "M", desc: "master mode for connection sharing" },
        { short: "m", desc: "MAC specification", arg: { kind: "none" } },
        { short: "N", desc: "do not execute a remote command" },
        { short: "n", desc: "read stdin from /dev/null" },
        { short: "O", desc: "control an active master process",
          arg: { kind: "values", values: ["check", "forward", "cancel",
                                          "proxy", "exit", "stop"] } },
        { short: "o", desc: "an option in ssh_config format",
          arg: { kind: "none" } },
        { short: "P", desc: "tag for selecting configuration",
          arg: { kind: "none" } },
        { short: "p", desc: "remote port", arg: { kind: "none" } },
        { short: "Q", desc: "list supported algorithms",
          arg: { kind: "none" } },
        { short: "q", desc: "quiet mode" },
        { short: "R", desc: "remote port forwarding", arg: { kind: "none" } },
        { short: "S", desc: "control socket for connection sharing",
          arg: { kind: "path" } },
        { short: "s", desc: "request a remote subsystem" },
        { short: "T", desc: "disable pseudo-terminal allocation" },
        { short: "t", desc: "force pseudo-terminal allocation" },
        { short: "V", desc: "print the version and exit" },
        { short: "v", desc: "verbose mode" },
        { short: "W", desc: "forward stdio to host:port", arg: { kind: "none" } },
        { short: "w", desc: "tunnel device forwarding", arg: { kind: "none" } },
        { short: "X", desc: "enable X11 forwarding" },
        { short: "x", desc: "disable X11 forwarding" },
        { short: "Y", desc: "enable trusted X11 forwarding" },
        { short: "y", desc: "log through syslog" },
    ],

    args: [
        { kind: "host" },
        { kind: "none", repeat: true },
    ],
}
