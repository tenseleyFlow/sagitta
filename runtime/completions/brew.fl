# Homebrew 7.0.4-30-g14c54f7 -- from `brew commands` and `brew <command> --help` (services subcommands from `man brew`).
#
# runtime/completions/brew.fl: completion spec for Homebrew.
# Every command and flag here is one the installed brew prints in its own
# help; each command carries its most common flags, not every one.
# Aliases are the ones each command's `Usage:` line names.
#
# Formula and cask names to install are not offered: there is no cheap,
# offline list of them. Installed ones come from `brew list -1`, which
# reads the Cellar and Caskroom and never touches the network.
# The dash-spelled commands (`--prefix`, `--cellar`, ...) are root flags,
# since a word starting with `-` completes as a flag.
{
    completion: 1,
    command: "brew",
    description: "the Homebrew package manager",

    generators: {
        installed: { argv: ["brew", "list", "-1"], cache_ms: 60000 },
        taps: { argv: ["brew", "tap"], cache_ms: 60000 },
    },

    flags: [
        { long: "help", short: "h", global: true, desc: "show this message" },
        { long: "version", desc: "print the Homebrew version" },
        { long: "prefix", desc: "Homebrew's install path, or a formula's" },
        { long: "cellar", desc: "Homebrew's Cellar path, or a formula's" },
        { long: "caskroom", desc: "Homebrew's Caskroom path, or a cask's" },
        { long: "cache", desc: "Homebrew's download cache, or a package's" },
        { long: "repository", desc: "Homebrew's Git repository, or a tap's" },
        { long: "repo", desc: "Homebrew's Git repository, or a tap's" },
        { long: "taps", desc: "the path to Homebrew's Taps directory" },
        { long: "env", desc: "summarise Homebrew's build environment" },
    ],

    subcommands: [
        { name: "install", desc: "install a formula or cask",
          flags: [
              { long: "debug", short: "d", desc: "debug session if brewing fails" },
              { long: "force", short: "f", desc: "install without keg-only/migration checks" },
              { long: "verbose", short: "v", desc: "print verification and post-install steps" },
              { long: "dry-run", short: "n", desc: "show what would be installed" },
              { long: "yes", short: "y", desc: "do not ask for confirmation" },
              { long: "no-ask", desc: "do not ask for confirmation" },
              { long: "formula", desc: "treat all named arguments as formulae" },
              { long: "cask", desc: "treat all named arguments as casks" },
              { long: "ignore-dependencies", desc: "skip installing any dependencies" },
              { long: "only-dependencies", desc: "install only the dependencies" },
              { long: "cc", desc: "compile using this compiler",
                arg: { kind: "none" } },
              { long: "build-from-source", short: "s",
                desc: "compile from source even if a bottle exists" },
              { long: "force-bottle", desc: "install from a bottle if one exists" },
              { long: "include-test", desc: "install testing dependencies" },
              { long: "HEAD", desc: "install the HEAD version" },
              { long: "fetch-HEAD", desc: "fetch upstream to check HEAD is outdated" },
              { long: "keep-tmp", desc: "retain the temporary build files" },
              { long: "debug-symbols", desc: "generate debug symbols on build" },
              { long: "build-bottle", desc: "prepare the formula for bottling" },
              { long: "skip-post-install", desc: "skip any post-install steps" },
              { long: "skip-link", desc: "skip linking the keg into the prefix" },
              { long: "as-dependency", desc: "mark as installed as a dependency" },
              { long: "interactive", short: "i", desc: "download and patch, then open a shell" },
              { long: "git", short: "g", desc: "create a Git repository for patches" },
              { long: "overwrite", desc: "delete files already in the prefix" },
              { long: "require-sha", desc: "require all casks to have a checksum" },
              { long: "adopt", desc: "adopt identical existing artifacts" },
              { long: "skip-cask-deps", desc: "skip installing cask dependencies" },
              { long: "zap", desc: "remove all files associated with a cask" },
              { long: "appdir", desc: "target location for Applications",
                arg: { kind: "dir" } },
              { long: "fontdir", desc: "target location for Fonts",
                arg: { kind: "dir" } },
              { long: "language", desc: "comma-separated language codes to prefer",
                arg: { kind: "none" } },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
          ],
          args: [ { kind: "none", repeat: true } ] },

        { name: "uninstall", aliases: ["remove", "rm"],
          desc: "uninstall a formula or cask",
          flags: [
              { long: "force", short: "f", desc: "delete all installed versions" },
              { long: "zap", desc: "remove all files associated with a cask" },
              { long: "ignore-dependencies",
                desc: "uninstall even if it is a dependency" },
              { long: "formula", desc: "treat all named arguments as formulae" },
              { long: "cask", desc: "treat all named arguments as casks" },
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
              { long: "verbose", short: "v", desc: "make some output more verbose" },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "reinstall", desc: "uninstall and reinstall a formula or cask",
          flags: [
              { long: "debug", short: "d", desc: "debug session if brewing fails" },
              { long: "force", short: "f", desc: "install without keg-only/migration checks" },
              { long: "verbose", short: "v", desc: "print verification and post-install steps" },
              { long: "yes", short: "y", desc: "do not ask for confirmation" },
              { long: "no-ask", desc: "do not ask for confirmation" },
              { long: "formula", desc: "treat all named arguments as formulae" },
              { long: "cask", desc: "treat all named arguments as casks" },
              { long: "build-from-source", short: "s",
                desc: "compile from source even if a bottle exists" },
              { long: "interactive", short: "i", desc: "download and patch, then open a shell" },
              { long: "force-bottle", desc: "install from a bottle if one exists" },
              { long: "keep-tmp", desc: "retain the temporary build files" },
              { long: "git", short: "g", desc: "create a Git repository for patches" },
              { long: "adopt", desc: "adopt identical existing artifacts" },
              { long: "skip-cask-deps", desc: "skip installing cask dependencies" },
              { long: "zap", desc: "remove all files associated with a cask" },
              { long: "appdir", desc: "target location for Applications",
                arg: { kind: "dir" } },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "upgrade", desc: "upgrade outdated, unpinned packages",
          flags: [
              { long: "debug", short: "d", desc: "debug session if brewing fails" },
              { long: "force", short: "f", desc: "install without keg-only/migration checks" },
              { long: "verbose", short: "v", desc: "print verification and post-install steps" },
              { long: "dry-run", short: "n", desc: "show what would be upgraded" },
              { long: "yes", short: "y", desc: "do not ask for confirmation" },
              { long: "no-ask", desc: "do not ask for confirmation" },
              { long: "formula", desc: "only formulae" },
              { long: "cask", desc: "only casks" },
              { long: "build-from-source", short: "s",
                desc: "compile from source even if a bottle exists" },
              { long: "interactive", short: "i", desc: "download and patch, then open a shell" },
              { long: "force-bottle", desc: "install from a bottle if one exists" },
              { long: "fetch-HEAD", desc: "fetch upstream to check HEAD is outdated" },
              { long: "keep-tmp", desc: "retain the temporary build files" },
              { long: "overwrite", desc: "delete files already in the prefix" },
              { long: "skip-cask-deps", desc: "skip installing cask dependencies" },
              { long: "no-quit", desc: "do not quit running cask applications" },
              { long: "greedy", short: "g",
                desc: "include :latest and auto_updates casks" },
              { long: "greedy-latest", desc: "include casks with version :latest" },
              { long: "greedy-auto-updates", desc: "include auto_updates casks" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "update", aliases: ["up"],
          desc: "fetch the newest Homebrew and all formulae",
          flags: [
              { long: "auto-update", desc: "run as an auto-update; skip slow steps" },
              { long: "force", short: "f", desc: "always do a slower, full update check" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
              { long: "verbose", short: "v", desc: "print directories and git operations" },
              { long: "debug", short: "d", desc: "trace all shell commands" },
          ] },

        { name: "search", desc: "search cask tokens and formula names",
          flags: [
              { long: "formula", desc: "search for formulae" },
              { long: "cask", desc: "search for casks" },
              { long: "desc", desc: "search descriptions too" },
              { long: "pull-request", desc: "search GitHub pull requests" },
              { long: "open", desc: "only open GitHub pull requests" },
              { long: "closed", desc: "only closed GitHub pull requests" },
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
              { long: "verbose", short: "v", desc: "make some output more verbose" },
          ],
          args: [ { kind: "none", repeat: true } ] },

        { name: "info", aliases: ["abv"],
          desc: "statistics for the installation, or a package",
          flags: [
              { long: "analytics", desc: "global or per-formula analytics data" },
              { long: "days", desc: "days of analytics data to retrieve",
                arg: { kind: "values", values: ["30", "90", "365"] } },
              { long: "category", desc: "which analytics data to retrieve",
                arg: { kind: "values", values: [
                    "install", "install-on-request", "build-error",
                    "cask-install", "os-version",
                ] } },
              { long: "github", desc: "open the GitHub source page" },
              { long: "json", desc: "print a JSON representation",
                arg: { kind: "values", values: ["v1", "v2"] },
                arg_optional: true },
              { long: "installed", desc: "inventory of installed formulae and casks" },
              { long: "variations", desc: "include the variations hash in JSON" },
              { long: "verbose", short: "v", desc: "show more verbose data" },
              { long: "formula", desc: "treat all named arguments as formulae" },
              { long: "cask", desc: "treat all named arguments as casks" },
              { long: "sizes", desc: "show the size of installed packages" },
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "list", aliases: ["ls"], desc: "list installed formulae and casks",
          flags: [
              { long: "formula", desc: "list only formulae" },
              { long: "cask", desc: "list only casks" },
              { long: "full-name", desc: "print fully-qualified formula names" },
              { long: "versions", desc: "show the installed version numbers" },
              { long: "json", desc: "output as JSON (needs --versions)" },
              { long: "multiple", desc: "only formulae with multiple versions" },
              { long: "pinned", desc: "list only pinned packages" },
              { long: "installed-on-request", desc: "formulae installed on request" },
              { long: "no-installed-on-request",
                desc: "formulae installed as dependencies" },
              { long: "poured-from-bottle", desc: "formulae installed from a bottle" },
              { long: "built-from-source", desc: "formulae compiled from source" },
              { short: "1", desc: "one entry per line" },
              { short: "l", desc: "long format" },
              { short: "r", desc: "reverse the sort order" },
              { short: "t", desc: "sort by time modified" },
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
              { long: "verbose", short: "v", desc: "make some output more verbose" },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "outdated", desc: "installed packages with a newer version",
          flags: [
              { long: "quiet", short: "q", desc: "list only the names of outdated kegs" },
              { long: "verbose", short: "v", desc: "include detailed version information" },
              { long: "formula", desc: "list only outdated formulae" },
              { long: "cask", desc: "list only outdated casks" },
              { long: "json", desc: "print output in JSON format",
                arg: { kind: "values", values: ["v1", "v2"] },
                arg_optional: true },
              { long: "fetch-HEAD", desc: "fetch upstream to check HEAD is outdated" },
              { long: "greedy", short: "g",
                desc: "include :latest and auto_updates casks" },
              { long: "greedy-latest", desc: "include casks with version :latest" },
              { long: "greedy-auto-updates", desc: "include auto_updates casks" },
              { long: "debug", short: "d", desc: "display any debugging information" },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "tap", desc: "tap a repository, or list the taps",
          flags: [
              { long: "custom-remote", desc: "install or change a tap's custom remote" },
              { long: "repair", desc: "add missing symlinks; fix remote refs" },
              { long: "force", short: "f", desc: "force install core taps under API mode" },
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
              { long: "verbose", short: "v", desc: "make some output more verbose" },
          ],
          # user/repo, then an optional URL.
          args: [ { kind: "none" }, { kind: "none" } ] },

        { name: "untap", desc: "remove a tapped formula repository",
          flags: [
              { long: "force", short: "f", desc: "uninstall the tap's packages first" },
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
              { long: "verbose", short: "v", desc: "make some output more verbose" },
          ],
          args: [ { kind: "generator", generator: "taps", repeat: true } ] },

        { name: "tap-info", desc: "detailed information about taps",
          flags: [
              { long: "installed", desc: "information on each installed tap" },
              { long: "json", desc: "print a JSON representation",
                arg: { kind: "values", values: ["v1"] }, arg_optional: true },
          ],
          args: [ { kind: "generator", generator: "taps", repeat: true } ] },

        { name: "services", desc: "manage background services",
          flags: [
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
              { long: "verbose", short: "v", desc: "make some output more verbose" },
              { long: "sudo-service-user", desc: "as root on macOS, run as this user",
                arg: { kind: "user" } },
          ],
          subcommands: [
              { name: "list", desc: "information about all managed services",
                flags: [
                    { long: "json", desc: "output as JSON" },
                    { long: "debug", desc: "more output from Homebrew and launchctl" },
                ] },
              { name: "run", desc: "run without registering at login (or boot)",
                flags: [
                    { long: "all", desc: "run all services" },
                    { long: "file", desc: "use the service file from this location",
                      arg: { kind: "path" } },
                ],
                args: [ { kind: "generator", generator: "installed" } ] },
              { name: "start", desc: "start now and register at login (or boot)",
                flags: [
                    { long: "all", desc: "start all services" },
                    { long: "file", desc: "use the service file from this location",
                      arg: { kind: "path" } },
                ],
                args: [ { kind: "generator", generator: "installed" } ] },
              { name: "stop", desc: "stop now and unregister from login (or boot)",
                flags: [
                    { long: "all", desc: "stop all services" },
                    { long: "keep", desc: "do not unregister from login (or boot)" },
                    { long: "no-wait", desc: "do not wait for stop to finish" },
                    { long: "max-wait", desc: "wait at most this many seconds",
                      arg: { kind: "none" } },
                ],
                args: [ { kind: "generator", generator: "installed" } ] },
              { name: "kill", desc: "stop now but keep it registered",
                flags: [
                    { long: "all", desc: "stop all services" },
                ],
                args: [ { kind: "generator", generator: "installed" } ] },
              { name: "restart", desc: "stop (if necessary) and start the service",
                flags: [
                    { long: "all", desc: "restart all services" },
                    { long: "file", desc: "use the service file from this location",
                      arg: { kind: "path" } },
                ],
                args: [ { kind: "generator", generator: "installed" } ] },
              { name: "cleanup", desc: "remove all unused services" },
              { name: "info", desc: "information about a managed service",
                flags: [
                    { long: "all", desc: "list all managed services" },
                    { long: "json", desc: "output as JSON" },
                ],
                args: [ { kind: "generator", generator: "installed" } ] },
          ] },

        { name: "cleanup", desc: "remove stale lock files and old downloads",
          flags: [
              { long: "prune", desc: "remove cache files older than N days",
                arg: { kind: "values", values: ["all"] } },
              { long: "dry-run", short: "n", desc: "show what would be removed" },
              { long: "scrub", short: "s", desc: "scrub the cache, even latest downloads" },
              { long: "prune-prefix", desc: "only prune symlinks and dirs in prefix" },
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
              { long: "verbose", short: "v", desc: "make some output more verbose" },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "doctor", aliases: ["dr"],
          desc: "check your system for potential problems",
          flags: [
              { long: "list-checks", desc: "list all audit methods" },
              { long: "audit-debug", short: "D", desc: "debug and profile audit methods" },
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
              { long: "verbose", short: "v", desc: "make some output more verbose" },
          ],
          args: [ { kind: "none", repeat: true } ] },

        { name: "config", desc: "Homebrew and system configuration info",
          flags: [
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
              { long: "verbose", short: "v", desc: "make some output more verbose" },
          ] },

        { name: "deps", desc: "show dependencies for a formula",
          flags: [
              { long: "topological", short: "n", desc: "sort in topological order" },
              { long: "direct", short: "1", desc: "only the direct declared dependencies" },
              { long: "union", desc: "union of dependencies, not intersection" },
              { long: "full-name", desc: "list dependencies by their full name" },
              { long: "include-build", desc: "include :build dependencies" },
              { long: "include-optional", desc: "include :optional dependencies" },
              { long: "include-test", desc: "include :test dependencies" },
              { long: "skip-recommended", desc: "skip :recommended dependencies" },
              { long: "tree", desc: "show dependencies as a tree" },
              { long: "graph", desc: "show dependencies as a directed graph" },
              { long: "annotate", desc: "mark build, test, optional deps as such" },
              { long: "installed", desc: "dependencies of installed formulae" },
              { long: "missing", desc: "show only missing dependencies" },
              { long: "formula", desc: "treat all named arguments as formulae" },
              { long: "cask", desc: "treat all named arguments as casks" },
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
              { long: "verbose", short: "v", desc: "make some output more verbose" },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "uses", desc: "show dependents of a formula",
          flags: [
              { long: "recursive", desc: "resolve more than one level" },
              { long: "installed", desc: "only installed formulae and casks" },
              { long: "missing", desc: "only formulae and casks not installed" },
              { long: "include-build", desc: "include :build dependents" },
              { long: "include-test", desc: "include :test dependents" },
              { long: "include-optional", desc: "include :optional dependents" },
              { long: "skip-recommended", desc: "skip :recommended dependents" },
              { long: "formula", desc: "include only formulae" },
              { long: "cask", desc: "include only casks" },
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
              { long: "verbose", short: "v", desc: "make some output more verbose" },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "home", aliases: ["homepage"],
          desc: "open a formula or cask's homepage",
          flags: [
              { long: "formula", desc: "treat all named arguments as formulae" },
              { long: "cask", desc: "treat all named arguments as casks" },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "link", aliases: ["ln"], desc: "symlink a keg into Homebrew's prefix",
          flags: [
              { long: "overwrite", desc: "delete files already in the prefix" },
              { long: "dry-run", short: "n", desc: "list what would be linked or deleted" },
              { long: "force", short: "f", desc: "allow keg-only formulae to be linked" },
              { long: "HEAD", desc: "link the installed HEAD version" },
              { long: "formula", desc: "treat all named arguments as formulae" },
              { long: "cask", desc: "treat all named arguments as casks" },
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
              { long: "verbose", short: "v", desc: "make some output more verbose" },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "unlink", desc: "remove a keg's symlinks from the prefix",
          flags: [
              { long: "dry-run", short: "n", desc: "list what would be unlinked" },
              { long: "formula", desc: "treat all named arguments as formulae" },
              { long: "cask", desc: "treat all named arguments as casks" },
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
              { long: "verbose", short: "v", desc: "make some output more verbose" },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "pin", desc: "prevent a package from being upgraded",
          flags: [
              { long: "formula", desc: "treat all named arguments as formulae" },
              { long: "cask", desc: "treat all named arguments as casks" },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "unpin", desc: "allow a pinned package to be upgraded",
          flags: [
              { long: "formula", desc: "treat all named arguments as formulae" },
              { long: "cask", desc: "treat all named arguments as casks" },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "autoremove", desc: "uninstall dependencies no longer needed",
          flags: [
              { long: "dry-run", short: "n", desc: "list what would be uninstalled" },
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
              { long: "verbose", short: "v", desc: "make some output more verbose" },
          ] },

        { name: "leaves", desc: "installed formulae nothing else depends on",
          flags: [
              { long: "installed-on-request", short: "r",
                desc: "only leaves that were manually installed" },
              { long: "installed-as-dependency", short: "p",
                desc: "only leaves installed as dependencies" },
          ] },

        { name: "edit", desc: "open a formula, cask or tap in the editor",
          flags: [
              { long: "formula", desc: "treat all named arguments as formulae" },
              { long: "cask", desc: "treat all named arguments as casks" },
              { long: "print-path", desc: "print the path instead of opening it" },
          ],
          args: [ { kind: "none", repeat: true } ] },

        { name: "cat", desc: "display the source of a formula or cask",
          flags: [
              { long: "formula", desc: "treat all named arguments as formulae" },
              { long: "cask", desc: "treat all named arguments as casks" },
          ],
          args: [ { kind: "none", repeat: true } ] },

        { name: "fetch", desc: "download a bottle or source packages",
          flags: [
              { long: "os", desc: "download for this operating system (or all)",
                arg: { kind: "none" } },
              { long: "arch", desc: "download for this CPU architecture (or all)",
                arg: { kind: "none" } },
              { long: "all-platforms", desc: "download for every supported platform" },
              { long: "bottle-tag", desc: "download a bottle for this tag",
                arg: { kind: "none" } },
              { long: "HEAD", desc: "fetch the HEAD version" },
              { long: "force", short: "f", desc: "remove the cached version and re-fetch" },
              { long: "verbose", short: "v", desc: "do a verbose VCS checkout" },
              { long: "retry", desc: "retry if downloading fails" },
              { long: "deps", desc: "also download dependencies" },
              { long: "build-from-source", short: "s",
                desc: "download source packages, not a bottle" },
              { long: "force-bottle", desc: "download a bottle if one exists" },
              { long: "formula", desc: "treat all named arguments as formulae" },
              { long: "cask", desc: "treat all named arguments as casks" },
              { long: "debug", short: "d", desc: "display any debugging information" },
              { long: "quiet", short: "q", desc: "make some output more quiet" },
          ],
          args: [ { kind: "none", repeat: true } ] },

        { name: "missing", desc: "check installed kegs for missing dependencies",
          flags: [
              { long: "hide", desc: "act as if these packages are not installed",
                arg: { kind: "none" } },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "desc", desc: "a formula's name and one-line description",
          flags: [
              { long: "search", short: "s", desc: "search names and descriptions" },
              { long: "name", short: "n", desc: "search just names" },
              { long: "description", short: "d", desc: "search just descriptions" },
              { long: "formula", desc: "treat all named arguments as formulae" },
              { long: "cask", desc: "treat all named arguments as casks" },
          ],
          args: [ { kind: "none", repeat: true } ] },

        { name: "options", desc: "install options specific to a formula",
          flags: [
              { long: "compact", desc: "all options on a single line" },
              { long: "installed", desc: "options for installed formulae" },
          ],
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "postinstall", aliases: ["post_install"],
          desc: "rerun the post-install steps for a formula",
          args: [ { kind: "generator", generator: "installed", repeat: true } ] },

        { name: "log", desc: "the git log for a formula or cask",
          flags: [
              { long: "patch", short: "p", desc: "also print the patch from each commit" },
              { long: "stat", desc: "also print a diffstat" },
              { long: "oneline", desc: "one line per commit" },
              { short: "1", desc: "print only one commit" },
              { long: "max-count", short: "n", desc: "print only this many commits",
                arg: { kind: "none" } },
              { long: "formula", desc: "treat all named arguments as formulae" },
              { long: "cask", desc: "treat all named arguments as casks" },
          ],
          args: [ { kind: "none" } ] },

        { name: "shellenv", desc: "print export statements for a shell",
          args: [ { kind: "values", values: [
              "bash", "csh", "fish", "pwsh", "sh", "tcsh", "zsh",
          ] } ] },

        { name: "analytics", desc: "control Homebrew's anonymous analytics",
          subcommands: [
              { name: "state", desc: "display the current analytics state" },
              { name: "on", desc: "turn analytics on" },
              { name: "off", desc: "turn analytics off" },
          ] },

        { name: "bundle", desc: "install and manage a Brewfile's dependencies",
          flags: [
              { long: "file", desc: "the Brewfile to read or write",
                arg: { kind: "path" } },
              { long: "global", short: "g", desc: "use the global Brewfile" },
          ],
          subcommands: [
              { name: "install", desc: "install and upgrade all Brewfile deps" },
              { name: "dump", desc: "write everything installed to a Brewfile" },
              { name: "cleanup", desc: "uninstall everything not in the Brewfile" },
              { name: "check", desc: "check all Brewfile deps are installed" },
              { name: "list", desc: "list all dependencies in the Brewfile" },
              { name: "add", desc: "add entries to your Brewfile",
                args: [ { kind: "none", repeat: true } ] },
              { name: "remove", desc: "remove matching entries from your Brewfile",
                args: [ { kind: "none", repeat: true } ] },
              { name: "edit", desc: "edit the Brewfile in your editor" },
              { name: "exec", desc: "run a command in the Brewfile environment",
                args: [ { kind: "command" } ] },
              { name: "sh", desc: "run your shell in the Brewfile environment" },
              { name: "env", desc: "print the Brewfile environment's variables" },
          ] },

        { name: "commands", desc: "list built-in and external commands",
          flags: [
              { long: "quiet", short: "q", desc: "only the names, no category headers" },
              { long: "include-aliases", desc: "include aliases of internal commands" },
          ] },

        { name: "help", desc: "help for Homebrew or one command",
          args: [ { kind: "none" } ] },
    ],
}
