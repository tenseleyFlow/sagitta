# GNU Make 3.81 -- from `make --help`.
#
# runtime/completions/make.fl: targets are read from the Makefile's TEXT
# (the make_targets generator); make itself is never run to list them,
# because evaluating a Makefile can run arbitrary `$(shell ...)`.
{
    completion: 1,
    command: ["make", "gmake"],
    description: "maintain program dependencies",

    flags: [
        { short: "B", long: "always-make", desc: "unconditionally make all targets" },
        { short: "C", long: "directory", desc: "change to DIRECTORY first",
          arg: { kind: "dir" }, changes_dir: true },
        { short: "d", desc: "print lots of debugging information" },
        { long: "debug", desc: "print debugging information",
          arg: { kind: "none" }, arg_optional: true },
        { short: "e", long: "environment-overrides",
          desc: "environment variables override makefiles" },
        { short: "f", long: "file", desc: "read FILE as a makefile",
          arg: { kind: "path" } },
        { long: "makefile", desc: "read FILE as a makefile",
          arg: { kind: "path" } },
        { short: "h", long: "help", desc: "print the help and exit" },
        { short: "i", long: "ignore-errors", desc: "ignore errors from commands" },
        { short: "I", long: "include-dir", desc: "search DIRECTORY for includes",
          arg: { kind: "dir" } },
        { short: "j", long: "jobs", desc: "allow N jobs at once",
          arg: { kind: "none" }, arg_optional: true },
        { short: "k", long: "keep-going", desc: "keep going when targets fail" },
        { short: "l", long: "load-average", desc: "limit jobs by load average",
          arg: { kind: "none" }, arg_optional: true },
        { short: "L", long: "check-symlink-times",
          desc: "use the latest mtime of symlink and target" },
        { short: "n", long: "dry-run", desc: "print the commands, run none" },
        { long: "just-print", desc: "print the commands, run none" },
        { short: "o", long: "old-file", desc: "consider FILE very old",
          arg: { kind: "path" } },
        { short: "p", long: "print-data-base", desc: "print make's internal database" },
        { short: "q", long: "question", desc: "run nothing; exit status says" },
        { short: "r", long: "no-builtin-rules", desc: "disable the built-in rules" },
        { short: "R", long: "no-builtin-variables",
          desc: "disable the built-in variables" },
        { short: "s", long: "silent", desc: "do not echo commands" },
        { short: "S", long: "no-keep-going", desc: "turn off -k" },
        { short: "t", long: "touch", desc: "touch targets instead of remaking" },
        { short: "v", long: "version", desc: "print the version and exit" },
        { short: "w", long: "print-directory", desc: "print the current directory" },
        { long: "no-print-directory", desc: "turn off -w" },
        { short: "W", long: "what-if", desc: "consider FILE infinitely new",
          arg: { kind: "path" } },
        { long: "warn-undefined-variables",
          desc: "warn on undefined variables" },
    ],

    args: [ { kind: "generator", generator: "make_targets", repeat: true } ],
}
