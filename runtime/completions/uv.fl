# uv 0.12.7 (Homebrew 2026-08-27 aarch64-apple-darwin) -- from `uv help` and `uv <command> [<subcommand>] --help`.
#
# runtime/completions/uv.fl: completion spec for uv, the Python package
# and project manager. Every subcommand and flag here is one the installed
# uv prints in its own help. uv lists its "Global options" -- and its
# cache and Python options, which it prints on every command -- once at the
# top; they are declared global here. Each command carries its most common
# flags, not every index, resolver and build knob: `uv help <command>` has
# the rest. Package names, Python requests and platforms take free text.
{
    completion: 1,
    command: "uv",
    description: "an extremely fast Python package manager",

    flags: [
        { long: "version", short: "V", desc: "display the uv version" },
        { long: "quiet", short: "q", global: true, desc: "use quiet output" },
        { long: "verbose", short: "v", global: true, desc: "use verbose output" },
        { long: "color", global: true, desc: "control the use of color in output",
          arg: { kind: "values", values: ["auto", "always", "never"] } },
        { long: "system-certs", global: true,
          desc: "load TLS certificates from the platform's store" },
        { long: "offline", global: true, desc: "disable network access" },
        { long: "allow-insecure-host", global: true,
          desc: "allow insecure connections to a host",
          arg: { kind: "none" } },
        { long: "no-progress", global: true, desc: "hide all progress outputs" },
        { long: "directory", global: true,
          desc: "change to the given directory before running",
          arg: { kind: "dir" } },
        { long: "project", global: true,
          desc: "discover a project in the given directory",
          arg: { kind: "dir" } },
        { long: "config-file", global: true,
          desc: "the path to a `uv.toml` file for configuration",
          arg: { kind: "path", ext: ["toml"] } },
        { long: "no-config", global: true,
          desc: "avoid discovering configuration files" },
        { long: "no-cache", short: "n", global: true,
          desc: "avoid reading from or writing to the cache" },
        { long: "cache-dir", global: true, desc: "path to the cache directory",
          arg: { kind: "dir" } },
        { long: "managed-python", global: true,
          desc: "require use of uv-managed Python versions" },
        { long: "no-managed-python", global: true,
          desc: "disable use of uv-managed Python versions" },
        { long: "no-python-downloads", global: true,
          desc: "disable automatic downloads of Python" },
        { long: "help", short: "h", global: true,
          desc: "display the concise help for this command" },
    ],

    subcommands: [
        { name: "auth", desc: "manage authentication",
          subcommands: [
              { name: "login", desc: "login to a service",
                flags: [
                    { long: "username", short: "u",
                      desc: "the username for the service",
                      arg: { kind: "none" } },
                    { long: "password", desc: "the password for the service",
                      arg: { kind: "none" } },
                    { long: "token", short: "t", desc: "the token for the service",
                      arg: { kind: "none" } },
                    { long: "keyring-provider",
                      desc: "the keyring provider to use for storage of credentials",
                      arg: { kind: "values", values: ["disabled", "subprocess"] } },
                ],
                args: [ { kind: "none" } ] },
              { name: "logout", desc: "logout of a service",
                flags: [
                    { long: "username", short: "u", desc: "the username to log out",
                      arg: { kind: "none" } },
                    { long: "keyring-provider",
                      desc: "the keyring provider to use for storage of credentials",
                      arg: { kind: "values", values: ["disabled", "subprocess"] } },
                ],
                args: [ { kind: "none" } ] },
              { name: "token", desc: "show the authentication token for a service",
                flags: [
                    { long: "username", short: "u", desc: "the username to look up",
                      arg: { kind: "none" } },
                    { long: "keyring-provider",
                      desc: "the keyring provider to use for reading credentials",
                      arg: { kind: "values", values: ["disabled", "subprocess"] } },
                ],
                args: [ { kind: "none" } ] },
              { name: "dir", desc: "show the path to the uv credentials directory" },
          ] },
        { name: "run", desc: "run a command or script",
          flags: [
              { long: "extra",
                desc: "include optional dependencies from the specified extra name",
                arg: { kind: "none" } },
              { long: "all-extras", desc: "include all optional dependencies" },
              { long: "no-extra",
                desc: "exclude these extras, if `--all-extras` is given",
                arg: { kind: "none" } },
              { long: "no-dev", desc: "disable the development dependency group" },
              { long: "only-dev",
                desc: "only include the development dependency group" },
              { long: "group",
                desc: "include dependencies from the specified dependency group",
                arg: { kind: "none" } },
              { long: "no-group", desc: "disable the specified dependency group",
                arg: { kind: "none" } },
              { long: "only-group", desc: "only include this dependency group",
                arg: { kind: "none" } },
              { long: "all-groups",
                desc: "include dependencies from all dependency groups" },
              { long: "no-default-groups",
                desc: "ignore the default dependency groups" },
              { long: "module", short: "m", desc: "run a Python module" },
              { long: "no-editable",
                desc: "install editable dependencies as non-editable" },
              { long: "exact",
                desc: "perform an exact sync, removing extraneous packages" },
              { long: "env-file",
                desc: "load environment variables from a `.env` file",
                arg: { kind: "path" } },
              { long: "no-env-file",
                desc: "avoid reading environment variables from a `.env` file" },
              { long: "with", short: "w",
                desc: "run with the given packages installed",
                arg: { kind: "none" } },
              { long: "with-editable",
                desc: "run with the given packages installed in editable mode",
                arg: { kind: "path" } },
              { long: "with-requirements",
                desc: "run with the packages listed in the given files",
                arg: { kind: "path", ext: ["txt"] } },
              { long: "isolated",
                desc: "run the command in an isolated virtual environment" },
              { long: "active", desc: "prefer the active venv over the project's" },
              { long: "no-sync", desc: "avoid syncing the virtual environment" },
              { long: "locked",
                desc: "assert that the `uv.lock` will remain unchanged" },
              { long: "frozen", desc: "run without updating the `uv.lock` file" },
              { long: "script", short: "s",
                desc: "run the given path as a Python script" },
              { long: "gui-script",
                desc: "run the given path as a Python GUI script" },
              { long: "all-packages",
                desc: "run the command with all workspace members installed" },
              { long: "package",
                desc: "run the command in a specific package in the workspace",
                arg: { kind: "none" } },
              { long: "no-project",
                desc: "avoid discovering the project or workspace" },
              { long: "python", short: "p",
                desc: "the Python interpreter for the run environment",
                arg: { kind: "none" } },
              { long: "python-platform",
                desc: "the platform for which requirements should be installed",
                arg: { kind: "none" } },
              { long: "index",
                desc: "extra indexes to use when resolving dependencies",
                arg: { kind: "none" } },
              { long: "default-index", desc: "the default package index",
                arg: { kind: "none" } },
              { long: "upgrade", short: "U",
                desc: "allow package upgrades, ignoring pinned versions" },
              { long: "upgrade-package", short: "P",
                desc: "allow upgrades for a specific package",
                arg: { kind: "none" } },
              { long: "reinstall", desc: "reinstall all packages" },
          ],
          args: [ { kind: "path", ext: ["py"] }, { kind: "path", repeat: true } ],
          after_dashdash: { kind: "path", repeat: true } },
        { name: "init", desc: "create a new project",
          flags: [
              { long: "name", desc: "the name of the project",
                arg: { kind: "none" } },
              { long: "bare", desc: "only create a `pyproject.toml`" },
              { long: "package", desc: "set up the project to be built as a package" },
              { long: "no-package", desc: "do not set up the project as a package" },
              { long: "app", desc: "create a project for an application" },
              { long: "lib", desc: "create a project for a library" },
              { long: "script", desc: "create a script" },
              { long: "description", desc: "set the project description",
                arg: { kind: "none" } },
              { long: "no-description",
                desc: "disable the description for the project" },
              { long: "vcs", desc: "initialize a version control system",
                arg: { kind: "values", values: ["git", "none"] } },
              { long: "build-backend", desc: "initialize this build backend",
                arg: { kind: "values", values: [
                    "uv", "hatch", "flit", "pdm", "poetry", "setuptools",
                    "maturin", "scikit",
                ] } },
              { long: "no-readme", desc: "do not create a `README.md` file" },
              { long: "author-from",
                desc: "fill in `authors` in `pyproject.toml` from",
                arg: { kind: "values", values: ["auto", "git", "none"] } },
              { long: "no-pin-python",
                desc: "do not create a `.python-version` file" },
              { long: "no-workspace",
                desc: "avoid discovering a workspace; standalone" },
              { long: "python", short: "p",
                desc: "the Python to determine the minimum supported one",
                arg: { kind: "none" } },
          ],
          args: [ { kind: "dir" } ] },
        { name: "add", desc: "add dependencies to the project",
          flags: [
              { long: "requirements", short: "r",
                desc: "add the packages listed in the given files",
                arg: { kind: "path", ext: ["txt"] } },
              { long: "constraints", short: "c",
                desc: "constrain versions using the given requirements files",
                arg: { kind: "path", ext: ["txt"] } },
              { long: "marker", short: "m",
                desc: "apply this marker to all added packages",
                arg: { kind: "none" } },
              { long: "dev",
                desc: "add the requirements to the development dependency group" },
              { long: "optional",
                desc: "add to the package's optional deps for this extra",
                arg: { kind: "none" } },
              { long: "group",
                desc: "add the requirements to the specified dependency group",
                arg: { kind: "none" } },
              { long: "editable", desc: "add the requirements as editable" },
              { long: "raw", desc: "add a dependency as provided" },
              { long: "bounds", desc: "the kind of version specifier to add",
                arg: { kind: "values", values: [
                    "lower", "major", "minor", "exact",
                ] } },
              { long: "rev", desc: "commit to use when adding a dependency from Git",
                arg: { kind: "none" } },
              { long: "tag", desc: "tag to use when adding a dependency from Git",
                arg: { kind: "none" } },
              { long: "branch",
                desc: "branch to use when adding a dependency from Git",
                arg: { kind: "none" } },
              { long: "extra", desc: "extras to enable for the dependency",
                arg: { kind: "none" } },
              { long: "no-sync", desc: "avoid syncing the virtual environment" },
              { long: "locked",
                desc: "assert that the `uv.lock` will remain unchanged" },
              { long: "frozen",
                desc: "add dependencies without re-locking the project" },
              { long: "active", desc: "prefer the active venv over the project's" },
              { long: "package",
                desc: "add the dependency to a specific package in the workspace",
                arg: { kind: "none" } },
              { long: "script", desc: "add to this Python script, not the project",
                arg: { kind: "path", ext: ["py"] } },
              { long: "workspace", desc: "add the dependency as a workspace member" },
              { long: "no-workspace",
                desc: "don't add the dependency as a workspace member" },
              { long: "no-install-project",
                desc: "do not install the current project" },
              { long: "python", short: "p",
                desc: "the Python interpreter to use for resolving and syncing",
                arg: { kind: "none" } },
              { long: "index",
                desc: "extra indexes to use when resolving dependencies",
                arg: { kind: "none" } },
              { long: "default-index", desc: "the default package index",
                arg: { kind: "none" } },
              { long: "upgrade", short: "U",
                desc: "allow package upgrades, ignoring pinned versions" },
              { long: "upgrade-package", short: "P",
                desc: "allow upgrades for a specific package",
                arg: { kind: "none" } },
              { long: "reinstall", desc: "reinstall all packages" },
          ],
          args: [ { kind: "none", repeat: true } ] },
        { name: "remove", desc: "remove dependencies from the project",
          flags: [
              { long: "dev",
                desc: "remove the packages from the development dependency group" },
              { long: "optional",
                desc: "remove from the optional deps of this extra",
                arg: { kind: "none" } },
              { long: "group",
                desc: "remove the packages from the specified dependency group",
                arg: { kind: "none" } },
              { long: "no-sync", desc: "avoid syncing the virtual environment" },
              { long: "active", desc: "prefer the active venv over the project's" },
              { long: "locked",
                desc: "assert that the `uv.lock` will remain unchanged" },
              { long: "frozen", desc: "remove dependencies without re-locking" },
              { long: "package", desc: "remove from a specific workspace package",
                arg: { kind: "none" } },
              { long: "script",
                desc: "remove from this Python script, not the project",
                arg: { kind: "path", ext: ["py"] } },
              { long: "python", short: "p",
                desc: "the Python interpreter to use for resolving and syncing",
                arg: { kind: "none" } },
              { long: "index",
                desc: "extra indexes to use when resolving dependencies",
                arg: { kind: "none" } },
              { long: "default-index", desc: "the default package index",
                arg: { kind: "none" } },
              { long: "upgrade", short: "U",
                desc: "allow package upgrades, ignoring pinned versions" },
              { long: "upgrade-package", short: "P",
                desc: "allow upgrades for a specific package",
                arg: { kind: "none" } },
          ],
          args: [ { kind: "none", repeat: true } ] },
        { name: "version", desc: "read or update the project's version",
          flags: [
              { long: "bump", desc: "update the version using the given semantics",
                arg: { kind: "values", values: [
                    "major", "minor", "patch", "stable", "alpha", "beta", "rc",
                    "post", "dev",
                ] } },
              { long: "dry-run",
                desc: "don't write the new version to `pyproject.toml`" },
              { long: "short", desc: "only show the version" },
              { long: "output-format", desc: "the format of the output",
                arg: { kind: "values", values: ["text", "json"] } },
              { long: "no-sync", desc: "avoid syncing the virtual environment" },
              { long: "active", desc: "prefer the active venv over the project's" },
              { long: "locked",
                desc: "assert that the `uv.lock` will remain unchanged" },
              { long: "frozen", desc: "update the version without re-locking" },
              { long: "package", desc: "the version of a specific workspace package",
                arg: { kind: "none" } },
              { long: "python", short: "p",
                desc: "the Python interpreter to use for resolving and syncing",
                arg: { kind: "none" } },
          ],
          args: [ { kind: "none" } ] },
        { name: "sync", desc: "update the project's environment",
          flags: [
              { long: "extra",
                desc: "include optional dependencies from the specified extra name",
                arg: { kind: "none" } },
              { long: "all-extras", desc: "include all optional dependencies" },
              { long: "no-extra",
                desc: "exclude these extras, if `--all-extras` is given",
                arg: { kind: "none" } },
              { long: "no-dev", desc: "disable the development dependency group" },
              { long: "only-dev",
                desc: "only include the development dependency group" },
              { long: "group",
                desc: "include dependencies from the specified dependency group",
                arg: { kind: "none" } },
              { long: "no-group", desc: "disable the specified dependency group",
                arg: { kind: "none" } },
              { long: "only-group", desc: "only include this dependency group",
                arg: { kind: "none" } },
              { long: "all-groups",
                desc: "include dependencies from all dependency groups" },
              { long: "no-default-groups",
                desc: "ignore the default dependency groups" },
              { long: "output-format", desc: "select the output format",
                arg: { kind: "values", values: ["text", "json"] } },
              { long: "no-editable",
                desc: "install editable dependencies as non-editable" },
              { long: "inexact", desc: "do not remove extraneous packages" },
              { long: "active",
                desc: "sync dependencies to the active virtual environment" },
              { long: "no-install-project",
                desc: "do not install the current project" },
              { long: "no-install-workspace",
                desc: "do not install any workspace members" },
              { long: "no-install-package",
                desc: "do not install the given package(s)",
                arg: { kind: "none" } },
              { long: "locked",
                desc: "assert that the `uv.lock` will remain unchanged" },
              { long: "frozen", desc: "sync without updating the `uv.lock` file" },
              { long: "dry-run",
                desc: "dry run: write no lockfile, change no environment" },
              { long: "all-packages", desc: "sync all packages in the workspace" },
              { long: "package", desc: "sync for specific packages in the workspace",
                arg: { kind: "none" } },
              { long: "script", desc: "sync the environment for a Python script",
                arg: { kind: "path", ext: ["py"] } },
              { long: "python", short: "p",
                desc: "the Python interpreter to use for the project environment",
                arg: { kind: "none" } },
              { long: "python-platform",
                desc: "the platform for which requirements should be installed",
                arg: { kind: "none" } },
              { long: "check", desc: "check if the environment is synchronized" },
              { long: "index",
                desc: "extra indexes to use when resolving dependencies",
                arg: { kind: "none" } },
              { long: "default-index", desc: "the default package index",
                arg: { kind: "none" } },
              { long: "upgrade", short: "U",
                desc: "allow package upgrades, ignoring pinned versions" },
              { long: "upgrade-package", short: "P",
                desc: "allow upgrades for a specific package",
                arg: { kind: "none" } },
              { long: "reinstall", desc: "reinstall all packages" },
          ] },
        { name: "lock", desc: "update the project's lockfile",
          flags: [
              { long: "check", desc: "check if the lockfile is up-to-date" },
              { long: "check-exists", desc: "assert that a `uv.lock` exists" },
              { long: "dry-run",
                desc: "perform a dry run, without writing the lockfile" },
              { long: "script", desc: "lock this Python script, not the project",
                arg: { kind: "path", ext: ["py"] } },
              { long: "python", short: "p",
                desc: "the Python interpreter to use during resolution",
                arg: { kind: "none" } },
              { long: "index",
                desc: "extra indexes to use when resolving dependencies",
                arg: { kind: "none" } },
              { long: "default-index", desc: "the default package index",
                arg: { kind: "none" } },
              { long: "upgrade", short: "U",
                desc: "allow package upgrades, ignoring pinned versions" },
              { long: "upgrade-package", short: "P",
                desc: "allow upgrades for a specific package",
                arg: { kind: "none" } },
          ] },
        { name: "export",
          desc: "export the project's lockfile to an alternate format",
          flags: [
              { long: "format", desc: "the format to export `uv.lock` to",
                arg: { kind: "values", values: [
                    "requirements.txt", "pylock.toml", "cyclonedx1.5",
                ] } },
              { long: "all-packages", desc: "export the entire workspace" },
              { long: "package",
                desc: "export dependencies of specific workspace packages",
                arg: { kind: "none" } },
              { long: "prune",
                desc: "prune the given package from the dependency tree",
                arg: { kind: "none" } },
              { long: "extra",
                desc: "include optional dependencies from the specified extra name",
                arg: { kind: "none" } },
              { long: "all-extras", desc: "include all optional dependencies" },
              { long: "no-extra",
                desc: "exclude these extras, if `--all-extras` is given",
                arg: { kind: "none" } },
              { long: "no-dev", desc: "disable the development dependency group" },
              { long: "only-dev",
                desc: "only include the development dependency group" },
              { long: "group",
                desc: "include dependencies from the specified dependency group",
                arg: { kind: "none" } },
              { long: "no-group", desc: "disable the specified dependency group",
                arg: { kind: "none" } },
              { long: "only-group", desc: "only include this dependency group",
                arg: { kind: "none" } },
              { long: "all-groups",
                desc: "include dependencies from all dependency groups" },
              { long: "no-default-groups",
                desc: "ignore the default dependency groups" },
              { long: "no-annotate",
                desc: "exclude comment annotations of each source" },
              { long: "no-header",
                desc: "exclude the comment header from the output" },
              { long: "emit-index-url", desc: "include index URLs in the output" },
              { long: "no-editable",
                desc: "export editable dependencies as non-editable" },
              { long: "no-hashes", desc: "omit hashes in the generated output" },
              { long: "output-file", short: "o",
                desc: "write the exported requirements to this file",
                arg: { kind: "path" } },
              { long: "no-emit-project", desc: "do not emit the current project" },
              { long: "no-emit-workspace", desc: "do not emit any workspace members" },
              { long: "no-emit-local",
                desc: "do not include local path dependencies" },
              { long: "no-emit-package", desc: "do not emit the given package(s)",
                arg: { kind: "none" } },
              { long: "locked",
                desc: "assert that the `uv.lock` will remain unchanged" },
              { long: "frozen", desc: "do not update the `uv.lock` before exporting" },
              { long: "script", desc: "export a PEP 723 script, not the project",
                arg: { kind: "path", ext: ["py"] } },
              { long: "python", short: "p",
                desc: "the Python interpreter to use during resolution",
                arg: { kind: "none" } },
          ] },
        { name: "tree", desc: "display the project's dependency tree",
          flags: [
              { long: "universal",
                desc: "show a platform-independent dependency tree" },
              { long: "format", desc: "the format of the dependency graph",
                arg: { kind: "values", values: ["text", "json"] } },
              { long: "depth", short: "d",
                desc: "maximum display depth of the dependency tree",
                arg: { kind: "none" } },
              { long: "prune", desc: "prune the given package from the tree",
                arg: { kind: "none" } },
              { long: "package", desc: "display only the specified packages",
                arg: { kind: "none" } },
              { long: "no-dedupe", desc: "do not de-duplicate repeated dependencies" },
              { long: "invert",
                desc: "show the packages that depend on the given one" },
              { long: "outdated",
                desc: "show the latest available version of each package" },
              { long: "show-sizes",
                desc: "show compressed wheel sizes for packages in the tree" },
              { long: "no-dev", desc: "disable the development dependency group" },
              { long: "only-dev",
                desc: "only include the development dependency group" },
              { long: "group",
                desc: "include dependencies from the specified dependency group",
                arg: { kind: "none" } },
              { long: "no-group", desc: "disable the specified dependency group",
                arg: { kind: "none" } },
              { long: "only-group", desc: "only include this dependency group",
                arg: { kind: "none" } },
              { long: "all-groups",
                desc: "include dependencies from all dependency groups" },
              { long: "locked",
                desc: "assert that the `uv.lock` will remain unchanged" },
              { long: "frozen",
                desc: "display the requirements without locking the project" },
              { long: "script", desc: "show the tree for a Python script",
                arg: { kind: "path", ext: ["py"] } },
              { long: "python-version",
                desc: "the Python version to use when filtering the tree",
                arg: { kind: "none" } },
              { long: "python-platform",
                desc: "the platform to use when filtering the tree",
                arg: { kind: "none" } },
              { long: "python", short: "p",
                desc: "the Python interpreter to use for locking and filtering",
                arg: { kind: "none" } },
          ] },
        { name: "format", desc: "format Python code in the project",
          flags: [
              { long: "check", desc: "check if files are formatted, write nothing" },
              { long: "diff",
                desc: "show a diff of formatting changes, write nothing" },
              { long: "version", desc: "the version of Ruff to use for formatting",
                arg: { kind: "none" } },
              { long: "no-project", desc: "avoid discovering a project or workspace" },
          ],
          after_dashdash: { kind: "none", repeat: true } },
        { name: "check", desc: "run checks on the project",
          flags: [
              { long: "fix",
                desc: "apply safe fixes to resolve type-checking errors" },
              { long: "all-packages", desc: "check all packages in the workspace" },
              { long: "package", desc: "check specific packages in the workspace",
                arg: { kind: "none" } },
              { long: "script", desc: "check this PEP 723 script, not the project",
                arg: { kind: "path", ext: ["py"] } },
              { long: "extra",
                desc: "include optional dependencies from the specified extra name",
