                    { long: "system",
                      desc: "list packages in the system Python environment" },
                    { long: "python", short: "p",
                      desc: "the Python interpreter for which packages should be listed",
                      arg: { kind: "none" } },
                ] },
              { name: "check",
                desc: "verify installed packages have compatible deps",
                flags: [
                    { long: "system",
                      desc: "check packages in the system Python environment" },
                    { long: "python-version",
                      desc: "the Python version against which packages should be checked",
                      arg: { kind: "none" } },
                    { long: "python-platform",
                      desc: "the platform for which packages should be checked",
                      arg: { kind: "none" } },
                    { long: "python", short: "p",
                      desc: "the Python interpreter for which packages should be checked",
                      arg: { kind: "none" } },
                ] },
          ] },
        { name: "venv", desc: "create a virtual environment",
          flags: [
              { long: "no-project", desc: "avoid discovering a project or workspace" },
              { long: "seed", desc: "install seed packages (pip, setuptools, wheel)" },
              { long: "clear", short: "c",
                desc: "remove any existing files or dirs at the target" },
              { long: "allow-existing",
                desc: "preserve existing files at the target path" },
              { long: "prompt", desc: "the prompt for the virtual environment",
                arg: { kind: "none" } },
              { long: "system-site-packages",
                desc: "give the venv access to the system site-packages" },
              { long: "relocatable",
                desc: "make the virtual environment relocatable" },
              { long: "link-mode",
                desc: "how to install packages from the global cache",
                arg: { kind: "values", values: [
                    "clone", "copy", "hardlink", "symlink",
                ] } },
              { long: "python", short: "p",
                desc: "the Python interpreter for the virtual environment",
                arg: { kind: "none" } },
              { long: "index",
                desc: "extra indexes to use when resolving dependencies",
                arg: { kind: "none" } },
              { long: "default-index", desc: "the default package index",
                arg: { kind: "none" } },
          ],
          args: [ { kind: "dir" } ] },
        { name: "build", desc: "build Python packages into sdists and wheels",
          flags: [
              { long: "package", desc: "build a specific package in the workspace",
                arg: { kind: "none" } },
              { long: "all-packages", desc: "build every package in the workspace" },
              { long: "out-dir", short: "o",
                desc: "the output directory for the built artifacts",
                arg: { kind: "dir" } },
              { long: "sdist",
                desc: "build a source distribution from the directory" },
              { long: "wheel",
                desc: "build a binary distribution from the directory" },
              { long: "no-build-logs", desc: "hide logs from the build backend" },
              { long: "force-pep517", desc: "always build through PEP 517" },
              { long: "clear", desc: "clear the output directory before the build" },
              { long: "no-create-gitignore",
                desc: "do not create a `.gitignore` in the output dir" },
              { long: "build-constraints", short: "b",
                desc: "constrain build dependencies with these files",
                arg: { kind: "path", ext: ["txt"] } },
              { long: "require-hashes",
                desc: "require a matching hash for each requirement" },
              { long: "python", short: "p",
                desc: "the Python interpreter to use for the build environment",
                arg: { kind: "none" } },
              { long: "index",
                desc: "extra indexes to use when resolving dependencies",
                arg: { kind: "none" } },
              { long: "default-index", desc: "the default package index",
                arg: { kind: "none" } },
          ],
          args: [ { kind: "path" } ] },
        { name: "publish", desc: "upload distributions to an index",
          flags: [
              { long: "index", desc: "the name of an index in the configuration",
                arg: { kind: "none" } },
              { long: "username", short: "u", desc: "the username for the upload",
                arg: { kind: "none" } },
              { long: "password", short: "p", desc: "the password for the upload",
                arg: { kind: "none" } },
              { long: "token", short: "t", desc: "the token for the upload",
                arg: { kind: "none" } },
              { long: "trusted-publishing", desc: "configure trusted publishing",
                arg: { kind: "values", values: ["automatic", "always", "never"] } },
              { long: "keyring-provider",
                desc: "use `keyring` for index URL authentication",
                arg: { kind: "values", values: ["disabled", "subprocess"] } },
              { long: "publish-url", desc: "the URL of the upload endpoint",
                arg: { kind: "none" } },
              { long: "check-url", desc: "check an index URL for existing files",
                arg: { kind: "none" } },
              { long: "dry-run", desc: "perform a dry run without uploading files" },
              { long: "no-attestations", desc: "do not upload attestations" },
          ],
          args: [ { kind: "path", repeat: true } ] },
        { name: "workspace", desc: "inspect uv workspaces",
          subcommands: [
              { name: "metadata", desc: "view metadata about the current workspace",
                flags: [
                    { long: "script", desc: "metadata for a Python script",
                      arg: { kind: "path", ext: ["py"] } },
                    { long: "locked", desc: "check if the lockfile is up-to-date" },
                    { long: "frozen",
                      desc: "assert that a `uv.lock` exists, unchecked" },
                    { long: "dry-run", desc: "dry run: write no lockfile" },
                    { long: "sync",
                      desc: "sync the env to include module ownership metadata" },
                    { long: "exact", desc: "perform an exact sync" },
                    { long: "active",
                      desc: "sync dependencies to the active virtual environment" },
                    { long: "python", short: "p",
                      desc: "the Python interpreter to use during resolution",
                      arg: { kind: "none" } },
                ] },
              { name: "dir", desc: "display the path of a workspace member",
                flags: [
                    { long: "package",
                      desc: "the workspace member to show the path of",
                      arg: { kind: "none" } },
                ] },
              { name: "list", desc: "list the members of a workspace",
                flags: [
                    { long: "paths", desc: "show paths instead of names" },
                    { long: "scripts",
                      desc: "list standalone scripts with inline metadata" },
                ] },
          ] },
        { name: "cache", desc: "manage uv's cache",
          subcommands: [
              { name: "clean",
                desc: "clear the cache, or entries for given packages",
                flags: [
                    { long: "force",
                      desc: "force removal of the cache, ignoring in-use checks" },
                ],
                args: [ { kind: "none", repeat: true } ] },
              { name: "prune", desc: "prune dangling cache entries and cached envs",
                flags: [
                    { long: "ci", desc: "optimize the cache for persistence in CI" },
                    { long: "force",
                      desc: "force removal of the cache, ignoring in-use checks" },
                ] },
              { name: "dir", desc: "show the cache directory" },
              { name: "size", desc: "show the cache size",
                flags: [
                    { long: "output-format", desc: "select the output format",
                      arg: { kind: "values", values: ["auto", "human", "machine"] } },
                    { long: "human", short: "H",
                      desc: "display the cache size in human-readable form" },
                ] },
          ] },
        { name: "self", desc: "manage the uv executable",
          subcommands: [
              { name: "update", desc: "update uv",
                flags: [
                    { long: "token", desc: "a GitHub token for authentication",
                      arg: { kind: "none" } },
                    { long: "dry-run", desc: "run without performing the update" },
                ],
                args: [ { kind: "none" } ] },
              { name: "version", desc: "display uv's version",
                flags: [
                    { long: "short", desc: "only print the version" },
                    { long: "output-format", desc: "",
                      arg: { kind: "values", values: ["text", "json"] } },
                ] },
          ] },
        { name: "generate-shell-completion", desc: "generate shell completion",
          args: [ { kind: "values", values: [
                "bash", "elvish", "fish", "nushell", "powershell", "zsh",
            ] } ] },
        { name: "help", desc: "display documentation for a command",
          args: [ { kind: "values", values: [
                "auth", "run", "init", "add", "remove", "version", "sync", "lock",
                "export", "tree", "format", "check", "audit", "tool", "python",
                "pip", "venv", "build", "publish", "workspace", "cache", "self",
                "generate-shell-completion", "help",
            ] } ] },
    ],
}
