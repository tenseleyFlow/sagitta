# cargo 1.98.1 (797e8a9bc 2026-08-05) -- from `cargo --list` and `cargo <command> --help`.
#
# runtime/completions/cargo.fl: completion spec for cargo, Rust's package
# manager. Every subcommand and flag here is one the installed cargo prints
# in its own help. The flags every cargo command accepts (-v, -q, --color,
# --config, -Z, --locked, --offline, --frozen) are declared once, global.
# Package, binary, example and test names take free text: asking cargo
# metadata for them is too slow for a keystroke. Deprecated spellings
# (--all), nightly-only surface (--unit-graph, --artifact-dir, ...) and
# rarely typed flags (--message-format, --timings, ...) are left out;
# `clippy` and `fmt` are the rustup toolchain's, and `clippy` takes
# `cargo check`'s flags as its help says.
{
    completion: 1,
    command: "cargo",
    description: "Rust's package manager",

    flags: [
        { long: "version", short: "V", desc: "print version info and exit" },
        { long: "list", desc: "list installed commands" },
        { long: "explain", desc: "explain a rustc error message",
          arg: { kind: "none" } },
        { short: "C", desc: "change to DIRECTORY first (nightly-only)",
          arg: { kind: "dir" } },
        { long: "verbose", short: "v", global: true,
          desc: "verbose output (-vv very verbose)" },
        { long: "quiet", short: "q", global: true,
          desc: "do not print cargo log messages" },
        { long: "color", global: true, desc: "coloring",
          arg: { kind: "values", values: ["auto", "always", "never"] } },
        { long: "config", global: true,
          desc: "override a configuration value (KEY=VALUE|PATH)",
          arg: { kind: "none" } },
        { short: "Z", global: true, desc: "unstable (nightly-only) flags to cargo",
          arg: { kind: "none" } },
        { long: "locked", global: true,
          desc: "assert that `Cargo.lock` will remain unchanged" },
        { long: "offline", global: true, desc: "run without accessing the network" },
        { long: "frozen", global: true,
          desc: "equivalent to both --locked and --offline" },
        { long: "help", short: "h", global: true, desc: "print help" },
    ],

    subcommands: [
        { name: "build", aliases: ["b"], desc: "compile the current package",
          flags: [
              { long: "package", short: "p",
                desc: "package to build (see `cargo help pkgid`)",
                arg: { kind: "none" } },
              { long: "workspace", desc: "all packages in the workspace" },
              { long: "lib", desc: "only this package's library" },
              { long: "bin", desc: "build only the specified binary",
                arg: { kind: "none" } },
              { long: "example", desc: "build only the specified example",
                arg: { kind: "none" } },
              { long: "tests", desc: "all targets with `test = true`" },
              { long: "test", desc: "build only the specified test target",
                arg: { kind: "none" } },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "all-features", desc: "activate all features" },
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "release", short: "r",
                desc: "release mode, with optimizations" },
              { long: "profile", desc: "use the specified profile",
                arg: { kind: "none" } },
              { long: "jobs", short: "j", desc: "number of parallel jobs",
                arg: { kind: "none" } },
              { long: "target", desc: "build for the target triple",
                arg: { kind: "none" } },
              { long: "target-dir", desc: "directory for generated artifacts",
                arg: { kind: "dir" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ] },
        { name: "check", aliases: ["c"],
          desc: "analyze the package and report errors, don't build",
          flags: [
              { long: "package", short: "p", desc: "package(s) to check",
                arg: { kind: "none" } },
              { long: "workspace", desc: "all packages in the workspace" },
              { long: "lib", desc: "only this package's library" },
              { long: "bin", desc: "check only the specified binary",
                arg: { kind: "none" } },
              { long: "example", desc: "check only the specified example",
                arg: { kind: "none" } },
              { long: "tests", desc: "all targets with `test = true`" },
              { long: "test", desc: "check only the specified test target",
                arg: { kind: "none" } },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "all-features", desc: "activate all features" },
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "jobs", short: "j", desc: "number of parallel jobs",
                arg: { kind: "none" } },
              { long: "release", short: "r",
                desc: "release mode, with optimizations" },
              { long: "profile", desc: "use the specified profile",
                arg: { kind: "none" } },
              { long: "target", desc: "check for the target triple",
                arg: { kind: "none" } },
              { long: "target-dir", desc: "directory for generated artifacts",
                arg: { kind: "dir" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ] },
        { name: "clean", desc: "remove the target directory",
          flags: [
              { long: "doc", desc: "clean just the documentation directory" },
              { long: "dry-run", short: "n",
                desc: "display what would be deleted, delete nothing" },
              { long: "package", short: "p", desc: "package to clean artifacts for",
                arg: { kind: "none" } },
              { long: "workspace", desc: "clean artifacts of the workspace members" },
              { long: "release", short: "r", desc: "clean release artifacts" },
              { long: "profile", desc: "clean artifacts of the specified profile",
                arg: { kind: "none" } },
              { long: "target", desc: "target triple to clean output for",
                arg: { kind: "none" } },
              { long: "target-dir", desc: "directory for generated artifacts",
                arg: { kind: "dir" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ] },
        { name: "doc", aliases: ["d"],
          desc: "build this package's and its dependencies' docs",
          flags: [
              { long: "open",
                desc: "opens the docs in a browser after the operation" },
              { long: "no-deps", desc: "don't build documentation for dependencies" },
              { long: "document-private-items", desc: "document private items" },
              { long: "package", short: "p", desc: "package to document",
                arg: { kind: "none" } },
              { long: "workspace", desc: "all packages in the workspace" },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "all-features", desc: "activate all features" },
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "lib", desc: "only this package's library" },
              { long: "bin", desc: "document only the specified binary",
                arg: { kind: "none" } },
              { long: "example", desc: "document only the specified example",
                arg: { kind: "none" } },
              { long: "jobs", short: "j", desc: "number of parallel jobs",
                arg: { kind: "none" } },
              { long: "release", short: "r",
                desc: "release mode, with optimizations" },
              { long: "profile", desc: "use the specified profile",
                arg: { kind: "none" } },
              { long: "target", desc: "build for the target triple",
                arg: { kind: "none" } },
              { long: "target-dir", desc: "directory for generated artifacts",
                arg: { kind: "dir" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ] },
        { name: "new", desc: "create a new cargo package",
          flags: [
              { long: "vcs", desc: "initialize a repository for this VCS",
                arg: { kind: "values", values: [
                    "git", "hg", "pijul", "fossil", "none",
                ] } },
              { long: "bin", desc: "use a binary (application) template" },
              { long: "lib", desc: "use a library template" },
              { long: "edition", desc: "edition to set for the crate generated",
                arg: { kind: "values", values: ["2015", "2018", "2021", "2024"] } },
              { long: "name", desc: "the package name (default: the directory name)",
                arg: { kind: "none" } },
              { long: "registry", desc: "registry to use",
                arg: { kind: "none" } },
          ],
          args: [ { kind: "dir" } ] },
        { name: "init", desc: "create a new cargo package in an existing directory",
          flags: [
              { long: "vcs", desc: "initialize a repository for this VCS",
                arg: { kind: "values", values: [
                    "git", "hg", "pijul", "fossil", "none",
                ] } },
              { long: "bin", desc: "use a binary (application) template" },
              { long: "lib", desc: "use a library template" },
              { long: "edition", desc: "edition to set for the crate generated",
                arg: { kind: "values", values: ["2015", "2018", "2021", "2024"] } },
              { long: "name", desc: "the package name (default: the directory name)",
                arg: { kind: "none" } },
              { long: "registry", desc: "registry to use",
                arg: { kind: "none" } },
          ],
          args: [ { kind: "dir" } ] },
        { name: "add", desc: "add dependencies to a manifest file",
          flags: [
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "default-features", desc: "re-enable the default features" },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "optional", desc: "mark the dependency as optional" },
              { long: "no-optional", desc: "mark the dependency as required" },
              { long: "rename", desc: "rename the dependency",
                arg: { kind: "none" } },
              { long: "dry-run", short: "n",
                desc: "don't actually write the manifest" },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
              { long: "package", short: "p", desc: "package to modify",
                arg: { kind: "none" } },
              { long: "path", desc: "filesystem path to local crate to add",
                arg: { kind: "dir" } },
              { long: "git", desc: "git repository location",
                arg: { kind: "none" } },
              { long: "branch", desc: "git branch to download the crate from",
                arg: { kind: "none" } },
              { long: "tag", desc: "git tag to download the crate from",
                arg: { kind: "none" } },
              { long: "rev", desc: "git reference to download the crate from",
                arg: { kind: "none" } },
              { long: "registry", desc: "package registry for this dependency",
                arg: { kind: "none" } },
              { long: "dev", desc: "add as development dependency" },
              { long: "build", desc: "add as build dependency" },
              { long: "target",
                desc: "add as dependency to the given target platform",
                arg: { kind: "none" } },
          ],
          args: [ { kind: "none", repeat: true } ] },
        { name: "remove", aliases: ["rm"],
          desc: "remove dependencies from a manifest file",
          flags: [
              { long: "dry-run", short: "n",
                desc: "don't actually write the manifest" },
              { long: "dev", desc: "remove from dev-dependencies" },
              { long: "build", desc: "remove from build-dependencies" },
              { long: "target", desc: "remove from target-dependencies",
                arg: { kind: "none" } },
              { long: "package", short: "p", desc: "package to remove from",
                arg: { kind: "none" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ],
          args: [ { kind: "none", repeat: true } ] },
        { name: "run", aliases: ["r"],
          desc: "run a binary or example of the local package",
          flags: [
              { long: "package", short: "p", desc: "package with the target to run",
                arg: { kind: "none" } },
              { long: "bin", desc: "name of the bin target to run",
                arg: { kind: "none" } },
              { long: "example", desc: "name of the example target to run",
                arg: { kind: "none" } },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "all-features", desc: "activate all features" },
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "jobs", short: "j", desc: "number of parallel jobs",
                arg: { kind: "none" } },
              { long: "release", short: "r",
                desc: "release mode, with optimizations" },
              { long: "profile", desc: "use the specified profile",
                arg: { kind: "none" } },
              { long: "target", desc: "build for the target triple",
                arg: { kind: "none" } },
              { long: "target-dir", desc: "directory for generated artifacts",
                arg: { kind: "dir" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ],
          args: [ { kind: "path", repeat: true } ],
          after_dashdash: { kind: "path", repeat: true } },
        { name: "test", aliases: ["t"], desc: "run the tests",
          flags: [
              { long: "no-run", desc: "compile, but don't run tests" },
              { long: "no-fail-fast", desc: "run all tests regardless of failure" },
              { long: "package", short: "p", desc: "package to run tests for",
                arg: { kind: "none" } },
              { long: "workspace", desc: "all packages in the workspace" },
              { long: "lib", desc: "only this package's library" },
              { long: "bin", desc: "test only the specified binary",
                arg: { kind: "none" } },
              { long: "example", desc: "test only the specified example",
                arg: { kind: "none" } },
              { long: "tests", desc: "all targets with `test = true`" },
              { long: "test", desc: "test only the specified test target",
                arg: { kind: "none" } },
              { long: "doc", desc: "test only this library's documentation" },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "all-features", desc: "activate all features" },
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "jobs", short: "j", desc: "number of parallel jobs",
                arg: { kind: "none" } },
              { long: "release", short: "r",
                desc: "release mode, with optimizations" },
              { long: "profile", desc: "use the specified profile",
                arg: { kind: "none" } },
              { long: "target", desc: "build for the target triple",
                arg: { kind: "none" } },
              { long: "target-dir", desc: "directory for generated artifacts",
                arg: { kind: "dir" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ],
          args: [ { kind: "none" } ],
          after_dashdash: { kind: "none", repeat: true } },
        { name: "bench", desc: "run the benchmarks",
          flags: [
              { long: "no-run", desc: "compile, but don't run benchmarks" },
              { long: "no-fail-fast",
                desc: "run all benchmarks regardless of failure" },
              { long: "package", short: "p", desc: "package to run benchmarks for",
                arg: { kind: "none" } },
              { long: "workspace", desc: "all packages in the workspace" },
              { long: "lib", desc: "only this package's library" },
              { long: "bin", desc: "benchmark only the specified binary",
                arg: { kind: "none" } },
              { long: "example", desc: "benchmark only the specified example",
                arg: { kind: "none" } },
              { long: "tests", desc: "all targets with `test = true`" },
              { long: "test", desc: "benchmark only the specified test target",
                arg: { kind: "none" } },
              { long: "benches",
                desc: "benchmark all targets that have `bench = true` set" },
              { long: "bench", desc: "benchmark only the specified bench target",
                arg: { kind: "none" } },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "all-features", desc: "activate all features" },
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "jobs", short: "j", desc: "number of parallel jobs",
                arg: { kind: "none" } },
              { long: "profile", desc: "use the specified profile",
                arg: { kind: "none" } },
              { long: "target", desc: "build for the target triple",
                arg: { kind: "none" } },
              { long: "target-dir", desc: "directory for generated artifacts",
                arg: { kind: "dir" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ],
          args: [ { kind: "none" } ],
          after_dashdash: { kind: "none", repeat: true } },
        { name: "update", desc: "update dependencies listed in Cargo.lock",
          flags: [
              { long: "dry-run", short: "n",
                desc: "don't actually write the lockfile" },
              { long: "recursive", desc: "also update all dependencies of [SPEC]" },
              { long: "precise", desc: "update [SPEC] to exactly PRECISE",
                arg: { kind: "none" } },
              { long: "workspace", short: "w",
                desc: "only update the workspace packages" },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ],
          args: [ { kind: "none", repeat: true } ] },
        { name: "search", desc: "search registry for crates",
          flags: [
              { long: "limit",
                desc: "limit the number of results (default 10, max 100)",
                arg: { kind: "none" } },
              { long: "registry", desc: "registry to search packages in",
                arg: { kind: "none" } },
          ],
          args: [ { kind: "none", repeat: true } ] },
        { name: "publish", desc: "package and upload this package to the registry",
          flags: [
              { long: "dry-run", short: "n",
                desc: "perform all checks without uploading" },
              { long: "registry", desc: "registry to upload the package to",
                arg: { kind: "none" } },
              { long: "no-verify",
                desc: "don't verify the contents by building them" },
              { long: "allow-dirty", desc: "allow a dirty working directory" },
              { long: "package", short: "p", desc: "package(s) to publish",
                arg: { kind: "none" } },
              { long: "workspace", desc: "all packages in the workspace" },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "all-features", desc: "activate all features" },
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "jobs", short: "j", desc: "number of parallel jobs",
                arg: { kind: "none" } },
              { long: "target", desc: "build for the target triple",
                arg: { kind: "none" } },
              { long: "target-dir", desc: "directory for generated artifacts",
                arg: { kind: "dir" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ] },
        { name: "install", desc: "install a Rust binary",
          flags: [
              { long: "version", desc: "specify a version to install",
                arg: { kind: "none" } },
              { long: "registry", desc: "registry to use",
                arg: { kind: "none" } },
              { long: "git", desc: "git URL to install the specified crate from",
                arg: { kind: "none" } },
              { long: "branch", desc: "branch to use when installing from git",
                arg: { kind: "none" } },
              { long: "tag", desc: "tag to use when installing from git",
                arg: { kind: "none" } },
              { long: "rev", desc: "specific commit to use when installing from git",
                arg: { kind: "none" } },
              { long: "path", desc: "filesystem path to local crate to install from",
                arg: { kind: "dir" } },
              { long: "root", desc: "directory to install packages into",
                arg: { kind: "dir" } },
              { long: "force", short: "f",
                desc: "force overwriting existing crates or binaries" },
              { long: "list", desc: "list all installed packages and their versions" },
              { long: "debug", desc: "build in debug mode (the 'dev' profile)" },
              { long: "bin", desc: "install only the specified binary",
                arg: { kind: "none" } },
              { long: "example", desc: "install only the specified example",
                arg: { kind: "none" } },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "all-features", desc: "activate all features" },
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "jobs", short: "j", desc: "number of parallel jobs",
                arg: { kind: "none" } },
              { long: "profile", desc: "use the specified profile",
                arg: { kind: "none" } },
              { long: "target", desc: "build for the target triple",
                arg: { kind: "none" } },
              { long: "target-dir", desc: "directory for generated artifacts",
                arg: { kind: "dir" } },
          ],
          args: [ { kind: "none", repeat: true } ] },
        { name: "uninstall", desc: "uninstall a Rust binary",
          flags: [
              { long: "root", desc: "directory to uninstall packages from",
                arg: { kind: "dir" } },
              { long: "package", short: "p", desc: "package to uninstall",
                arg: { kind: "none" } },
              { long: "bin", desc: "only uninstall the binary NAME",
                arg: { kind: "none" } },
          ],
          args: [ { kind: "none", repeat: true } ] },
        { name: "clippy", desc: "check a package to catch common mistakes",
          flags: [
              { long: "no-deps",
                desc: "lint only the given crate, not its dependencies" },
              { long: "fix",
                desc: "apply lint suggestions (implies --no-deps --all-targets)" },
              { long: "explain", desc: "print the documentation for a given lint",
                arg: { kind: "none" } },
              { long: "package", short: "p", desc: "package(s) to check",
                arg: { kind: "none" } },
              { long: "workspace", desc: "all packages in the workspace" },
              { long: "lib", desc: "only this package's library" },
              { long: "bin", desc: "check only the specified binary",
                arg: { kind: "none" } },
              { long: "example", desc: "check only the specified example",
                arg: { kind: "none" } },
              { long: "tests", desc: "all targets with `test = true`" },
              { long: "test", desc: "check only the specified test target",
                arg: { kind: "none" } },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "all-features", desc: "activate all features" },
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "jobs", short: "j", desc: "number of parallel jobs",
                arg: { kind: "none" } },
              { long: "release", short: "r",
                desc: "release mode, with optimizations" },
              { long: "profile", desc: "use the specified profile",
                arg: { kind: "none" } },
              { long: "target", desc: "check for the target triple",
                arg: { kind: "none" } },
              { long: "target-dir", desc: "directory for generated artifacts",
                arg: { kind: "dir" } },
              { long: "manifest-path", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ],
          after_dashdash: { kind: "none", repeat: true } },
        { name: "config", desc: "inspect configuration values",
          subcommands: [
              { name: "get", desc: "print a configuration value",
                flags: [
                    { long: "format", desc: "display format",
                      arg: { kind: "values", values: [
                          "toml", "json", "json-value",
                      ] } },
                    { long: "show-origin",
                      desc: "display where the config value is defined" },
                    { long: "merged", desc: "whether to merge config values",
                      arg: { kind: "values", values: ["yes", "no"] } },
                ],
                args: [ { kind: "none" } ] },
          ] },
        { name: "fetch", desc: "fetch dependencies of a package from the network",
          flags: [
              { long: "target", desc: "fetch dependencies for the target triple",
                arg: { kind: "none" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ] },
        { name: "fix", desc: "automatically fix lint warnings reported by rustc",
          flags: [
              { long: "edition", desc: "fix in preparation for the next edition" },
              { long: "edition-idioms",
                desc: "fix warnings to migrate to the idioms of an edition" },
              { long: "broken-code",
                desc: "fix code even if it already has compiler errors" },
              { long: "allow-no-vcs",
                desc: "fix code even if a VCS was not detected" },
              { long: "allow-dirty",
                desc: "fix even if the working directory is dirty" },
              { long: "allow-staged",
                desc: "fix code even if the working directory has staged changes" },
              { long: "package", short: "p", desc: "package(s) to fix",
                arg: { kind: "none" } },
              { long: "workspace", desc: "all packages in the workspace" },
              { long: "lib", desc: "only this package's library" },
              { long: "bin", desc: "fix only the specified binary",
                arg: { kind: "none" } },
              { long: "example", desc: "fix only the specified example",
                arg: { kind: "none" } },
              { long: "tests", desc: "all targets with `test = true`" },
              { long: "test", desc: "fix only the specified test target",
                arg: { kind: "none" } },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "all-features", desc: "activate all features" },
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "jobs", short: "j", desc: "number of parallel jobs",
                arg: { kind: "none" } },
              { long: "release", short: "r",
                desc: "release mode, with optimizations" },
              { long: "profile", desc: "use the specified profile",
                arg: { kind: "none" } },
              { long: "target", desc: "fix for the target triple",
                arg: { kind: "none" } },
              { long: "target-dir", desc: "directory for generated artifacts",
                arg: { kind: "dir" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ] },
        { name: "fmt",
          desc: "format all bin and lib files of the crate with rustfmt",
          flags: [
              { long: "version", desc: "print rustfmt version and exit" },
              { long: "package", short: "p", desc: "specify package to format",
                arg: { kind: "none" } },
              { long: "manifest-path", desc: "specify path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
              { long: "check", desc: "run rustfmt in check mode" },
          ],
          after_dashdash: { kind: "none", repeat: true } },
        { name: "generate-lockfile", desc: "generate the lockfile for a package",
          flags: [
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ] },
        { name: "help", desc: "display help for a cargo command",
          args: [ { kind: "values", values: [
                "add", "bench", "build", "check", "clean", "config", "doc",
                "fetch", "fix", "generate-lockfile", "help", "info", "init",
                "install", "locate-project", "login", "logout", "metadata", "new",
                "owner", "package", "pkgid", "publish", "remove", "report", "run",
                "rustc", "rustdoc", "search", "test", "tree", "uninstall",
                "update", "vendor", "version", "yank",
            ] } ] },
        { name: "info", desc: "display information about a package",
          flags: [
              { long: "registry", desc: "registry to search packages in",
                arg: { kind: "none" } },
          ],
          args: [ { kind: "none" } ] },
        { name: "locate-project",
          desc: "print a JSON representation of Cargo.toml's location",
          flags: [
              { long: "workspace",
                desc: "locate the Cargo.toml of the workspace root" },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ] },
        { name: "login", desc: "log in to a registry",
          flags: [
              { long: "registry", desc: "registry to use",
                arg: { kind: "none" } },
          ],
          after_dashdash: { kind: "none", repeat: true } },
        { name: "logout", desc: "remove an API token from the registry locally",
          flags: [
              { long: "registry", desc: "registry to use",
                arg: { kind: "none" } },
          ] },
        { name: "metadata",
          desc: "output resolved dependencies in machine-readable form",
          flags: [
              { long: "filter-platform",
                desc: "only dependencies matching this target triple",
                arg: { kind: "none" } },
              { long: "no-deps",
                desc: "only workspace members; do not fetch dependencies" },
              { long: "format-version", desc: "format version",
                arg: { kind: "values", values: ["1"] } },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "all-features", desc: "activate all features" },
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ] },
        { name: "owner", desc: "manage the owners of a crate on the registry",
          flags: [
              { long: "add", short: "a",
                desc: "a user or team to invite as an owner",
                arg: { kind: "none" } },
              { long: "remove", short: "r",
                desc: "a user or team to remove as an owner",
                arg: { kind: "none" } },
              { long: "list", short: "l", desc: "list owners of a crate" },
              { long: "registry", desc: "registry to modify owners for",
                arg: { kind: "none" } },
              { long: "token", desc: "API token to use when authenticating",
                arg: { kind: "none" } },
          ],
          args: [ { kind: "none" } ] },
        { name: "package",
          desc: "assemble the package into a distributable tarball",
          flags: [
              { long: "registry", desc: "registry to prepare the package for",
                arg: { kind: "none" } },
              { long: "list", short: "l",
                desc: "print files included in a package without making one" },
              { long: "no-verify",
                desc: "don't verify the contents by building them" },
              { long: "no-metadata", desc: "ignore warnings about missing metadata" },
              { long: "allow-dirty", desc: "allow a dirty working directory" },
              { long: "package", short: "p", desc: "package(s) to assemble",
                arg: { kind: "none" } },
              { long: "workspace", desc: "all packages in the workspace" },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "all-features", desc: "activate all features" },
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "target", desc: "build for the target triple",
                arg: { kind: "none" } },
              { long: "target-dir", desc: "directory for generated artifacts",
                arg: { kind: "dir" } },
              { long: "jobs", short: "j", desc: "number of parallel jobs",
                arg: { kind: "none" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ] },
        { name: "pkgid", desc: "print a fully qualified package specification",
          flags: [
              { long: "package", short: "p",
                desc: "argument to get the package ID specifier for",
                arg: { kind: "none" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ],
          args: [ { kind: "none" } ] },
        { name: "read-manifest",
          desc: "DEPRECATED: print a Cargo.toml manifest as JSON",
          flags: [
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ] },
        { name: "report", desc: "generate and display various kinds of reports",
          subcommands: [
              { name: "future-incompatibilities",
                desc: "crates which will eventually stop compiling",
                flags: [
                    { long: "id", desc: "identifier of the report of an invocation",
                      arg: { kind: "none" } },
                    { long: "package", short: "p",
                      desc: "package to display a report for",
                      arg: { kind: "none" } },
                ] },
              { name: "timings",
                desc: "build timings of previous sessions (unstable)",
                flags: [
                    { long: "open", desc: "opens the timing report in a browser" },
                    { long: "id", desc: "session ID to report on",
                      arg: { kind: "none" } },
                    { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                      arg: { kind: "path", ext: ["toml"] } },
                ] },
              { name: "sessions", desc: "the previous sessions (unstable)",
                flags: [
                    { long: "limit", desc: "limit the number of results",
                      arg: { kind: "none" } },
                    { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                      arg: { kind: "path", ext: ["toml"] } },
                ] },
              { name: "rebuilds",
                desc: "rebuild reasons from previous sessions (unstable)",
                flags: [
                    { long: "id", desc: "session ID to report on",
                      arg: { kind: "none" } },
                    { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                      arg: { kind: "path", ext: ["toml"] } },
                ] },
          ] },
        { name: "rustc", desc: "compile a package, passing extra options to rustc",
          flags: [
              { long: "print", desc: "output compiler information without compiling",
                arg: { kind: "none" } },
              { long: "crate-type",
                desc: "comma separated crate types for the compiler to emit",
                arg: { kind: "none" } },
              { long: "package", short: "p", desc: "package to build",
                arg: { kind: "none" } },
              { long: "lib", desc: "only this package's library" },
              { long: "bin", desc: "build only the specified binary",
                arg: { kind: "none" } },
              { long: "example", desc: "build only the specified example",
                arg: { kind: "none" } },
              { long: "tests", desc: "all targets with `test = true`" },
              { long: "test", desc: "build only the specified test target",
                arg: { kind: "none" } },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "all-features", desc: "activate all features" },
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "jobs", short: "j", desc: "number of parallel jobs",
                arg: { kind: "none" } },
              { long: "release", short: "r",
                desc: "release mode, with optimizations" },
              { long: "profile", desc: "use the specified profile",
                arg: { kind: "none" } },
              { long: "target", desc: "target triple which compiles will be for",
                arg: { kind: "none" } },
              { long: "target-dir", desc: "directory for generated artifacts",
                arg: { kind: "dir" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ],
          args: [ { kind: "none", repeat: true } ],
          after_dashdash: { kind: "none", repeat: true } },
        { name: "rustdoc",
          desc: "build a package's documentation with custom flags",
          flags: [
              { long: "open",
                desc: "opens the docs in a browser after the operation" },
              { long: "package", short: "p", desc: "package to document",
                arg: { kind: "none" } },
              { long: "lib", desc: "only this package's library" },
              { long: "bin", desc: "build only the specified binary",
                arg: { kind: "none" } },
              { long: "example", desc: "build only the specified example",
                arg: { kind: "none" } },
              { long: "tests", desc: "all targets with `test = true`" },
              { long: "test", desc: "build only the specified test target",
                arg: { kind: "none" } },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "all-features", desc: "activate all features" },
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "jobs", short: "j", desc: "number of parallel jobs",
                arg: { kind: "none" } },
              { long: "release", short: "r",
                desc: "release mode, with optimizations" },
              { long: "profile", desc: "use the specified profile",
                arg: { kind: "none" } },
              { long: "target", desc: "build for the target triple",
                arg: { kind: "none" } },
              { long: "target-dir", desc: "directory for generated artifacts",
                arg: { kind: "dir" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ],
          args: [ { kind: "none", repeat: true } ],
          after_dashdash: { kind: "none", repeat: true } },
        { name: "tree", desc: "display a tree visualization of a dependency graph",
          flags: [
              { long: "edges", short: "e",
                desc: "the kinds of dependencies to display",
                arg: { kind: "values", values: [
                    "all", "normal", "build", "dev", "features", "public",
                    "no-normal", "no-build", "no-dev", "no-proc-macro",
                ] } },
              { long: "invert", short: "i",
                desc: "invert the tree and focus on the given package",
                arg: { kind: "none" } },
              { long: "prune", desc: "prune the given package from the tree",
                arg: { kind: "none" } },
              { long: "depth", desc: "maximum display depth of the dependency tree",
                arg: { kind: "none" } },
              { long: "prefix", desc: "how each entry is indented",
                arg: { kind: "values", values: ["depth", "indent", "none"] } },
              { long: "no-dedupe",
                desc: "do not de-duplicate (repeats all shared dependencies)" },
              { long: "duplicates", short: "d",
                desc: "show only dependencies with multiple versions" },
              { long: "charset", desc: "character set to use in output",
                arg: { kind: "values", values: ["utf8", "ascii"] } },
              { long: "format", short: "f",
                desc: "format string used for printing dependencies",
                arg: { kind: "none" } },
              { long: "package", short: "p",
                desc: "package to be used as the root of the tree",
                arg: { kind: "none" } },
              { long: "workspace",
                desc: "display the tree for all workspace packages" },
              { long: "features", short: "F", desc: "features to activate",
                arg: { kind: "none" } },
              { long: "all-features", desc: "activate all features" },
              { long: "no-default-features", desc: "disable the `default` feature" },
              { long: "target",
                desc: "filter dependencies by target triple (or `all`)",
                arg: { kind: "none" } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ] },
        { name: "vendor", desc: "vendor all dependencies for a project locally",
          flags: [
              { long: "no-delete",
                desc: "don't delete older crates in the vendor directory" },
              { long: "sync", short: "s",
                desc: "additional `Cargo.toml` to sync and vendor",
                arg: { kind: "path", ext: ["toml"] } },
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ],
          args: [ { kind: "dir" } ] },
        { name: "verify-project",
          desc: "DEPRECATED: check correctness of crate manifest",
          flags: [
              { long: "manifest-path", short: "m", desc: "path to Cargo.toml",
                arg: { kind: "path", ext: ["toml"] } },
          ] },
        { name: "version", desc: "show version information" },
        { name: "yank", desc: "remove a pushed crate from the index",
          flags: [
              { long: "version", desc: "the version to yank or un-yank",
                arg: { kind: "none" } },
              { long: "undo",
                desc: "undo a yank, putting a version back in the index" },
              { long: "registry", desc: "registry to yank from",
                arg: { kind: "none" } },
              { long: "token", desc: "API token to use when authenticating",
                arg: { kind: "none" } },
          ],
          args: [ { kind: "none" } ] },
    ],
}
