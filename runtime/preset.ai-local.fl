# yew AI preset — LOCAL models (ollama).
#
# Nothing in this file causes anything to leave your machine: every request
# goes to a loopback socket. Load with :ai preset local or import this file.
# Requires: ollama serve; ollama pull qwen2.5-coder:7b

import ai

ai.backend("local", {
    kind: "ollama",
    url: "http://127.0.0.1:11434",
    model: "qwen2.5-coder:7b",
    stream: true,
})

set({
    "ai.enable": true,
    "ai.backend": "local",
    "shadow.ai_debounce_ms": 250,
    "ai.context_bytes": 4096,
    "ai.max_tokens": 256,
    "ai.max_lines": 8,
    "ai.temperature": 10,
    "ai.fim": "auto",
})

# Redaction remains enabled; loopback hits may be elided by policy.
