# Quiver Light — yew's default light theme.  Every semantic attr is explicit.
{
    theme: 1,
    name: "quiver-light",
    kind: "light",
    palette: {
        bg: "#ffffff", fg: "#24292f", red: "#cf222e",
        blue: "#0550ae", brown: "#953800", green: "#116329",
        violet: "#8250df", magenta: "#bf3989", gold: "#9a6700",
        grey: "#6a737d",
    },
    ui: {
        bg: "@bg", fg: "@fg",
        sel: { bg: "#dbeafe", mono: "reverse" },
        cursor: { bg: "@fg", fg: "@bg", mono: "reverse" },
        "cursor.secondary": { reverse: true, mono: "reverse" },
        gutter: { fg: "#8c959f" },
        "gutter.cursor": { fg: "@fg", bold: true, mono: "bold" },
        "mode.line": { bg: "@blue", fg: "@bg", mono: "bold" },
        "mode.word": { bg: "@green", fg: "@bg", mono: "bold" },
        "mode.block": { bg: "@violet", fg: "@bg", mono: "bold" },
        "mode.highlight": { bg: "@gold", fg: "@bg", mono: "bold" },
        "mode.insert": { bg: "@green", fg: "@bg", mono: "bold" },
        "mode.explore": { bg: "@brown", fg: "@bg", mono: "bold" },
        "mode.git": { bg: "@magenta", fg: "@bg", mono: "bold" },
        # Compatibility for configurations that still reference the old role.
        "mode.fuss": { bg: "@red", fg: "@bg", mono: "bold" },
        "git.staged": { fg: "@green", mono: "bold" },
        "git.modified": { fg: "@red", mono: "bold" },
        "git.untracked": { fg: "@grey", mono: "dim" },
        "git.incoming": { fg: "@blue", mono: "underline" },
        "git.conflict": { fg: "@red", bold: true, mono: "bold" },
        "git.ignored": { fg: "@grey", mono: "dim" },
        "search.match": { bg: "#fff8c5", mono: "bold" },
        "search.current": { bg: "#f2cc60", fg: "@fg", mono: "underline" },
        "shadow.index": { fg: "@blue", mono: "dim" },
        "shadow.lsp": { fg: "@violet", mono: "italic" },
        "shadow.ai": { fg: "@brown", mono: "underline" },
        "compl.word": { fg: "@fg", mono: "plain" },
        "compl.func": { fg: "@blue", mono: "bold" },
        "compl.type": { fg: "@brown", mono: "bold" },
        "compl.macro": { fg: "@gold", mono: "plain" },
        "compl.keyword": { fg: "@red", mono: "dim" },
        "lsp.hover_range": { bg: "#dbeafe", underline: true, mono: "underline" },
        "lsp.highlight_read": { bg: "#dbeafe", underline: true, mono: "underline" },
        "lsp.highlight_write": { bg: "#fce7f3", bold: true, mono: "bold" },
        "diag.error": { fg: "@red", mono: "bold" },
        "diag.warn": { fg: "@gold", mono: "bold" },
        "diag.info": { fg: "@blue", mono: "underline" },
        "diag.hint": { fg: "@green", mono: "plain" },
        "diag.unnecessary": { fg: "#6a737d", dim: true, mono: "dim" },
        "diag.deprecated": { fg: "@brown", strike: true, mono: "dim" },
        ul: { error: "#a40e26", warn: "#9a6700", info: "#0550ae" },
    },
    attrs: {
        text:               { fg: "#24292f", mono: "plain" },
        keyword:            { fg: "#cf222e", mono: "bold" },
        "keyword.control":  { fg: "#cf222e", bold: true, mono: "bold" },
        "keyword.op":       { fg: "#0550ae", mono: "bold" },
        "keyword.storage":  { fg: "#cf222e", italic: true, mono: "italic" },
        type:               { fg: "#953800", mono: "plain" },
        "type.builtin":     { fg: "#953800", italic: true, mono: "italic" },
        constant:           { fg: "#0550ae", mono: "plain" },
        "constant.builtin": { fg: "#0550ae", bold: true, mono: "bold" },
        number:             { fg: "#0550ae", mono: "plain" },
        boolean:            { fg: "#0550ae", bold: true, mono: "bold" },
        character:          { fg: "#0a3069", mono: "plain" },
        string:             { fg: "#0a3069", mono: "plain" },
        "string.escape":    { fg: "#1b7c83", mono: "bold" },
        "string.interp":    { fg: "#bf3989", mono: "bold" },
        "string.special":   { fg: "#0a3069", italic: true, mono: "italic" },
        comment:            { fg: "#6a737d", italic: true, mono: "italic" },
        "comment.doc":      { fg: "#57606a", italic: true, mono: "italic" },
        "comment.todo":     { fg: "#9a6700", bold: true, mono: "reverse" },
        function:           { fg: "#8250df", mono: "plain" },
        "function.builtin": { fg: "#8250df", italic: true, mono: "italic" },
        "function.macro":   { fg: "#8250df", bold: true, mono: "bold" },
        method:             { fg: "#8250df", mono: "plain" },
        variable:           { fg: "#24292f", mono: "plain" },
        "variable.builtin": { fg: "#cf222e", italic: true, mono: "italic" },
        "variable.param":   { fg: "#24292f", italic: true, mono: "italic" },
        "variable.member":  { fg: "#116329", mono: "plain" },
        namespace:          { fg: "#953800", mono: "plain" },
        label:              { fg: "#bf3989", mono: "underline" },
        attribute:          { fg: "#9a6700", mono: "plain" },
        preproc:            { fg: "#cf222e", mono: "bold" },
        operator:           { fg: "#0550ae", mono: "plain" },
        punct:              { fg: "#57606a", mono: "plain" },
        "punct.bracket":    { fg: "#57606a", mono: "plain" },
        "punct.delim":      { fg: "#57606a", mono: "plain" },
        tag:                { fg: "#116329", mono: "bold" },
        "tag.attr":         { fg: "#8250df", mono: "plain" },
        heading:            { fg: "#0550ae", bold: true, mono: "bold" },
        link:               { fg: "#0550ae", underline: true, mono: "underline" },
        emphasis:           { fg: "#24292f", italic: true, mono: "italic" },
        strong:             { fg: "#24292f", bold: true, mono: "bold" },
        code:               { fg: "#116329", mono: "plain" },
        list:               { fg: "#cf222e", mono: "bold" },
        quote:              { fg: "#6a737d", italic: true, mono: "italic" },
        "diff.add":         { fg: "#116329", mono: "plain" },
        "diff.del":         { fg: "#cf222e", mono: "plain" },
        error:              { fg: "#a40e26", bold: true, undercurl: true,
                              ul: "error", mono: "reverse" },
        warning:            { fg: "#9a6700", undercurl: true,
                              ul: "warn", mono: "underline" },
        "whitespace.special": { fg: "#d0d7de", mono: "plain" },
        "motion.unit":      { fg: "#cf222e", bold: true, mono: "bold" },
        "motion.arrow":     { fg: "#0550ae", mono: "plain" },
        "motion.count":     { fg: "#0550ae", mono: "plain" },
        "motion.cmd":       { fg: "#8250df", mono: "plain" },
        "ui.invisible":     { fg: "#d0d7de", mono: "plain" },
    },
}
