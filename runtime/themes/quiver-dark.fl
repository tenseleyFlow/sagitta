# Quiver Dark — yew's default dark theme.  Every semantic attr is explicit.
{
    theme: 1,
    name: "quiver-dark",
    kind: "dark",
    palette: {
        bg: "#12141a", fg: "#c8ccd4", violet: "#c678dd",
        cyan: "#56b6c2", yellow: "#e5c07b", orange: "#d19a66",
        green: "#98c379", blue: "#61afef", red: "#e06c75",
    },
    ui: {
        bg: "@bg", fg: "@fg",
        sel: { bg: "#2c313a", mono: "reverse" },
        cursor: { bg: "@fg", fg: "@bg", mono: "reverse" },
        "cursor.secondary": { reverse: true, mono: "reverse" },
        gutter: { fg: "#4b5263" },
        "gutter.cursor": { fg: "@fg", bold: true, mono: "bold" },
        "mode.line": { bg: "@blue", fg: "@bg", mono: "bold" },
        "mode.word": { bg: "@cyan", fg: "@bg", mono: "bold" },
        "mode.block": { bg: "@violet", fg: "@bg", mono: "bold" },
        "mode.highlight": { bg: "@yellow", fg: "@bg", mono: "bold" },
        "mode.insert": { bg: "@green", fg: "@bg", mono: "bold" },
        "mode.explore": { bg: "@orange", fg: "@bg", mono: "bold" },
        "mode.fuss": { bg: "@red", fg: "@bg", mono: "bold" },
        "search.match": { bg: "#3e4451", mono: "bold" },
        "search.current": { bg: "@yellow", fg: "@bg", mono: "underline" },
        "shadow.index": { fg: "@blue", mono: "dim" },
        "shadow.lsp": { fg: "@violet", mono: "italic" },
        "shadow.ai": { fg: "@orange", mono: "underline" },
        "compl.word": { fg: "@fg", mono: "plain" },
        "compl.func": { fg: "@blue", mono: "bold" },
        "compl.type": { fg: "@yellow", mono: "bold" },
        "compl.macro": { fg: "@orange", mono: "plain" },
        "compl.keyword": { fg: "@violet", mono: "dim" },
        "lsp.hover_range": { bg: "#2c313a", underline: true, mono: "underline" },
        "diag.error": { fg: "@red", mono: "bold" },
        "diag.warn": { fg: "@yellow", mono: "bold" },
        "diag.info": { fg: "@blue", mono: "underline" },
        "diag.hint": { fg: "@cyan", mono: "plain" },
        "diag.unnecessary": { fg: "#5c6370", dim: true, mono: "dim" },
        "diag.deprecated": { fg: "@orange", strike: true, mono: "dim" },
        ul: { error: "#ff5f5f", warn: "#e5c07b", info: "#61afef" },
    },
    attrs: {
        text:               { fg: "#c8ccd4", mono: "plain" },
        keyword:            { fg: "#c678dd", mono: "plain" },
        "keyword.control":  { fg: "#c678dd", bold: true, mono: "bold" },
        "keyword.op":       { fg: "#56b6c2", mono: "plain" },
        "keyword.storage":  { fg: "#c678dd", italic: true, mono: "italic" },
        type:               { fg: "#e5c07b", mono: "plain" },
        "type.builtin":     { fg: "#e5c07b", italic: true, mono: "italic" },
        constant:           { fg: "#d19a66", mono: "plain" },
        "constant.builtin": { fg: "#d19a66", bold: true, mono: "bold" },
        number:             { fg: "#d19a66", mono: "plain" },
        boolean:            { fg: "#d19a66", bold: true, mono: "bold" },
        character:          { fg: "#98c379", mono: "plain" },
        string:             { fg: "#98c379", mono: "plain" },
        "string.escape":    { fg: "#56b6c2", mono: "plain" },
        "string.interp":    { fg: "#ff79c6", mono: "plain" },
        "string.special":   { fg: "#98c379", italic: true, mono: "italic" },
        comment:            { fg: "#5c6370", italic: true, mono: "italic" },
        "comment.doc":      { fg: "#7f8c98", italic: true, mono: "italic" },
        "comment.todo":     { fg: "#e5c07b", bold: true, mono: "reverse" },
        function:           { fg: "#61afef", mono: "plain" },
        "function.builtin": { fg: "#61afef", italic: true, mono: "italic" },
        "function.macro":   { fg: "#61afef", bold: true, mono: "bold" },
        method:             { fg: "#61afef", mono: "plain" },
        variable:           { fg: "#c8ccd4", mono: "plain" },
        "variable.builtin": { fg: "#e06c75", italic: true, mono: "italic" },
        "variable.param":   { fg: "#c8ccd4", italic: true, mono: "italic" },
        "variable.member":  { fg: "#e06c75", mono: "plain" },
        namespace:          { fg: "#e5c07b", mono: "plain" },
        label:              { fg: "#ff79c6", mono: "underline" },
        attribute:          { fg: "#e5c07b", mono: "plain" },
        preproc:            { fg: "#c678dd", mono: "plain" },
        operator:           { fg: "#56b6c2", mono: "plain" },
        punct:              { fg: "#9aa0aa", mono: "plain" },
        "punct.bracket":    { fg: "#9aa0aa", mono: "plain" },
        "punct.delim":      { fg: "#9aa0aa", mono: "plain" },
        tag:                { fg: "#e06c75", mono: "bold" },
        "tag.attr":         { fg: "#d19a66", mono: "plain" },
        heading:            { fg: "#61afef", bold: true, mono: "bold" },
        link:               { fg: "#56b6c2", underline: true, mono: "underline" },
        emphasis:           { fg: "#c8ccd4", italic: true, mono: "italic" },
        strong:             { fg: "#c8ccd4", bold: true, mono: "bold" },
        code:               { fg: "#98c379", mono: "plain" },
        list:               { fg: "#c678dd", mono: "plain" },
        quote:              { fg: "#5c6370", italic: true, mono: "italic" },
        "diff.add":         { fg: "#98c379", mono: "plain" },
        "diff.del":         { fg: "#e06c75", mono: "plain" },
        error:              { fg: "#ff5f5f", bold: true, undercurl: true,
                              ul: "error", mono: "reverse" },
        warning:            { fg: "#e5c07b", undercurl: true,
                              ul: "warn", mono: "underline" },
        "whitespace.special": { fg: "#3a3f4b", mono: "plain" },
        "motion.unit":      { fg: "#c678dd", bold: true, mono: "bold" },
        "motion.arrow":     { fg: "#56b6c2", mono: "plain" },
        "motion.count":     { fg: "#d19a66", mono: "plain" },
        "motion.cmd":       { fg: "#61afef", mono: "plain" },
        "ui.invisible":     { fg: "#3a3f4b", mono: "plain" },
    },
}
