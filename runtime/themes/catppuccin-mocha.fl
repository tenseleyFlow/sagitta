# THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
# IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
# FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
# AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
# LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
# OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
# SOFTWARE.
{
    theme: 1,
    name: "catppuccin-mocha",
    kind: "dark",
    palette: {
        bg: "#1e1e2e", fg: "#cdd6f4", violet: "#cba6f7",
        cyan: "#94e2d5", yellow: "#f9e2af", orange: "#fab387",
        green: "#a6e3a1", blue: "#89b4fa", red: "#f38ba8",
        magenta: "#f5c2e7", grey: "#7f849c",
    },
    ui: {
        bg: "@bg", fg: "@fg",
        sel: { bg: "#45475a", mono: "reverse" },
        cursor: { bg: "@fg", fg: "@bg", mono: "reverse" },
        "cursor.secondary": { reverse: true, mono: "reverse" },
        gutter: { fg: "#7f849c" },
        "gutter.cursor": { fg: "@fg", bold: true, mono: "bold" },
        "tab.bar": { bg: "#181825", fg: "@grey", mono: "plain" },
        "tab.active": { bg: "#45475a", fg: "@fg", bold: true, mono: "reverse" },
        "tab.inactive": { bg: "#181825", fg: "@grey", mono: "plain" },
        "tab.modified": { bg: "#181825", fg: "@yellow", bold: true, mono: "bold" },
        "tab.orphan": { bg: "#181825", fg: "@grey", dim: true, mono: "dim" },
        "tab.add": { bg: "#181825", fg: "@blue", bold: true, mono: "bold" },
        # Context menus (s57.13 §6).  `menu.surface` paints the box and its
        # border; the widget itself knows no colours.
        "menu.surface": { bg: "#181825", fg: "#7f849c", mono: "plain" },
        "menu.row": { fg: "@fg", mono: "plain" },
        "menu.hover": { bg: "#45475a", fg: "@fg", bold: true, mono: "reverse" },
        "menu.disabled": { fg: "@grey", dim: true, mono: "dim" },
        "menu.accel": { fg: "@grey", mono: "dim" },
        "menu.sep": { fg: "#7f849c", mono: "dim" },
        # Input modals share one surface; other roles change ink/weight only.
        "modal.surface": { bg: "#181825", fg: "@fg", mono: "plain" },
        "modal.title": { fg: "@blue", bold: true, mono: "bold" },
        "modal.detail": { fg: "#a6adc8", mono: "plain" },
        "modal.border": { fg: "#7f849c", mono: "plain" },
        "modal.key": { fg: "@blue", bold: true, mono: "bold" },
        "modal.selection": { bg: "#45475a", fg: "@blue", bold: true, mono: "reverse" },
        "mode.line": { bg: "@blue", fg: "@bg", mono: "bold" },
        "mode.word": { bg: "@cyan", fg: "@bg", mono: "bold" },
        "mode.block": { bg: "@violet", fg: "@bg", mono: "bold" },
        "mode.highlight": { bg: "@yellow", fg: "@bg", mono: "bold" },
        "mode.insert": { bg: "@green", fg: "@bg", mono: "bold" },
        "mode.explore": { bg: "@orange", fg: "@bg", mono: "bold" },
        "mode.git": { bg: "@magenta", fg: "@bg", mono: "bold" },
        # Compatibility for configurations that still reference the old role.
        "mode.fuss": { bg: "@red", fg: "@bg", mono: "bold" },
        "git.drawer": { bg: "#181825", fg: "@fg" },
        "git.drawer.edge": { fg: "#a6adc8", bold: true, mono: "bold" },
        "git.staged": { fg: "@green", mono: "bold" },
        "git.modified": { fg: "@red", mono: "bold" },
        "git.untracked": { fg: "@grey", mono: "dim" },
        "git.incoming": { fg: "@blue", mono: "underline" },
        "git.conflict": { fg: "@red", bold: true, mono: "bold" },
        "git.ignored": { fg: "@grey", mono: "dim" },
        "git.blame": { fg: "@grey", dim: true, mono: "dim" },
        "git.blame.stale": { fg: "#45475a", dim: true, mono: "dim" },
        "git.sign.add": { fg: "@green", mono: "bold" },
        "git.sign.mod": { fg: "@yellow", mono: "bold" },
        "git.sign.del": { fg: "@red", mono: "bold" },
        "git.sign.conflict": { fg: "@magenta", mono: "bold" },
        "git.sign.unknown": { fg: "@grey", dim: true, mono: "dim" },
        "git.diff.add": { bg: "#2e363c", fg: "@green", mono: "bold" },
        "git.diff.del": { bg: "#382b3d", fg: "@red", mono: "bold" },
        "git.diff.mod": { bg: "#38363d", fg: "@yellow", mono: "bold" },
        "git.diff.filler": { fg: "@grey", dim: true, mono: "dim" },
        "git.diff.intra.add": { bg: "#404f4b", fg: "@green", mono: "reverse" },
        "git.diff.intra.del": { bg: "#53394d", fg: "@red", mono: "reverse" },
        "search.match": { bg: "#45475a", mono: "bold" },
        "search.current": { bg: "@yellow", fg: "@bg", mono: "underline" },
        "shadow.index": { fg: "@blue", mono: "dim" },
        "shadow.lsp": { fg: "@violet", mono: "italic" },
        "shadow.ai": { fg: "@orange", mono: "underline" },
        "compl.word": { fg: "@fg", mono: "plain" },
        "compl.func": { fg: "@blue", mono: "bold" },
        "compl.type": { fg: "@yellow", mono: "bold" },
        "compl.macro": { fg: "@orange", mono: "plain" },
        "compl.keyword": { fg: "@violet", mono: "dim" },
        "lsp.hover_range": { bg: "#45475a", underline: true, mono: "underline" },
        "lsp.highlight_read": { bg: "#45475a", underline: true, mono: "underline" },
        "lsp.highlight_write": { bg: "#493446", bold: true, mono: "bold" },
        "diag.error": { fg: "@red", mono: "bold" },
        "diag.warn": { fg: "@yellow", mono: "bold" },
        "diag.info": { fg: "@blue", mono: "underline" },
        "diag.hint": { fg: "@cyan", mono: "plain" },
        "diag.unnecessary": { fg: "#7f849c", dim: true, mono: "dim" },
        "diag.deprecated": { fg: "@orange", strike: true, mono: "dim" },
        ul: { error: "#f38ba8", warn: "#f9e2af", info: "#89b4fa" },
    },
    attrs: {
        text:               { fg: "#cdd6f4", mono: "plain" },
        keyword:            { fg: "#cba6f7", mono: "plain" },
        "keyword.control":  { fg: "#cba6f7", bold: true, mono: "bold" },
        "keyword.op":       { fg: "#94e2d5", mono: "plain" },
        "keyword.storage":  { fg: "#cba6f7", italic: true, mono: "italic" },
        type:               { fg: "#f9e2af", mono: "plain" },
        "type.builtin":     { fg: "#f9e2af", italic: true, mono: "italic" },
        constant:           { fg: "#fab387", mono: "plain" },
        "constant.builtin": { fg: "#fab387", bold: true, mono: "bold" },
        number:             { fg: "#fab387", mono: "plain" },
        boolean:            { fg: "#fab387", bold: true, mono: "bold" },
        character:          { fg: "#a6e3a1", mono: "plain" },
        string:             { fg: "#a6e3a1", mono: "plain" },
        "string.escape":    { fg: "#94e2d5", mono: "plain" },
        "string.interp":    { fg: "#f5c2e7", mono: "plain" },
        "string.special":   { fg: "#a6e3a1", italic: true, mono: "italic" },
        comment:            { fg: "#7f849c", italic: true, mono: "italic" },
        "comment.doc":      { fg: "#a6adc8", italic: true, mono: "italic" },
        "comment.todo":     { fg: "#f9e2af", bold: true, mono: "reverse" },
        function:           { fg: "#89b4fa", mono: "plain" },
        "function.builtin": { fg: "#89b4fa", italic: true, mono: "italic" },
        "function.macro":   { fg: "#89b4fa", bold: true, mono: "bold" },
        method:             { fg: "#89b4fa", mono: "plain" },
        variable:           { fg: "#cdd6f4", mono: "plain" },
        "variable.builtin": { fg: "#f38ba8", italic: true, mono: "italic" },
        "variable.param":   { fg: "#cdd6f4", italic: true, mono: "italic" },
        "variable.member":  { fg: "#f38ba8", mono: "plain" },
        namespace:          { fg: "#f9e2af", mono: "plain" },
        label:              { fg: "#f5c2e7", mono: "underline" },
        attribute:          { fg: "#f9e2af", mono: "plain" },
        preproc:            { fg: "#cba6f7", mono: "plain" },
        operator:           { fg: "#94e2d5", mono: "plain" },
        punct:              { fg: "#a6adc8", mono: "plain" },
        "punct.bracket":    { fg: "#a6adc8", mono: "plain" },
        "punct.delim":      { fg: "#a6adc8", mono: "plain" },
        tag:                { fg: "#f38ba8", mono: "bold" },
        "tag.attr":         { fg: "#fab387", mono: "plain" },
        heading:            { fg: "#89b4fa", bold: true, mono: "bold" },
        link:               { fg: "#94e2d5", underline: true, mono: "underline" },
        emphasis:           { fg: "#cdd6f4", italic: true, mono: "italic" },
        strong:             { fg: "#cdd6f4", bold: true, mono: "bold" },
        code:               { fg: "#a6e3a1", mono: "plain" },
        list:               { fg: "#cba6f7", mono: "plain" },
        quote:              { fg: "#7f849c", italic: true, mono: "italic" },
        "diff.add":         { fg: "#a6e3a1", mono: "plain" },
        "diff.del":         { fg: "#f38ba8", mono: "plain" },
        error:              { fg: "#f38ba8", bold: true, undercurl: true,
                              ul: "error", mono: "reverse" },
        warning:            { fg: "#f9e2af", undercurl: true,
                              ul: "warn", mono: "underline" },
        "whitespace.special": { fg: "#45475a", mono: "plain" },
        "motion.unit":      { fg: "#cba6f7", bold: true, mono: "bold" },
        "motion.arrow":     { fg: "#94e2d5", mono: "plain" },
        "motion.count":     { fg: "#fab387", mono: "plain" },
        "motion.cmd":       { fg: "#89b4fa", mono: "plain" },
        "ui.invisible":     { fg: "#45475a", mono: "plain" },
    },
}
