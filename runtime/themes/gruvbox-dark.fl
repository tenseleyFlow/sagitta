# of this software and associated documentation files (the "Software"), to deal
# in the Software without restriction, including without limitation the rights
# to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
# copies of the Software, and to permit persons to whom the Software is
# furnished to do so, subject to the following conditions:
# 
# The above copyright notice and this permission notice shall be included in all
# copies or substantial portions of the Software.
# 
# THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
# IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
# FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
# AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
# LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
# OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
# SOFTWARE.
{
    theme: 1,
    name: "gruvbox-dark",
    kind: "dark",
    palette: {
        bg: "#282828", fg: "#ebdbb2", violet: "#d3869b",
        cyan: "#8ec07c", yellow: "#fabd2f", orange: "#fe8019",
        green: "#b8bb26", blue: "#83a598", red: "#fb4934",
        magenta: "#d3869b", grey: "#928374",
    },
    ui: {
        bg: "@bg", fg: "@fg",
        sel: { bg: "#504945", mono: "reverse" },
        cursor: { bg: "@fg", fg: "@bg", mono: "reverse" },
        "cursor.secondary": { reverse: true, mono: "reverse" },
        gutter: { fg: "#928374" },
        "gutter.cursor": { fg: "@fg", bold: true, mono: "bold" },
        "tab.bar": { bg: "#3c3836", fg: "@grey", mono: "plain" },
        "tab.active": { bg: "#504945", fg: "@fg", bold: true, mono: "reverse" },
        "tab.inactive": { bg: "#3c3836", fg: "@grey", mono: "plain" },
        "tab.modified": { bg: "#3c3836", fg: "@yellow", bold: true, mono: "bold" },
        "tab.orphan": { bg: "#3c3836", fg: "@grey", dim: true, mono: "dim" },
        "tab.add": { bg: "#3c3836", fg: "@blue", bold: true, mono: "bold" },
        # Context menus (s57.13 §6).  `menu.surface` paints the box and its
        # border; the widget itself knows no colours.
        "menu.surface": { bg: "#3c3836", fg: "#928374", mono: "plain" },
        "menu.row": { fg: "@fg", mono: "plain" },
        "menu.hover": { bg: "#504945", fg: "@fg", bold: true, mono: "reverse" },
        "menu.disabled": { fg: "@grey", dim: true, mono: "dim" },
        "menu.accel": { fg: "@grey", mono: "dim" },
        "menu.sep": { fg: "#928374", mono: "dim" },
        # Input modals share one surface; other roles change ink/weight only.
        "modal.surface": { bg: "#3c3836", fg: "@fg", mono: "plain" },
        "modal.title": { fg: "@blue", bold: true, mono: "bold" },
        "modal.detail": { fg: "#bdae93", mono: "plain" },
        "modal.border": { fg: "#928374", mono: "plain" },
        "modal.key": { fg: "@blue", bold: true, mono: "bold" },
        "modal.selection": { bg: "#504945", fg: "@blue", bold: true, mono: "reverse" },
        "mode.line": { bg: "@blue", fg: "@bg", mono: "bold" },
        "mode.word": { bg: "@cyan", fg: "@bg", mono: "bold" },
        "mode.block": { bg: "@violet", fg: "@bg", mono: "bold" },
        "mode.highlight": { bg: "@yellow", fg: "@bg", mono: "bold" },
        "mode.insert": { bg: "@green", fg: "@bg", mono: "bold" },
        "mode.explore": { bg: "@orange", fg: "@bg", mono: "bold" },
        "mode.git": { bg: "@magenta", fg: "@bg", mono: "bold" },
        # Compatibility for configurations that still reference the old role.
        "mode.fuss": { bg: "@red", fg: "@bg", mono: "bold" },
        "git.drawer": { bg: "#3c3836", fg: "@fg" },
        "git.drawer.edge": { fg: "#bdae93", bold: true, mono: "bold" },
        "git.staged": { fg: "@green", mono: "bold" },
        "git.modified": { fg: "@red", mono: "bold" },
        "git.untracked": { fg: "@grey", mono: "dim" },
        "git.incoming": { fg: "@blue", mono: "underline" },
        "git.conflict": { fg: "@red", bold: true, mono: "bold" },
        "git.ignored": { fg: "@grey", mono: "dim" },
        "git.blame": { fg: "@grey", dim: true, mono: "dim" },
        "git.blame.stale": { fg: "#504945", dim: true, mono: "dim" },
        "git.sign.add": { fg: "@green", mono: "bold" },
        "git.sign.mod": { fg: "@yellow", mono: "bold" },
        "git.sign.del": { fg: "@red", mono: "bold" },
        "git.sign.conflict": { fg: "@magenta", mono: "bold" },
        "git.sign.unknown": { fg: "@grey", dim: true, mono: "dim" },
        "git.diff.add": { bg: "#393a28", fg: "@green", mono: "bold" },
        "git.diff.del": { bg: "#412c29", fg: "@red", mono: "bold" },
        "git.diff.mod": { bg: "#413a29", fg: "@yellow", mono: "bold" },
        "git.diff.filler": { fg: "@grey", dim: true, mono: "dim" },
        "git.diff.intra.add": { bg: "#4c4d28", fg: "@green", mono: "reverse" },
        "git.diff.intra.del": { bg: "#5d302b", fg: "@red", mono: "reverse" },
        "search.match": { bg: "#504945", mono: "bold" },
        "search.current": { bg: "@yellow", fg: "@bg", mono: "underline" },
        "shadow.index": { fg: "@blue", mono: "dim" },
        "shadow.lsp": { fg: "@violet", mono: "italic" },
        "shadow.ai": { fg: "@orange", mono: "underline" },
        "compl.word": { fg: "@fg", mono: "plain" },
        "compl.func": { fg: "@blue", mono: "bold" },
        "compl.type": { fg: "@yellow", mono: "bold" },
        "compl.macro": { fg: "@orange", mono: "plain" },
        "compl.keyword": { fg: "@violet", mono: "dim" },
        "lsp.hover_range": { bg: "#504945", underline: true, mono: "underline" },
        "lsp.highlight_read": { bg: "#504945", underline: true, mono: "underline" },
        "lsp.highlight_write": { bg: "#522f2a", bold: true, mono: "bold" },
        "diag.error": { fg: "@red", mono: "bold" },
        "diag.warn": { fg: "@yellow", mono: "bold" },
        "diag.info": { fg: "@blue", mono: "underline" },
        "diag.hint": { fg: "@cyan", mono: "plain" },
        "diag.unnecessary": { fg: "#928374", dim: true, mono: "dim" },
        "diag.deprecated": { fg: "@orange", strike: true, mono: "dim" },
        ul: { error: "#fb4934", warn: "#fabd2f", info: "#83a598" },
    },
    attrs: {
        text:               { fg: "#ebdbb2", mono: "plain" },
        keyword:            { fg: "#d3869b", mono: "plain" },
        "keyword.control":  { fg: "#d3869b", bold: true, mono: "bold" },
        "keyword.op":       { fg: "#8ec07c", mono: "plain" },
        "keyword.storage":  { fg: "#d3869b", italic: true, mono: "italic" },
        type:               { fg: "#fabd2f", mono: "plain" },
        "type.builtin":     { fg: "#fabd2f", italic: true, mono: "italic" },
        constant:           { fg: "#fe8019", mono: "plain" },
        "constant.builtin": { fg: "#fe8019", bold: true, mono: "bold" },
        number:             { fg: "#fe8019", mono: "plain" },
        boolean:            { fg: "#fe8019", bold: true, mono: "bold" },
        character:          { fg: "#b8bb26", mono: "plain" },
        string:             { fg: "#b8bb26", mono: "plain" },
        "string.escape":    { fg: "#8ec07c", mono: "plain" },
        "string.interp":    { fg: "#d3869b", mono: "plain" },
        "string.special":   { fg: "#b8bb26", italic: true, mono: "italic" },
        comment:            { fg: "#928374", italic: true, mono: "italic" },
        "comment.doc":      { fg: "#bdae93", italic: true, mono: "italic" },
        "comment.todo":     { fg: "#fabd2f", bold: true, mono: "reverse" },
        function:           { fg: "#83a598", mono: "plain" },
        "function.builtin": { fg: "#83a598", italic: true, mono: "italic" },
        "function.macro":   { fg: "#83a598", bold: true, mono: "bold" },
        method:             { fg: "#83a598", mono: "plain" },
        variable:           { fg: "#ebdbb2", mono: "plain" },
        "variable.builtin": { fg: "#fb4934", italic: true, mono: "italic" },
        "variable.param":   { fg: "#ebdbb2", italic: true, mono: "italic" },
        "variable.member":  { fg: "#fb4934", mono: "plain" },
        namespace:          { fg: "#fabd2f", mono: "plain" },
        label:              { fg: "#d3869b", mono: "underline" },
        attribute:          { fg: "#fabd2f", mono: "plain" },
        preproc:            { fg: "#d3869b", mono: "plain" },
        operator:           { fg: "#8ec07c", mono: "plain" },
        punct:              { fg: "#bdae93", mono: "plain" },
        "punct.bracket":    { fg: "#bdae93", mono: "plain" },
        "punct.delim":      { fg: "#bdae93", mono: "plain" },
        tag:                { fg: "#fb4934", mono: "bold" },
        "tag.attr":         { fg: "#fe8019", mono: "plain" },
        heading:            { fg: "#83a598", bold: true, mono: "bold" },
        link:               { fg: "#8ec07c", underline: true, mono: "underline" },
        emphasis:           { fg: "#ebdbb2", italic: true, mono: "italic" },
        strong:             { fg: "#ebdbb2", bold: true, mono: "bold" },
        code:               { fg: "#b8bb26", mono: "plain" },
        list:               { fg: "#d3869b", mono: "plain" },
        quote:              { fg: "#928374", italic: true, mono: "italic" },
        "diff.add":         { fg: "#b8bb26", mono: "plain" },
        "diff.del":         { fg: "#fb4934", mono: "plain" },
        error:              { fg: "#fb4934", bold: true, undercurl: true,
                              ul: "error", mono: "reverse" },
        warning:            { fg: "#fabd2f", undercurl: true,
                              ul: "warn", mono: "underline" },
        "whitespace.special": { fg: "#504945", mono: "plain" },
        "motion.unit":      { fg: "#d3869b", bold: true, mono: "bold" },
        "motion.arrow":     { fg: "#8ec07c", mono: "plain" },
        "motion.count":     { fg: "#fe8019", mono: "plain" },
        "motion.cmd":       { fg: "#83a598", mono: "plain" },
        "ui.invisible":     { fg: "#504945", mono: "plain" },
    },
}
