# solarized-dark: yew adaptation of Solarized's palette.
# Palette: https://github.com/altercation/solarized
# UI role mappings and subtle diff tints are yew adaptations.
#
# Copyright (c) 2011 Ethan Schoonover
# 
# Permission is hereby granted, free of charge, to any person obtaining a copy
# of this software and associated documentation files (the "Software"), to deal
# in the Software without restriction, including without limitation the rights
# to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
# copies of the Software, and to permit persons to whom the Software is
# furnished to do so, subject to the following conditions:
# 
# The above copyright notice and this permission notice shall be included in
# all copies or substantial portions of the Software.
# 
# THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
# IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
# FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
# AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
# LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
# OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
# THE SOFTWARE.
{
    theme: 1,
    name: "solarized-dark",
    kind: "dark",
    palette: {
        bg: "#002b36", fg: "#839496", violet: "#6c71c4",
        cyan: "#2aa198", yellow: "#b58900", orange: "#cb4b16",
        green: "#859900", blue: "#268bd2", red: "#dc322f",
        magenta: "#d33682", grey: "#586e75",
    },
    ui: {
        bg: "@bg", fg: "@fg",
        sel: { bg: "#586e75", mono: "reverse" },
        cursor: { bg: "@fg", fg: "@bg", mono: "reverse" },
        "cursor.secondary": { reverse: true, mono: "reverse" },
        gutter: { fg: "#586e75" },
        "gutter.cursor": { fg: "@fg", bold: true, mono: "bold" },
        "tab.bar": { bg: "#073642", fg: "@grey", mono: "plain" },
        "tab.active": { bg: "#586e75", fg: "@fg", bold: true, mono: "reverse" },
        "tab.inactive": { bg: "#073642", fg: "@grey", mono: "plain" },
        "tab.modified": { bg: "#073642", fg: "@yellow", bold: true, mono: "bold" },
        "tab.orphan": { bg: "#073642", fg: "@grey", dim: true, mono: "dim" },
        "tab.add": { bg: "#073642", fg: "@blue", bold: true, mono: "bold" },
        # Context menus (s57.13 §6).  `menu.surface` paints the box and its
        # border; the widget itself knows no colours.
        "menu.surface": { bg: "#073642", fg: "#586e75", mono: "plain" },
        "menu.row": { fg: "@fg", mono: "plain" },
        "menu.hover": { bg: "#586e75", fg: "@fg", bold: true, mono: "reverse" },
        "menu.disabled": { fg: "@grey", dim: true, mono: "dim" },
        "menu.accel": { fg: "@grey", mono: "dim" },
        "menu.sep": { fg: "#586e75", mono: "dim" },
        # Input modals share one surface; other roles change ink/weight only.
        "modal.surface": { bg: "#073642", fg: "@fg", mono: "plain" },
        "modal.title": { fg: "@blue", bold: true, mono: "bold" },
        "modal.detail": { fg: "#93a1a1", mono: "plain" },
        "modal.border": { fg: "#586e75", mono: "plain" },
        "modal.key": { fg: "@blue", bold: true, mono: "bold" },
        "modal.selection": { bg: "#586e75", fg: "@blue", bold: true, mono: "reverse" },
        "mode.line": { bg: "@blue", fg: "@bg", mono: "bold" },
        "mode.word": { bg: "@cyan", fg: "@bg", mono: "bold" },
        "mode.block": { bg: "@violet", fg: "@bg", mono: "bold" },
        "mode.highlight": { bg: "@yellow", fg: "@bg", mono: "bold" },
        "mode.insert": { bg: "@green", fg: "@bg", mono: "bold" },
        "mode.explore": { bg: "@orange", fg: "@bg", mono: "bold" },
        "mode.git": { bg: "@magenta", fg: "@bg", mono: "bold" },
        # Compatibility for configurations that still reference the old role.
        "mode.fuss": { bg: "@red", fg: "@bg", mono: "bold" },
        "git.drawer": { bg: "#073642", fg: "@fg" },
        "git.drawer.edge": { fg: "#93a1a1", bold: true, mono: "bold" },
        "git.staged": { fg: "@green", mono: "bold" },
        "git.modified": { fg: "@red", mono: "bold" },
        "git.untracked": { fg: "@grey", mono: "dim" },
        "git.incoming": { fg: "@blue", mono: "underline" },
        "git.conflict": { fg: "@red", bold: true, mono: "bold" },
        "git.ignored": { fg: "@grey", mono: "dim" },
        "git.blame": { fg: "@grey", dim: true, mono: "dim" },
        "git.blame.stale": { fg: "#586e75", dim: true, mono: "dim" },
        "git.sign.add": { fg: "@green", mono: "bold" },
        "git.sign.mod": { fg: "@yellow", mono: "bold" },
        "git.sign.del": { fg: "@red", mono: "bold" },
        "git.sign.conflict": { fg: "@magenta", mono: "bold" },
        "git.sign.unknown": { fg: "@grey", dim: true, mono: "dim" },
        "git.diff.add": { bg: "#103830", fg: "@green", mono: "bold" },
        "git.diff.del": { bg: "#1a2c35", fg: "@red", mono: "bold" },
        "git.diff.mod": { bg: "#163630", fg: "@yellow", mono: "bold" },
        "git.diff.filler": { fg: "@grey", dim: true, mono: "dim" },
        "git.diff.intra.add": { bg: "#214729", fg: "@green", mono: "reverse" },
        "git.diff.intra.del": { bg: "#372d34", fg: "@red", mono: "reverse" },
        "search.match": { bg: "#586e75", mono: "bold" },
        "search.current": { bg: "@yellow", fg: "@bg", mono: "underline" },
        "shadow.index": { fg: "@blue", mono: "dim" },
        "shadow.lsp": { fg: "@violet", mono: "italic" },
        "shadow.ai": { fg: "@orange", mono: "underline" },
        "compl.word": { fg: "@fg", mono: "plain" },
        "compl.func": { fg: "@blue", mono: "bold" },
        "compl.type": { fg: "@yellow", mono: "bold" },
        "compl.macro": { fg: "@orange", mono: "plain" },
        "compl.keyword": { fg: "@violet", mono: "dim" },
        "lsp.hover_range": { bg: "#586e75", underline: true, mono: "underline" },
        "lsp.highlight_read": { bg: "#586e75", underline: true, mono: "underline" },
        "lsp.highlight_write": { bg: "#2c2c35", bold: true, mono: "bold" },
        "diag.error": { fg: "@red", mono: "bold" },
        "diag.warn": { fg: "@yellow", mono: "bold" },
        "diag.info": { fg: "@blue", mono: "underline" },
        "diag.hint": { fg: "@cyan", mono: "plain" },
        "diag.unnecessary": { fg: "#586e75", dim: true, mono: "dim" },
        "diag.deprecated": { fg: "@orange", strike: true, mono: "dim" },
        ul: { error: "#dc322f", warn: "#b58900", info: "#268bd2" },
    },
    attrs: {
        text:               { fg: "#839496", mono: "plain" },
        keyword:            { fg: "#6c71c4", mono: "plain" },
        "keyword.control":  { fg: "#6c71c4", bold: true, mono: "bold" },
        "keyword.op":       { fg: "#2aa198", mono: "plain" },
        "keyword.storage":  { fg: "#6c71c4", italic: true, mono: "italic" },
        type:               { fg: "#b58900", mono: "plain" },
        "type.builtin":     { fg: "#b58900", italic: true, mono: "italic" },
        constant:           { fg: "#cb4b16", mono: "plain" },
        "constant.builtin": { fg: "#cb4b16", bold: true, mono: "bold" },
        number:             { fg: "#cb4b16", mono: "plain" },
        boolean:            { fg: "#cb4b16", bold: true, mono: "bold" },
        character:          { fg: "#859900", mono: "plain" },
        string:             { fg: "#859900", mono: "plain" },
        "string.escape":    { fg: "#2aa198", mono: "plain" },
        "string.interp":    { fg: "#d33682", mono: "plain" },
        "string.special":   { fg: "#859900", italic: true, mono: "italic" },
        comment:            { fg: "#586e75", italic: true, mono: "italic" },
        "comment.doc":      { fg: "#93a1a1", italic: true, mono: "italic" },
        "comment.todo":     { fg: "#b58900", bold: true, mono: "reverse" },
        function:           { fg: "#268bd2", mono: "plain" },
        "function.builtin": { fg: "#268bd2", italic: true, mono: "italic" },
        "function.macro":   { fg: "#268bd2", bold: true, mono: "bold" },
        method:             { fg: "#268bd2", mono: "plain" },
        variable:           { fg: "#839496", mono: "plain" },
        "variable.builtin": { fg: "#dc322f", italic: true, mono: "italic" },
        "variable.param":   { fg: "#839496", italic: true, mono: "italic" },
        "variable.member":  { fg: "#dc322f", mono: "plain" },
        namespace:          { fg: "#b58900", mono: "plain" },
        label:              { fg: "#d33682", mono: "underline" },
        attribute:          { fg: "#b58900", mono: "plain" },
        preproc:            { fg: "#6c71c4", mono: "plain" },
        operator:           { fg: "#2aa198", mono: "plain" },
        punct:              { fg: "#93a1a1", mono: "plain" },
        "punct.bracket":    { fg: "#93a1a1", mono: "plain" },
        "punct.delim":      { fg: "#93a1a1", mono: "plain" },
        tag:                { fg: "#dc322f", mono: "bold" },
        "tag.attr":         { fg: "#cb4b16", mono: "plain" },
        heading:            { fg: "#268bd2", bold: true, mono: "bold" },
        link:               { fg: "#2aa198", underline: true, mono: "underline" },
        emphasis:           { fg: "#839496", italic: true, mono: "italic" },
        strong:             { fg: "#839496", bold: true, mono: "bold" },
        code:               { fg: "#859900", mono: "plain" },
        list:               { fg: "#6c71c4", mono: "plain" },
        quote:              { fg: "#586e75", italic: true, mono: "italic" },
        "diff.add":         { fg: "#859900", mono: "plain" },
        "diff.del":         { fg: "#dc322f", mono: "plain" },
        error:              { fg: "#dc322f", bold: true, undercurl: true,
                              ul: "error", mono: "reverse" },
        warning:            { fg: "#b58900", undercurl: true,
                              ul: "warn", mono: "underline" },
        "whitespace.special": { fg: "#586e75", mono: "plain" },
        "motion.unit":      { fg: "#6c71c4", bold: true, mono: "bold" },
        "motion.arrow":     { fg: "#2aa198", mono: "plain" },
        "motion.count":     { fg: "#cb4b16", mono: "plain" },
        "motion.cmd":       { fg: "#268bd2", mono: "plain" },
        "ui.invisible":     { fg: "#586e75", mono: "plain" },
    },
}
