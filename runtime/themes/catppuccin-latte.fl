# copies of the Software, and to permit persons to whom the Software is
# furnished to do so, subject to the following conditions:
# 
# The above copyright notice and this permission notice shall be included in all
# copies or substantial portions of the Software.
# 
# THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
# IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
# FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
# AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
# LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
# OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
# SOFTWARE.
{
    theme: 1,
    name: "catppuccin-latte",
    kind: "light",
    palette: {
        bg: "#eff1f5", fg: "#4c4f69", violet: "#8839ef",
        cyan: "#179299", yellow: "#df8e1d", orange: "#fe640b",
        green: "#40a02b", blue: "#1e66f5", red: "#d20f39",
        magenta: "#ea76cb", grey: "#7c7f93",
    },
    ui: {
        bg: "@bg", fg: "@fg",
        sel: { bg: "#ccd0da", mono: "reverse" },
        cursor: { bg: "@fg", fg: "@bg", mono: "reverse" },
        "cursor.secondary": { reverse: true, mono: "reverse" },
        gutter: { fg: "#7c7f93" },
        "gutter.cursor": { fg: "@fg", bold: true, mono: "bold" },
        "tab.bar": { bg: "#e6e9ef", fg: "@grey", mono: "plain" },
        "tab.active": { bg: "#ccd0da", fg: "@fg", bold: true, mono: "reverse" },
        "tab.inactive": { bg: "#e6e9ef", fg: "@grey", mono: "plain" },
        "tab.modified": { bg: "#e6e9ef", fg: "@yellow", bold: true, mono: "bold" },
        "tab.orphan": { bg: "#e6e9ef", fg: "@grey", dim: true, mono: "dim" },
        "tab.add": { bg: "#e6e9ef", fg: "@blue", bold: true, mono: "bold" },
        # Context menus (s57.13 §6).  `menu.surface` paints the box and its
        # border; the widget itself knows no colours.
        "menu.surface": { bg: "#e6e9ef", fg: "#7c7f93", mono: "plain" },
        "menu.row": { fg: "@fg", mono: "plain" },
        "menu.hover": { bg: "#ccd0da", fg: "@fg", bold: true, mono: "reverse" },
        "menu.disabled": { fg: "@grey", dim: true, mono: "dim" },
        "menu.accel": { fg: "@grey", mono: "dim" },
        "menu.sep": { fg: "#7c7f93", mono: "dim" },
        # Input modals share one surface; other roles change ink/weight only.
        "modal.surface": { bg: "#e6e9ef", fg: "@fg", mono: "plain" },
        "modal.title": { fg: "@blue", bold: true, mono: "bold" },
        "modal.detail": { fg: "#6c6f85", mono: "plain" },
        "modal.border": { fg: "#7c7f93", mono: "plain" },
        "modal.key": { fg: "@blue", bold: true, mono: "bold" },
        "modal.selection": { bg: "#ccd0da", fg: "@blue", bold: true, mono: "reverse" },
        "mode.line": { bg: "@blue", fg: "@bg", mono: "bold" },
        "mode.word": { bg: "@cyan", fg: "@bg", mono: "bold" },
        "mode.block": { bg: "@violet", fg: "@bg", mono: "bold" },
        "mode.highlight": { bg: "@yellow", fg: "@bg", mono: "bold" },
        "mode.insert": { bg: "@green", fg: "@bg", mono: "bold" },
        "mode.explore": { bg: "@orange", fg: "@bg", mono: "bold" },
        "mode.git": { bg: "@magenta", fg: "@bg", mono: "bold" },
        # Compatibility for configurations that still reference the old role.
        "mode.fuss": { bg: "@red", fg: "@bg", mono: "bold" },
        "git.drawer": { bg: "#e6e9ef", fg: "@fg" },
        "git.drawer.edge": { fg: "#6c6f85", bold: true, mono: "bold" },
        "git.staged": { fg: "@green", mono: "bold" },
        "git.modified": { fg: "@red", mono: "bold" },
        "git.untracked": { fg: "@grey", mono: "dim" },
        "git.incoming": { fg: "@blue", mono: "underline" },
        "git.conflict": { fg: "@red", bold: true, mono: "bold" },
        "git.ignored": { fg: "@grey", mono: "dim" },
        "git.blame": { fg: "@grey", dim: true, mono: "dim" },
        "git.blame.stale": { fg: "#ccd0da", dim: true, mono: "dim" },
        "git.sign.add": { fg: "@green", mono: "bold" },
        "git.sign.mod": { fg: "@yellow", mono: "bold" },
        "git.sign.del": { fg: "@red", mono: "bold" },
        "git.sign.conflict": { fg: "@magenta", mono: "bold" },
        "git.sign.unknown": { fg: "@grey", dim: true, mono: "dim" },
        "git.diff.add": { bg: "#dae7dd", fg: "@green", mono: "bold" },
        "git.diff.del": { bg: "#ecd6de", fg: "@red", mono: "bold" },
        "git.diff.mod": { bg: "#ede5db", fg: "@yellow", mono: "bold" },
        "git.diff.filler": { fg: "@grey", dim: true, mono: "dim" },
        "git.diff.intra.add": { bg: "#c3ddc3", fg: "@green", mono: "reverse" },
        "git.diff.intra.del": { bg: "#e8b9c6", fg: "@red", mono: "reverse" },
        "search.match": { bg: "#ccd0da", mono: "bold" },
        "search.current": { bg: "@yellow", fg: "@bg", mono: "underline" },
        "shadow.index": { fg: "@blue", mono: "dim" },
        "shadow.lsp": { fg: "@violet", mono: "italic" },
        "shadow.ai": { fg: "@orange", mono: "underline" },
        "compl.word": { fg: "@fg", mono: "plain" },
        "compl.func": { fg: "@blue", mono: "bold" },
        "compl.type": { fg: "@yellow", mono: "bold" },
        "compl.macro": { fg: "@orange", mono: "plain" },
        "compl.keyword": { fg: "@violet", mono: "dim" },
        "lsp.hover_range": { bg: "#ccd0da", underline: true, mono: "underline" },
        "lsp.highlight_read": { bg: "#ccd0da", underline: true, mono: "underline" },
        "lsp.highlight_write": { bg: "#e9c4cf", bold: true, mono: "bold" },
        "diag.error": { fg: "@red", mono: "bold" },
        "diag.warn": { fg: "@yellow", mono: "bold" },
        "diag.info": { fg: "@blue", mono: "underline" },
        "diag.hint": { fg: "@cyan", mono: "plain" },
        "diag.unnecessary": { fg: "#7c7f93", dim: true, mono: "dim" },
        "diag.deprecated": { fg: "@orange", strike: true, mono: "dim" },
        ul: { error: "#d20f39", warn: "#df8e1d", info: "#1e66f5" },
    },
    attrs: {
        text:               { fg: "#4c4f69", mono: "plain" },
        keyword:            { fg: "#8839ef", mono: "plain" },
        "keyword.control":  { fg: "#8839ef", bold: true, mono: "bold" },
        "keyword.op":       { fg: "#179299", mono: "plain" },
        "keyword.storage":  { fg: "#8839ef", italic: true, mono: "italic" },
        type:               { fg: "#df8e1d", mono: "plain" },
        "type.builtin":     { fg: "#df8e1d", italic: true, mono: "italic" },
        constant:           { fg: "#fe640b", mono: "plain" },
        "constant.builtin": { fg: "#fe640b", bold: true, mono: "bold" },
        number:             { fg: "#fe640b", mono: "plain" },
        boolean:            { fg: "#fe640b", bold: true, mono: "bold" },
        character:          { fg: "#40a02b", mono: "plain" },
        string:             { fg: "#40a02b", mono: "plain" },
        "string.escape":    { fg: "#179299", mono: "plain" },
        "string.interp":    { fg: "#ea76cb", mono: "plain" },
        "string.special":   { fg: "#40a02b", italic: true, mono: "italic" },
        comment:            { fg: "#7c7f93", italic: true, mono: "italic" },
        "comment.doc":      { fg: "#6c6f85", italic: true, mono: "italic" },
        "comment.todo":     { fg: "#df8e1d", bold: true, mono: "reverse" },
        function:           { fg: "#1e66f5", mono: "plain" },
        "function.builtin": { fg: "#1e66f5", italic: true, mono: "italic" },
        "function.macro":   { fg: "#1e66f5", bold: true, mono: "bold" },
        method:             { fg: "#1e66f5", mono: "plain" },
        variable:           { fg: "#4c4f69", mono: "plain" },
        "variable.builtin": { fg: "#d20f39", italic: true, mono: "italic" },
        "variable.param":   { fg: "#4c4f69", italic: true, mono: "italic" },
        "variable.member":  { fg: "#d20f39", mono: "plain" },
        namespace:          { fg: "#df8e1d", mono: "plain" },
        label:              { fg: "#ea76cb", mono: "underline" },
        attribute:          { fg: "#df8e1d", mono: "plain" },
        preproc:            { fg: "#8839ef", mono: "plain" },
        operator:           { fg: "#179299", mono: "plain" },
        punct:              { fg: "#6c6f85", mono: "plain" },
        "punct.bracket":    { fg: "#6c6f85", mono: "plain" },
        "punct.delim":      { fg: "#6c6f85", mono: "plain" },
        tag:                { fg: "#d20f39", mono: "bold" },
        "tag.attr":         { fg: "#fe640b", mono: "plain" },
        heading:            { fg: "#1e66f5", bold: true, mono: "bold" },
        link:               { fg: "#179299", underline: true, mono: "underline" },
        emphasis:           { fg: "#4c4f69", italic: true, mono: "italic" },
        strong:             { fg: "#4c4f69", bold: true, mono: "bold" },
        code:               { fg: "#40a02b", mono: "plain" },
        list:               { fg: "#8839ef", mono: "plain" },
        quote:              { fg: "#7c7f93", italic: true, mono: "italic" },
        "diff.add":         { fg: "#40a02b", mono: "plain" },
        "diff.del":         { fg: "#d20f39", mono: "plain" },
        error:              { fg: "#d20f39", bold: true, undercurl: true,
                              ul: "error", mono: "reverse" },
        warning:            { fg: "#df8e1d", undercurl: true,
                              ul: "warn", mono: "underline" },
        "whitespace.special": { fg: "#ccd0da", mono: "plain" },
        "motion.unit":      { fg: "#8839ef", bold: true, mono: "bold" },
        "motion.arrow":     { fg: "#179299", mono: "plain" },
        "motion.count":     { fg: "#fe640b", mono: "plain" },
        "motion.cmd":       { fg: "#1e66f5", mono: "plain" },
        "ui.invisible":     { fg: "#ccd0da", mono: "plain" },
    },
}
