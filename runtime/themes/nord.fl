{
    theme: 1,
    name: "nord",
    kind: "dark",
    palette: {
        bg: "#2e3440", fg: "#d8dee9", violet: "#b48ead",
        cyan: "#88c0d0", yellow: "#ebcb8b", orange: "#d08770",
        green: "#a3be8c", blue: "#81a1c1", red: "#bf616a",
        magenta: "#b48ead", grey: "#4c566a",
    },
    ui: {
        bg: "@bg", fg: "@fg",
        sel: { bg: "#434c5e", mono: "reverse" },
        cursor: { bg: "@fg", fg: "@bg", mono: "reverse" },
        "cursor.secondary": { reverse: true, mono: "reverse" },
        gutter: { fg: "#4c566a" },
        "gutter.cursor": { fg: "@fg", bold: true, mono: "bold" },
        "tab.bar": { bg: "#3b4252", fg: "@grey", mono: "plain" },
        "tab.active": { bg: "#434c5e", fg: "@fg", bold: true, mono: "reverse" },
        "tab.inactive": { bg: "#3b4252", fg: "@grey", mono: "plain" },
        "tab.modified": { bg: "#3b4252", fg: "@yellow", bold: true, mono: "bold" },
        "tab.orphan": { bg: "#3b4252", fg: "@grey", dim: true, mono: "dim" },
        "tab.add": { bg: "#3b4252", fg: "@blue", bold: true, mono: "bold" },
        # Context menus (s57.13 §6).  `menu.surface` paints the box and its
        # border; the widget itself knows no colours.
        "menu.surface": { bg: "#3b4252", fg: "#4c566a", mono: "plain" },
        "menu.row": { fg: "@fg", mono: "plain" },
        "menu.hover": { bg: "#434c5e", fg: "@fg", bold: true, mono: "reverse" },
        "menu.disabled": { fg: "@grey", dim: true, mono: "dim" },
        "menu.accel": { fg: "@grey", mono: "dim" },
        "menu.sep": { fg: "#4c566a", mono: "dim" },
        # Input modals share one surface; other roles change ink/weight only.
        "modal.surface": { bg: "#3b4252", fg: "@fg", mono: "plain" },
        "modal.title": { fg: "@blue", bold: true, mono: "bold" },
        "modal.detail": { fg: "#a5b1c2", mono: "plain" },
        "modal.border": { fg: "#4c566a", mono: "plain" },
        "modal.key": { fg: "@blue", bold: true, mono: "bold" },
        "modal.selection": { bg: "#434c5e", fg: "@blue", bold: true, mono: "reverse" },
        "mode.line": { bg: "@blue", fg: "@bg", mono: "bold" },
        "mode.word": { bg: "@cyan", fg: "@bg", mono: "bold" },
        "mode.block": { bg: "@violet", fg: "@bg", mono: "bold" },
        "mode.highlight": { bg: "@yellow", fg: "@bg", mono: "bold" },
        "mode.insert": { bg: "@green", fg: "@bg", mono: "bold" },
        "mode.explore": { bg: "@orange", fg: "@bg", mono: "bold" },
        "mode.git": { bg: "@magenta", fg: "@bg", mono: "bold" },
        # Compatibility for configurations that still reference the old role.
        "mode.fuss": { bg: "@red", fg: "@bg", mono: "bold" },
        "git.drawer": { bg: "#3b4252", fg: "@fg" },
        "git.drawer.edge": { fg: "#a5b1c2", bold: true, mono: "bold" },
        "git.staged": { fg: "@green", mono: "bold" },
        "git.modified": { fg: "@red", mono: "bold" },
        "git.untracked": { fg: "@grey", mono: "dim" },
        "git.incoming": { fg: "@blue", mono: "underline" },
        "git.conflict": { fg: "@red", bold: true, mono: "bold" },
        "git.ignored": { fg: "@grey", mono: "dim" },
        "git.blame": { fg: "@grey", dim: true, mono: "dim" },
        "git.blame.stale": { fg: "#434c5e", dim: true, mono: "dim" },
        "git.sign.add": { fg: "@green", mono: "bold" },
        "git.sign.mod": { fg: "@yellow", mono: "bold" },
        "git.sign.del": { fg: "@red", mono: "bold" },
        "git.sign.conflict": { fg: "@magenta", mono: "bold" },
        "git.sign.unknown": { fg: "@grey", dim: true, mono: "dim" },
        "git.diff.add": { bg: "#3c4549", fg: "@green", mono: "bold" },
        "git.diff.del": { bg: "#3f3945", fg: "@red", mono: "bold" },
        "git.diff.mod": { bg: "#454649", fg: "@yellow", mono: "bold" },
        "git.diff.filler": { fg: "@grey", dim: true, mono: "dim" },
        "git.diff.intra.add": { bg: "#4b5753", fg: "@green", mono: "reverse" },
        "git.diff.intra.del": { bg: "#523f4b", fg: "@red", mono: "reverse" },
        "search.match": { bg: "#434c5e", mono: "bold" },
        "search.current": { bg: "@yellow", fg: "@bg", mono: "underline" },
        "shadow.index": { fg: "@blue", mono: "dim" },
        "shadow.lsp": { fg: "@violet", mono: "italic" },
        "shadow.ai": { fg: "@orange", mono: "underline" },
        "compl.word": { fg: "@fg", mono: "plain" },
        "compl.func": { fg: "@blue", mono: "bold" },
        "compl.type": { fg: "@yellow", mono: "bold" },
        "compl.macro": { fg: "@orange", mono: "plain" },
        "compl.keyword": { fg: "@violet", mono: "dim" },
        "lsp.hover_range": { bg: "#434c5e", underline: true, mono: "underline" },
        "lsp.highlight_read": { bg: "#434c5e", underline: true, mono: "underline" },
        "lsp.highlight_write": { bg: "#4b3d48", bold: true, mono: "bold" },
        "diag.error": { fg: "@red", mono: "bold" },
        "diag.warn": { fg: "@yellow", mono: "bold" },
        "diag.info": { fg: "@blue", mono: "underline" },
        "diag.hint": { fg: "@cyan", mono: "plain" },
        "diag.unnecessary": { fg: "#4c566a", dim: true, mono: "dim" },
        "diag.deprecated": { fg: "@orange", strike: true, mono: "dim" },
        ul: { error: "#bf616a", warn: "#ebcb8b", info: "#81a1c1" },
    },
    attrs: {
        text:               { fg: "#d8dee9", mono: "plain" },
        keyword:            { fg: "#b48ead", mono: "plain" },
        "keyword.control":  { fg: "#b48ead", bold: true, mono: "bold" },
        "keyword.op":       { fg: "#88c0d0", mono: "plain" },
        "keyword.storage":  { fg: "#b48ead", italic: true, mono: "italic" },
        type:               { fg: "#ebcb8b", mono: "plain" },
        "type.builtin":     { fg: "#ebcb8b", italic: true, mono: "italic" },
        constant:           { fg: "#d08770", mono: "plain" },
        "constant.builtin": { fg: "#d08770", bold: true, mono: "bold" },
        number:             { fg: "#d08770", mono: "plain" },
        boolean:            { fg: "#d08770", bold: true, mono: "bold" },
        character:          { fg: "#a3be8c", mono: "plain" },
        string:             { fg: "#a3be8c", mono: "plain" },
        "string.escape":    { fg: "#88c0d0", mono: "plain" },
        "string.interp":    { fg: "#b48ead", mono: "plain" },
        "string.special":   { fg: "#a3be8c", italic: true, mono: "italic" },
        comment:            { fg: "#4c566a", italic: true, mono: "italic" },
        "comment.doc":      { fg: "#a5b1c2", italic: true, mono: "italic" },
        "comment.todo":     { fg: "#ebcb8b", bold: true, mono: "reverse" },
        function:           { fg: "#81a1c1", mono: "plain" },
        "function.builtin": { fg: "#81a1c1", italic: true, mono: "italic" },
        "function.macro":   { fg: "#81a1c1", bold: true, mono: "bold" },
        method:             { fg: "#81a1c1", mono: "plain" },
        variable:           { fg: "#d8dee9", mono: "plain" },
        "variable.builtin": { fg: "#bf616a", italic: true, mono: "italic" },
        "variable.param":   { fg: "#d8dee9", italic: true, mono: "italic" },
        "variable.member":  { fg: "#bf616a", mono: "plain" },
        namespace:          { fg: "#ebcb8b", mono: "plain" },
        label:              { fg: "#b48ead", mono: "underline" },
        attribute:          { fg: "#ebcb8b", mono: "plain" },
        preproc:            { fg: "#b48ead", mono: "plain" },
        operator:           { fg: "#88c0d0", mono: "plain" },
        punct:              { fg: "#a5b1c2", mono: "plain" },
        "punct.bracket":    { fg: "#a5b1c2", mono: "plain" },
        "punct.delim":      { fg: "#a5b1c2", mono: "plain" },
        tag:                { fg: "#bf616a", mono: "bold" },
        "tag.attr":         { fg: "#d08770", mono: "plain" },
        heading:            { fg: "#81a1c1", bold: true, mono: "bold" },
        link:               { fg: "#88c0d0", underline: true, mono: "underline" },
        emphasis:           { fg: "#d8dee9", italic: true, mono: "italic" },
        strong:             { fg: "#d8dee9", bold: true, mono: "bold" },
        code:               { fg: "#a3be8c", mono: "plain" },
        list:               { fg: "#b48ead", mono: "plain" },
        quote:              { fg: "#4c566a", italic: true, mono: "italic" },
        "diff.add":         { fg: "#a3be8c", mono: "plain" },
        "diff.del":         { fg: "#bf616a", mono: "plain" },
        error:              { fg: "#bf616a", bold: true, undercurl: true,
                              ul: "error", mono: "reverse" },
        warning:            { fg: "#ebcb8b", undercurl: true,
                              ul: "warn", mono: "underline" },
        "whitespace.special": { fg: "#434c5e", mono: "plain" },
        "motion.unit":      { fg: "#b48ead", bold: true, mono: "bold" },
        "motion.arrow":     { fg: "#88c0d0", mono: "plain" },
        "motion.count":     { fg: "#d08770", mono: "plain" },
        "motion.cmd":       { fg: "#81a1c1", mono: "plain" },
        "ui.invisible":     { fg: "#434c5e", mono: "plain" },
    },
}
