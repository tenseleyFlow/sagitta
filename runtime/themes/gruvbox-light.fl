# to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
# copies of the Software, and to permit persons to whom the Software is
# furnished to do so, subject to the following conditions:
# 
# The above copyright notice and this permission notice shall be included in all
# copies or substantial portions of the Software.
# 
# THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
# IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
# FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
# AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
# LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
# OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
# SOFTWARE.
{
    theme: 1,
    name: "gruvbox-light",
    kind: "light",
    palette: {
        bg: "#fbf1c7", fg: "#3c3836", violet: "#8f3f71",
        cyan: "#427b58", yellow: "#b57614", orange: "#af3a03",
        green: "#79740e", blue: "#076678", red: "#9d0006",
        magenta: "#8f3f71", grey: "#928374",
    },
    ui: {
        bg: "@bg", fg: "@fg",
        sel: { bg: "#d5c4a1", mono: "reverse" },
        cursor: { bg: "@fg", fg: "@bg", mono: "reverse" },
        "cursor.secondary": { reverse: true, mono: "reverse" },
        gutter: { fg: "#928374" },
        "gutter.cursor": { fg: "@fg", bold: true, mono: "bold" },
        "tab.bar": { bg: "#ebdbb2", fg: "@grey", mono: "plain" },
        "tab.active": { bg: "#d5c4a1", fg: "@fg", bold: true, mono: "reverse" },
        "tab.inactive": { bg: "#ebdbb2", fg: "@grey", mono: "plain" },
        "tab.modified": { bg: "#ebdbb2", fg: "@yellow", bold: true, mono: "bold" },
        "tab.orphan": { bg: "#ebdbb2", fg: "@grey", dim: true, mono: "dim" },
        "tab.add": { bg: "#ebdbb2", fg: "@blue", bold: true, mono: "bold" },
        # Context menus (s57.13 §6).  `menu.surface` paints the box and its
        # border; the widget itself knows no colours.
        "menu.surface": { bg: "#ebdbb2", fg: "#928374", mono: "plain" },
        "menu.row": { fg: "@fg", mono: "plain" },
        "menu.hover": { bg: "#d5c4a1", fg: "@fg", bold: true, mono: "reverse" },
        "menu.disabled": { fg: "@grey", dim: true, mono: "dim" },
        "menu.accel": { fg: "@grey", mono: "dim" },
        "menu.sep": { fg: "#928374", mono: "dim" },
        # Input modals share one surface; other roles change ink/weight only.
        "modal.surface": { bg: "#ebdbb2", fg: "@fg", mono: "plain" },
        "modal.title": { fg: "@blue", bold: true, mono: "bold" },
        "modal.detail": { fg: "#665c54", mono: "plain" },
        "modal.border": { fg: "#928374", mono: "plain" },
        "modal.key": { fg: "@blue", bold: true, mono: "bold" },
        "modal.selection": { bg: "#d5c4a1", fg: "@blue", bold: true, mono: "reverse" },
        "mode.line": { bg: "@blue", fg: "@bg", mono: "bold" },
        "mode.word": { bg: "@cyan", fg: "@bg", mono: "bold" },
        "mode.block": { bg: "@violet", fg: "@bg", mono: "bold" },
        "mode.highlight": { bg: "@yellow", fg: "@bg", mono: "bold" },
        "mode.insert": { bg: "@green", fg: "@bg", mono: "bold" },
        "mode.explore": { bg: "@orange", fg: "@bg", mono: "bold" },
        "mode.git": { bg: "@magenta", fg: "@bg", mono: "bold" },
        # Compatibility for configurations that still reference the old role.
        "mode.fuss": { bg: "@red", fg: "@bg", mono: "bold" },
        "git.drawer": { bg: "#ebdbb2", fg: "@fg" },
        "git.drawer.edge": { fg: "#665c54", bold: true, mono: "bold" },
        "git.staged": { fg: "@green", mono: "bold" },
        "git.modified": { fg: "@red", mono: "bold" },
        "git.untracked": { fg: "@grey", mono: "dim" },
        "git.incoming": { fg: "@blue", mono: "underline" },
        "git.conflict": { fg: "@red", bold: true, mono: "bold" },
        "git.ignored": { fg: "@grey", mono: "dim" },
        "git.blame": { fg: "@grey", dim: true, mono: "dim" },
        "git.blame.stale": { fg: "#d5c4a1", dim: true, mono: "dim" },
        "git.sign.add": { fg: "@green", mono: "bold" },
        "git.sign.mod": { fg: "@yellow", mono: "bold" },
        "git.sign.del": { fg: "@red", mono: "bold" },
        "git.sign.conflict": { fg: "@magenta", mono: "bold" },
        "git.sign.unknown": { fg: "@grey", dim: true, mono: "dim" },
        "git.diff.add": { bg: "#ebe2b1", fg: "@green", mono: "bold" },
        "git.diff.del": { bg: "#f0d4b0", fg: "@red", mono: "bold" },
        "git.diff.mod": { bg: "#f3e2b2", fg: "@yellow", mono: "bold" },
        "git.diff.filler": { fg: "@grey", dim: true, mono: "dim" },
        "git.diff.intra.add": { bg: "#dbd299", fg: "@green", mono: "reverse" },
        "git.diff.intra.del": { bg: "#e4b597", fg: "@red", mono: "reverse" },
        "search.match": { bg: "#d5c4a1", mono: "bold" },
        "search.current": { bg: "@yellow", fg: "@bg", mono: "underline" },
        "shadow.index": { fg: "@blue", mono: "dim" },
        "shadow.lsp": { fg: "@violet", mono: "italic" },
        "shadow.ai": { fg: "@orange", mono: "underline" },
        "compl.word": { fg: "@fg", mono: "plain" },
        "compl.func": { fg: "@blue", mono: "bold" },
        "compl.type": { fg: "@yellow", mono: "bold" },
        "compl.macro": { fg: "@orange", mono: "plain" },
        "compl.keyword": { fg: "@violet", mono: "dim" },
        "lsp.hover_range": { bg: "#d5c4a1", underline: true, mono: "underline" },
        "lsp.highlight_read": { bg: "#d5c4a1", underline: true, mono: "underline" },
        "lsp.highlight_write": { bg: "#e8c1a0", bold: true, mono: "bold" },
        "diag.error": { fg: "@red", mono: "bold" },
        "diag.warn": { fg: "@yellow", mono: "bold" },
        "diag.info": { fg: "@blue", mono: "underline" },
        "diag.hint": { fg: "@cyan", mono: "plain" },
        "diag.unnecessary": { fg: "#928374", dim: true, mono: "dim" },
        "diag.deprecated": { fg: "@orange", strike: true, mono: "dim" },
        ul: { error: "#9d0006", warn: "#b57614", info: "#076678" },
    },
    attrs: {
        text:               { fg: "#3c3836", mono: "plain" },
        keyword:            { fg: "#8f3f71", mono: "plain" },
        "keyword.control":  { fg: "#8f3f71", bold: true, mono: "bold" },
        "keyword.op":       { fg: "#427b58", mono: "plain" },
        "keyword.storage":  { fg: "#8f3f71", italic: true, mono: "italic" },
        type:               { fg: "#b57614", mono: "plain" },
        "type.builtin":     { fg: "#b57614", italic: true, mono: "italic" },
        constant:           { fg: "#af3a03", mono: "plain" },
        "constant.builtin": { fg: "#af3a03", bold: true, mono: "bold" },
        number:             { fg: "#af3a03", mono: "plain" },
        boolean:            { fg: "#af3a03", bold: true, mono: "bold" },
        character:          { fg: "#79740e", mono: "plain" },
        string:             { fg: "#79740e", mono: "plain" },
        "string.escape":    { fg: "#427b58", mono: "plain" },
        "string.interp":    { fg: "#8f3f71", mono: "plain" },
        "string.special":   { fg: "#79740e", italic: true, mono: "italic" },
        comment:            { fg: "#928374", italic: true, mono: "italic" },
        "comment.doc":      { fg: "#665c54", italic: true, mono: "italic" },
        "comment.todo":     { fg: "#b57614", bold: true, mono: "reverse" },
        function:           { fg: "#076678", mono: "plain" },
        "function.builtin": { fg: "#076678", italic: true, mono: "italic" },
        "function.macro":   { fg: "#076678", bold: true, mono: "bold" },
        method:             { fg: "#076678", mono: "plain" },
        variable:           { fg: "#3c3836", mono: "plain" },
        "variable.builtin": { fg: "#9d0006", italic: true, mono: "italic" },
        "variable.param":   { fg: "#3c3836", italic: true, mono: "italic" },
        "variable.member":  { fg: "#9d0006", mono: "plain" },
        namespace:          { fg: "#b57614", mono: "plain" },
        label:              { fg: "#8f3f71", mono: "underline" },
        attribute:          { fg: "#b57614", mono: "plain" },
        preproc:            { fg: "#8f3f71", mono: "plain" },
        operator:           { fg: "#427b58", mono: "plain" },
        punct:              { fg: "#665c54", mono: "plain" },
        "punct.bracket":    { fg: "#665c54", mono: "plain" },
        "punct.delim":      { fg: "#665c54", mono: "plain" },
        tag:                { fg: "#9d0006", mono: "bold" },
        "tag.attr":         { fg: "#af3a03", mono: "plain" },
        heading:            { fg: "#076678", bold: true, mono: "bold" },
        link:               { fg: "#427b58", underline: true, mono: "underline" },
        emphasis:           { fg: "#3c3836", italic: true, mono: "italic" },
        strong:             { fg: "#3c3836", bold: true, mono: "bold" },
        code:               { fg: "#79740e", mono: "plain" },
        list:               { fg: "#8f3f71", mono: "plain" },
        quote:              { fg: "#928374", italic: true, mono: "italic" },
        "diff.add":         { fg: "#79740e", mono: "plain" },
        "diff.del":         { fg: "#9d0006", mono: "plain" },
        error:              { fg: "#9d0006", bold: true, undercurl: true,
                              ul: "error", mono: "reverse" },
        warning:            { fg: "#b57614", undercurl: true,
                              ul: "warn", mono: "underline" },
        "whitespace.special": { fg: "#d5c4a1", mono: "plain" },
        "motion.unit":      { fg: "#8f3f71", bold: true, mono: "bold" },
        "motion.arrow":     { fg: "#427b58", mono: "plain" },
        "motion.count":     { fg: "#af3a03", mono: "plain" },
        "motion.cmd":       { fg: "#076678", mono: "plain" },
        "ui.invisible":     { fg: "#d5c4a1", mono: "plain" },
    },
}
