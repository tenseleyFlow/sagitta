{
    theme: 1,
    name: "dracula",
    kind: "dark",
    palette: {
        bg: "#282a36", fg: "#f8f8f2", violet: "#bd93f9",
        cyan: "#8be9fd", yellow: "#f1fa8c", orange: "#ffb86c",
        green: "#50fa7b", blue: "#bd93f9", red: "#ff5555",
        magenta: "#ff79c6", grey: "#6272a4",
    },
    ui: {
        bg: "@bg", fg: "@fg",
        sel: { bg: "#44475a", mono: "reverse" },
        cursor: { bg: "@fg", fg: "@bg", mono: "reverse" },
        "cursor.secondary": { reverse: true, mono: "reverse" },
        gutter: { fg: "#6272a4" },
        "gutter.cursor": { fg: "@fg", bold: true, mono: "bold" },
        "tab.bar": { bg: "#21222c", fg: "@grey", mono: "plain" },
        "tab.active": { bg: "#44475a", fg: "@fg", bold: true, mono: "reverse" },
        "tab.inactive": { bg: "#21222c", fg: "@grey", mono: "plain" },
        "tab.modified": { bg: "#21222c", fg: "@yellow", bold: true, mono: "bold" },
        "tab.orphan": { bg: "#21222c", fg: "@grey", dim: true, mono: "dim" },
        "tab.add": { bg: "#21222c", fg: "@blue", bold: true, mono: "bold" },
        # Context menus (s57.13 §6).  `menu.surface` paints the box and its
        # border; the widget itself knows no colours.
        "menu.surface": { bg: "#21222c", fg: "#6272a4", mono: "plain" },
        "menu.row": { fg: "@fg", mono: "plain" },
        "menu.hover": { bg: "#44475a", fg: "@fg", bold: true, mono: "reverse" },
        "menu.disabled": { fg: "@grey", dim: true, mono: "dim" },
        "menu.accel": { fg: "@grey", mono: "dim" },
        "menu.sep": { fg: "#6272a4", mono: "dim" },
        # Input modals share one surface; other roles change ink/weight only.
        "modal.surface": { bg: "#21222c", fg: "@fg", mono: "plain" },
        "modal.title": { fg: "@blue", bold: true, mono: "bold" },
        "modal.detail": { fg: "#bfbfbf", mono: "plain" },
        "modal.border": { fg: "#6272a4", mono: "plain" },
        "modal.key": { fg: "@blue", bold: true, mono: "bold" },
        "modal.selection": { bg: "#44475a", fg: "@blue", bold: true, mono: "reverse" },
        "mode.line": { bg: "@blue", fg: "@bg", mono: "bold" },
        "mode.word": { bg: "@cyan", fg: "@bg", mono: "bold" },
        "mode.block": { bg: "@violet", fg: "@bg", mono: "bold" },
        "mode.highlight": { bg: "@yellow", fg: "@bg", mono: "bold" },
        "mode.insert": { bg: "@green", fg: "@bg", mono: "bold" },
        "mode.explore": { bg: "@orange", fg: "@bg", mono: "bold" },
        "mode.git": { bg: "@magenta", fg: "@bg", mono: "bold" },
        # Compatibility for configurations that still reference the old role.
        "mode.fuss": { bg: "@red", fg: "@bg", mono: "bold" },
        "git.drawer": { bg: "#21222c", fg: "@fg" },
        "git.drawer.edge": { fg: "#bfbfbf", bold: true, mono: "bold" },
        "git.staged": { fg: "@green", mono: "bold" },
        "git.modified": { fg: "@red", mono: "bold" },
        "git.untracked": { fg: "@grey", mono: "dim" },
        "git.incoming": { fg: "@blue", mono: "underline" },
        "git.conflict": { fg: "@red", bold: true, mono: "bold" },
        "git.ignored": { fg: "@grey", mono: "dim" },
        "git.blame": { fg: "@grey", dim: true, mono: "dim" },
        "git.blame.stale": { fg: "#44475a", dim: true, mono: "dim" },
        "git.sign.add": { fg: "@green", mono: "bold" },
        "git.sign.mod": { fg: "@yellow", mono: "bold" },
        "git.sign.del": { fg: "@red", mono: "bold" },
        "git.sign.conflict": { fg: "@magenta", mono: "bold" },
        "git.sign.unknown": { fg: "@grey", dim: true, mono: "dim" },
        "git.diff.add": { bg: "#2d433e", fg: "@green", mono: "bold" },
        "git.diff.del": { bg: "#422f3a", fg: "@red", mono: "bold" },
        "git.diff.mod": { bg: "#404340", fg: "@yellow", mono: "bold" },
        "git.diff.filler": { fg: "@grey", dim: true, mono: "dim" },
        "git.diff.intra.add": { bg: "#325e47", fg: "@green", mono: "reverse" },
        "git.diff.intra.del": { bg: "#5e353e", fg: "@red", mono: "reverse" },
        "search.match": { bg: "#44475a", mono: "bold" },
        "search.current": { bg: "@yellow", fg: "@bg", mono: "underline" },
        "shadow.index": { fg: "@blue", mono: "dim" },
        "shadow.lsp": { fg: "@violet", mono: "italic" },
        "shadow.ai": { fg: "@orange", mono: "underline" },
        "compl.word": { fg: "@fg", mono: "plain" },
        "compl.func": { fg: "@blue", mono: "bold" },
        "compl.type": { fg: "@yellow", mono: "bold" },
        "compl.macro": { fg: "@orange", mono: "plain" },
        "compl.keyword": { fg: "@violet", mono: "dim" },
        "lsp.hover_range": { bg: "#44475a", underline: true, mono: "underline" },
        "lsp.highlight_read": { bg: "#44475a", underline: true, mono: "underline" },
        "lsp.highlight_write": { bg: "#53333c", bold: true, mono: "bold" },
        "diag.error": { fg: "@red", mono: "bold" },
        "diag.warn": { fg: "@yellow", mono: "bold" },
        "diag.info": { fg: "@blue", mono: "underline" },
        "diag.hint": { fg: "@cyan", mono: "plain" },
        "diag.unnecessary": { fg: "#6272a4", dim: true, mono: "dim" },
        "diag.deprecated": { fg: "@orange", strike: true, mono: "dim" },
        ul: { error: "#ff5555", warn: "#f1fa8c", info: "#bd93f9" },
    },
    attrs: {
        text:               { fg: "#f8f8f2", mono: "plain" },
        keyword:            { fg: "#bd93f9", mono: "plain" },
        "keyword.control":  { fg: "#bd93f9", bold: true, mono: "bold" },
        "keyword.op":       { fg: "#8be9fd", mono: "plain" },
        "keyword.storage":  { fg: "#bd93f9", italic: true, mono: "italic" },
        type:               { fg: "#f1fa8c", mono: "plain" },
        "type.builtin":     { fg: "#f1fa8c", italic: true, mono: "italic" },
        constant:           { fg: "#ffb86c", mono: "plain" },
        "constant.builtin": { fg: "#ffb86c", bold: true, mono: "bold" },
        number:             { fg: "#ffb86c", mono: "plain" },
        boolean:            { fg: "#ffb86c", bold: true, mono: "bold" },
        character:          { fg: "#50fa7b", mono: "plain" },
        string:             { fg: "#50fa7b", mono: "plain" },
        "string.escape":    { fg: "#8be9fd", mono: "plain" },
        "string.interp":    { fg: "#ff79c6", mono: "plain" },
        "string.special":   { fg: "#50fa7b", italic: true, mono: "italic" },
        comment:            { fg: "#6272a4", italic: true, mono: "italic" },
        "comment.doc":      { fg: "#bfbfbf", italic: true, mono: "italic" },
        "comment.todo":     { fg: "#f1fa8c", bold: true, mono: "reverse" },
        function:           { fg: "#bd93f9", mono: "plain" },
        "function.builtin": { fg: "#bd93f9", italic: true, mono: "italic" },
        "function.macro":   { fg: "#bd93f9", bold: true, mono: "bold" },
        method:             { fg: "#bd93f9", mono: "plain" },
        variable:           { fg: "#f8f8f2", mono: "plain" },
        "variable.builtin": { fg: "#ff5555", italic: true, mono: "italic" },
        "variable.param":   { fg: "#f8f8f2", italic: true, mono: "italic" },
        "variable.member":  { fg: "#ff5555", mono: "plain" },
        namespace:          { fg: "#f1fa8c", mono: "plain" },
        label:              { fg: "#ff79c6", mono: "underline" },
        attribute:          { fg: "#f1fa8c", mono: "plain" },
        preproc:            { fg: "#bd93f9", mono: "plain" },
        operator:           { fg: "#8be9fd", mono: "plain" },
        punct:              { fg: "#bfbfbf", mono: "plain" },
        "punct.bracket":    { fg: "#bfbfbf", mono: "plain" },
        "punct.delim":      { fg: "#bfbfbf", mono: "plain" },
        tag:                { fg: "#ff5555", mono: "bold" },
        "tag.attr":         { fg: "#ffb86c", mono: "plain" },
        heading:            { fg: "#bd93f9", bold: true, mono: "bold" },
        link:               { fg: "#8be9fd", underline: true, mono: "underline" },
        emphasis:           { fg: "#f8f8f2", italic: true, mono: "italic" },
        strong:             { fg: "#f8f8f2", bold: true, mono: "bold" },
        code:               { fg: "#50fa7b", mono: "plain" },
        list:               { fg: "#bd93f9", mono: "plain" },
        quote:              { fg: "#6272a4", italic: true, mono: "italic" },
        "diff.add":         { fg: "#50fa7b", mono: "plain" },
        "diff.del":         { fg: "#ff5555", mono: "plain" },
        error:              { fg: "#ff5555", bold: true, undercurl: true,
                              ul: "error", mono: "reverse" },
        warning:            { fg: "#f1fa8c", undercurl: true,
                              ul: "warn", mono: "underline" },
        "whitespace.special": { fg: "#44475a", mono: "plain" },
        "motion.unit":      { fg: "#bd93f9", bold: true, mono: "bold" },
        "motion.arrow":     { fg: "#8be9fd", mono: "plain" },
        "motion.count":     { fg: "#ffb86c", mono: "plain" },
        "motion.cmd":       { fg: "#bd93f9", mono: "plain" },
        "ui.invisible":     { fg: "#44475a", mono: "plain" },
    },
}
