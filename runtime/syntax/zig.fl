# Zig syntax.
#
# Builtins are recognized lexically as `@name`; container declarations mark
# only the declared identifier because field/type roles need parsing. Zig
# multiline-string lines are string.special from a leading `\\\\` through
# physical EOL, matching their real lexical lifetime.
{
    syntax: 1,
    language: { name: "zig", extensions: ["zig"], priority: 20,
                comment: { line: "//" } },
    contexts: {
        main: { default: "text", rules: [
            { match: "///.*$|//!.*$", attr: "comment.doc" }, { match: "//.*$", attr: "comment" },
            { match: "\\\\\\\\.*$", attr: "string.special" },
            { match: "c?\"", attr: "string", push: "string" }, { match: "'", attr: "character", push: "character" },
            { match: "@[A-Za-z_][A-Za-z0-9_]*", attr: "function.builtin" },
            { match: "\\b(const|var)\\s+([A-Za-z_][A-Za-z0-9_]*)", attr: "keyword.storage", captures: { 2: "variable" } },
            { match: "\\b(struct|enum|union|opaque)\\s*\\{", attr: "keyword.storage" },
            { match: "\\b(if|else|switch|while|for|break|continue|return|try|catch|orelse|defer|errdefer|unreachable)\\b", attr: "keyword.control" },
            { match: "\\b(align|allowzero|and|anyframe|anytype|asm|async|await|comptime|error|export|extern|fn|inline|linksection|noalias|nosuspend|or|packed|pub|resume|suspend|test|threadlocal|usingnamespace|volatile)\\b", attr: "keyword.storage" },
            { match: "\\b(bool|void|noreturn|type|anyerror|comptime_int|comptime_float|c_short|c_ushort|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_longdouble|anyopaque|usize|isize|u8|u16|u32|u64|u128|i8|i16|i32|i64|i128|f16|f32|f64|f80|f128)\\b", attr: "type.builtin" },
            { match: "\\b(true|false)\\b", attr: "boolean" }, { match: "\\b(null|undefined)\\b", attr: "constant.builtin" },
            { match: "\\b(0[xX][0-9A-Fa-f_]+(\\.[0-9A-Fa-f_]+)?[pP][+-]?[0-9_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(\\.[0-9_]*)?([eE][+-]?[0-9_]+)?)\\b", attr: "number" },
            { match: "([A-Za-z_][A-Za-z0-9_]*)\\s*\\(", captures: { 1: "function" }, consume: 1 },
            { match: "(\\?\\?|!|\\*\\*|<<|>>|==|!=|<=|>=|=>|->|[+*/%&|^~=<>&?-])", attr: "operator" },
            { match: "[(){}\\[\\]]", attr: "punct.bracket" }, { match: "[,;:.]", attr: "punct.delim" },
        ] },
        string: { default: "string", at_eol: "pop", unit: "atom", rules: [
            { match: "\\\\(x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\}|.)", attr: "string.escape" },
            { match: "\"", attr: "string", pop: 1 },
        ] },
        character: { default: "character", at_eol: "pop", unit: "atom", rules: [
            { match: "\\\\(x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\}|.)", attr: "string.escape" },
            { match: "'", attr: "character", pop: 1 },
        ] },
    },
}
