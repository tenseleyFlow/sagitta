# Lua syntax.
#
# Long strings and comments store the opening equals run and close only on the
# matching bracket.  Excessive nesting is handled by the engine's normal
# depth/lost accounting.  Malformed quoted strings are bounded to one line.
{
    syntax: 1,
    language: {
        name: "lua",
        extensions: ["lua"],
        shebangs: ["lua", "lua5.1", "lua5.2", "lua5.3", "lua5.4", "luajit"],
        priority: 20,
        comment: { line: "--", block: ["--[[", "]]" ] },
    },
    contexts: {
        main: { default: "text", rules: ["include:lua"] },
        lua: {
            rules: [
                { match: "--\\[(=*)\\[", attr: "comment", set_aux: 1,
                  push: "long_comment" },
                { match: "--.*$", attr: "comment" },
                { match: "\\[(=*)\\[", attr: "string.special", set_aux: 1,
                  push: "long_string" },
                { match: "\"", attr: "string", push: "dq" },
                { match: "'", attr: "string", push: "sq" },
                { match: "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_.:]*)",
                  attr: "keyword.storage", captures: { 2: "function" }, consume: 2 },
                { match: "\\b(local|function)\\b", attr: "keyword.storage" },
                { match: "\\b(if|then|elseif|else|end|for|while|repeat|until|do|break|return|goto)\\b",
                  attr: "keyword.control" },
                { match: "\\b(and|or|not|in)\\b", attr: "keyword.op" },
                { match: "\\b(true|false)\\b", attr: "boolean" },
                { match: "\\b(nil)\\b", attr: "constant.builtin" },
                { match: "\\b0[xX][0-9A-Fa-f]+(\\.[0-9A-Fa-f]+)?([pP][+-]?[0-9]+)?\\b|\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b",
                  attr: "number" },
                { match: "(//|<<|>>|==|~=|<=|>=|::|\\.\\.|[+*/%^#<>=-])", attr: "operator" },
                { match: "[(){}\\[\\]]", attr: "punct.bracket" },
                { match: "[,;:.]", attr: "punct.delim" },
                { match: "[A-Za-z_][A-Za-z0-9_]*", attr: "variable" },
            ],
        },
        dq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\\\\(z\\s*|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|[0-9]{1,3}|[abfnrtv\\\\\"'])", attr: "string.escape" },
                { match: "\\\\.", attr: "string.escape" },
                { match: "\"", attr: "string", pop: 1 },
            ],
        },
        sq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\\\\.", attr: "string.escape" },
                { match: "'", attr: "string", pop: 1 },
            ],
        },
        long_string: {
            default: "string.special", at_eol: "stay", unit: "atom",
            rules: [ { aux: "literal", aux_pre: "]", aux_post: "]",
                       attr: "string.special", pop: 1 } ],
        },
        long_comment: {
            default: "comment", at_eol: "stay", unit: "atom",
            rules: [ { aux: "literal", aux_pre: "]", aux_post: "]",
                       attr: "comment", pop: 1 } ],
        },
    },
}
