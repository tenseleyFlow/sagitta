# ECMAScript syntax, including HTML-tag JSX and tagged templates.
#
# Regex literals use the pinned one-bit previous-token heuristic: a slash is
# a regex opener only while `value` is clear.  `}` and `)` deliberately set
# the bit even though a block or control-flow head can instead permit a regex;
# those two known failures are bounded because `regex.at_eol` pops.
# Template interpolation contains the complete main rule body.  Its `braces`
# context balances object literals before `}` can return to the template.
{
    syntax: 1,
    language: {
        name: "javascript",
        extensions: ["js", "mjs", "cjs", "jsx"],
        shebangs: ["node", "nodejs"],
        priority: 0,
        comment: { line: "//", block: ["/*", "*/"] },
    },
    contexts: {
        main: { default: "text", at_eol: "stay", rules: [ "include:js_rules" ] },

        # Shared verbatim by main, interpolation expressions, and brace bodies.
        js_rules: {
            rules: [
                { match: "//.*$", attr: "comment" },
                { match: "/\\*", attr: "comment", push: "block_comment" },
                { match: "\"", attr: "string", push: "dq", value: true },
                { match: "'", attr: "string", push: "sq", value: true },

                # The closed tag table keeps dispatch deterministic.  gql is
                # allowed to fall back until a gql definition is installed.
                { match: "(html)(`)", attr: "string",
                  captures: { 1: "function", 2: "string" },
                  push: "tagged_html",
                  embed: { lang: "html", end: "inline",
                           fallback: "string" }, value: true },
                { match: "(css)(`)", attr: "string",
                  captures: { 1: "function", 2: "string" },
                  push: "tagged_css",
                  embed: { lang: "css", end: "inline",
                           fallback: "string" }, value: true },
                { match: "(gql)(`)", attr: "string",
                  captures: { 1: "function", 2: "string" },
                  push: "tagged_gql",
                  embed: { lang: "gql", end: "inline",
                           fallback: "string" }, value: true },
                { match: "`", attr: "string", push: "template", value: true },

                # Each JSX tag borrows HTML's tag context.  HTML delegates
                # attribute expressions back here; child expressions resume
                # in the surrounding JavaScript context.
                { match: "(<)([A-Za-z][A-Za-z0-9:.-]*)", attr: "tag",
                  captures: { 1: "punct.bracket", 2: "tag" },
                  push: "jsx_tree",
                  embed: { lang: "html", ctx: "jsx_tag",
                           end: "inline-root",
                           fallback: "text" }, value: true },

                # These two rules differ only in the previous-token predicate.
                { match: "/", attr: "string.special", if_value: false,
                  push: "regex", value: true },
                { match: "/=?", attr: "operator", if_value: true,
                  value: false },

                { match: "\\b(this|super|true|false|null|undefined)\\b",
                  attr: "constant.builtin", value: true },
                { match: "\\b(return|typeof|instanceof|in|of|new|delete|void|case|do|else|yield|await)\\b",
                  attr: "keyword.control", value: false },
                { match: "\\b(if|switch|while|for|with|catch|throw|try|finally|break|continue|debugger)\\b",
                  attr: "keyword.control", value: false },
                { match: "\\b(const|let|var|function|class|extends|import|export|from|default|async|get|set|static)\\b",
                  attr: "keyword.storage", value: false },

                { match: "\\b0[xX][0-9A-Fa-f]([0-9A-Fa-f_]*[0-9A-Fa-f])?n?\\b",
                  attr: "number", value: true },
                { match: "\\b0[bB][01]([01_]*[01])?n?\\b",
                  attr: "number", value: true },
                { match: "\\b0[oO][0-7]([0-7_]*[0-7])?n?\\b",
                  attr: "number", value: true },
                { match: "\\b[0-9]([0-9_]*[0-9])?(\\.[0-9]([0-9_]*[0-9])?)?([eE][+-]?[0-9]([0-9_]*[0-9])?)?n?\\b",
                  attr: "number", value: true },
                { match: "\\.[0-9]([0-9_]*[0-9])?([eE][+-]?[0-9]([0-9_]*[0-9])?)?\\b",
                  attr: "number", value: true },

                { match: "([A-Za-z_$][A-Za-z0-9_$]*)\\s*\\(",
                  captures: { 1: "function" }, consume: 1, value: true },
                { match: "\\.[A-Za-z_$][A-Za-z0-9_$]*", attr: "method",
                  value: true },
                { match: "[A-Za-z_$][A-Za-z0-9_$]*", attr: "variable",
                  value: true },

                # Postfix is the pinned interpretation for ++/--.
                { match: "(\\+\\+|--)", attr: "operator", value: true },
                { match: "(=>|===|!==|==|!=|<=|>=|\\*\\*|&&|\\|\\||\\?\\?|\\?\\.|<<|>>>|>>|\\+=|-=|\\*=|%=|&=|\\|=|\\^=|&&=|\\|\\|=|\\?\\?=|\\*\\*=|<<=|>>=|>>>=|[+*%&|^<>=!~?-])",
                  attr: "operator", value: false },
                { match: "[({\\[]", attr: "punct.bracket", value: false },
                { match: "[)}\\]]", attr: "punct.bracket", value: true },
                { match: "[,;:]", attr: "punct.delim", value: false },
                { match: "\\.", attr: "punct.delim", value: false },
            ],
        },

        block_comment: {
            default: "comment", at_eol: "stay", unit: "atom",
            rules: [
                { match: "\\b(TODO|FIXME|XXX)\\b", attr: "comment.todo" },
                { match: "\\*/", attr: "comment", pop: 1 },
            ],
        },
        dq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]{1,6}\\}|[0-7]{1,3}|[bfnrtv0'\"\\\\]|\\r?\\n)",
                  attr: "string.escape" },
                { match: "\\\\.", attr: "string.escape" },
                { match: "\"", attr: "string", pop: 1, value: true },
            ],
        },
        sq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]{1,6}\\}|[0-7]{1,3}|[bfnrtv0'\"\\\\]|\\r?\\n)",
                  attr: "string.escape" },
                { match: "\\\\.", attr: "string.escape" },
                { match: "'", attr: "string", pop: 1, value: true },
            ],
        },
        regex: {
            default: "string.special", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\\\\.", attr: "string.escape" },
                { match: "\\[", attr: "string.special", push: "regex_class" },
                { match: "/[dgimsuvy]*", attr: "string.special", pop: 1,
                  value: true },
            ],
        },
        regex_class: {
            default: "string.special", at_eol: "pop:2",
            rules: [
                { match: "\\\\.", attr: "string.escape" },
                { match: "\\]", attr: "string.special", pop: 1 },
            ],
        },
        template: {
            default: "string", at_eol: "stay", unit: "atom",
            rules: [
                { match: "\\\\.", attr: "string.escape" },
                { match: "\\$\\{", attr: "string.interp", push: "template_expr",
                  value: false },
                { match: "`", attr: "string", pop: 1, value: true },
            ],
        },
        tagged_html: {
            default: "string", at_eol: "stay", unit: "atom",
            rules: [
                { match: "\\$\\{", attr: "string.interp",
                  push: "template_expr", value: false },
                { match: "`", attr: "string", pop: 1, end: true,
                  value: true },
            ],
        },
        tagged_css: {
            default: "string", at_eol: "stay", unit: "atom",
            rules: [
                { match: "\\$\\{", attr: "string.interp",
                  push: "template_expr", value: false },
                { match: "`", attr: "string", pop: 1, end: true,
                  value: true },
            ],
        },
        tagged_gql: {
            default: "string", at_eol: "stay", unit: "atom",
            rules: [
                { match: "\\\\.", attr: "string.escape" },
                { match: "\\$\\{", attr: "string.interp",
                  push: "template_expr", value: false },
                { match: "`", attr: "string", pop: 1, end: true,
                  value: true },
            ],
        },
        jsx_tree: {
            default: "text", at_eol: "stay", unit: "span",
            rules: [
                { match: "/>", attr: "punct.bracket", pop: 1, end: true,
                  value: true },
                { match: "(</)([A-Za-z][A-Za-z0-9:.-]*)(\\s*>)",
                  attr: "tag",
                  captures: { 1: "punct.bracket", 2: "tag",
                              3: "punct.bracket" }, pop: 1, end: true,
                  value: true },
            ],
        },
        template_expr: {
            default: "text", at_eol: "stay", unit: "span",
            rules: [
                { match: "}", attr: "string.interp", pop: 1, value: true },
                { match: "{", attr: "punct.bracket", push: "braces",
                  value: false },
                "include:js_rules",
            ],
        },
        braces: {
            default: "text", at_eol: "stay", unit: "span",
            rules: [
                { match: "{", attr: "punct.bracket", push: "braces",
                  value: false },
                { match: "}", attr: "punct.bracket", pop: 1, value: true },
                "include:js_rules",
            ],
        },
    },
}
