# fish shell syntax.
# Deliberate limits: command position is not parsed, and parenthesized command
# substitutions balance one nested level.  Unterminated ordinary strings pop
# at EOL unless fish's explicit backslash-newline has already been consumed.
{
    syntax: 1,
    language: {
        name: "fish",
        extensions: ["fish"],
        shebangs: ["fish"],
        priority: 0,
        comment: { line: "#" },
    },
    contexts: {
        main: {
            default: "text",
            rules: [
                { match: "^#!.*$", attr: "preproc", first_line: true },
                { match: "\\(", attr: "string.interp", push: "cmd_sub" },
                "include:fish",
            ],
        },
        fish: {
            rules: [
                { match: "#.*$", attr: "comment" },
                { match: "'", attr: "string", push: "sq" },
                { match: "\"", attr: "string", push: "dq" },
                { match: "\\\\.", attr: "string.escape" },
                { match: "\\$[A-Za-z_][A-Za-z0-9_]*|\\$[0-9]+|\\$argv\\[[^]\\n]+\\]",
                  attr: "variable" },
                { match: "\\b(if|else|end|switch|case|while|for|in|break|continue|return|begin|function)\\b",
                  attr: "keyword.control" },
                { match: "\\b(set|function|builtin|command|exec|source|status|read|string|math|count|contains|test|printf|echo|cd|pwd|eval)\\b",
                  attr: "function.builtin" },
                { match: "--[A-Za-z0-9][A-Za-z0-9_-]*|-[A-Za-z]+", attr: "constant" },
                { match: "[0-9]+(\\.[0-9]+)?", attr: "number" },
                { match: "&&|\\|\\||[|&;<>^]", attr: "operator" },
                { match: "[(){}\\[\\]]", attr: "punct.bracket" },
            ],
        },
        sq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\\\\['\\\\]", attr: "string.escape" },
                { match: "'", attr: "string", pop: 1 },
            ],
        },
        dq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\\\\[$\"\\\\]", attr: "string.escape" },
                { match: "\\$[A-Za-z_][A-Za-z0-9_]*|\\$[0-9]+", attr: "variable" },
                { match: "\\(", attr: "string.interp", push: "cmd_sub" },
                { match: "\"", attr: "string", pop: 1 },
            ],
        },
        cmd_sub: {
            default: "text", at_eol: "stay", unit: "span",
            rules: [
                { match: "\\)", attr: "string.interp", pop: 1 },
                { match: "\\(", attr: "punct.bracket", push: "cmd_nested" },
            ],
        },
        cmd_nested: {
            default: "text", at_eol: "stay", unit: "span",
            rules: [
                { match: "\\)", attr: "punct.bracket", pop: 1 },
                { match: "\\(", attr: "punct.bracket", push: "cmd_nested" },
            ],
        },
    },
}
