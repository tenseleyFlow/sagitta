# Protocol Buffers syntax. Field-number styling is lexical and does not
# validate reserved ranges or declaration placement. Option names and type
# paths are likewise highlighted by shape. Strings end at EOL when malformed;
# block comments keep their C-like multiline lifetime.
{
    syntax: 1,
    language: {
        name: "protobuf", extensions: ["proto"], priority: 0,
        comment: { line: "//", block: ["/*", "*/"] },
    },
    contexts: {
        main: {
            default: "text",
            rules: [
                { match: "//.*$", attr: "comment" },
                { match: "/\\*", attr: "comment", push: "block_comment" },
                { match: "\"", attr: "string", push: "dq" },
                { match: "'", attr: "string", push: "sq" },
                { match: "\\b(message|enum|service|rpc|returns|syntax|edition|package|import|option|repeated|optional|required|reserved|extensions|extend|oneof|map|group|stream|to|max)\\b", attr: "keyword.storage" },
                { match: "\\b(double|float|int32|int64|uint32|uint64|sint32|sint64|fixed32|fixed64|sfixed32|sfixed64|bool|string|bytes)\\b", attr: "type.builtin" },
                { match: "\\b(true|false)\\b", attr: "boolean" },
                { match: "\\b[A-Z][A-Za-z0-9_]*(\\.[A-Z][A-Za-z0-9_]*)*", attr: "type" },
                { match: "\\([A-Za-z_][A-Za-z0-9_.]*\\)", attr: "attribute" },
                { match: "=\\s*([0-9]+)", attr: "operator", captures: { 1: "number" } },
                { match: "\\b(0[xX][0-9A-Fa-f]+|[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?)\\b", attr: "number" },
                { match: "[=+-]", attr: "operator" },
                { match: "[{}()\\[\\]<>]", attr: "punct.bracket" },
                { match: "[,;:.]", attr: "punct.delim" },
                { match: "[A-Za-z_][A-Za-z0-9_]*", attr: "variable.member" },
            ],
        },
        block_comment: {
            default: "comment", at_eol: "stay", unit: "atom",
            rules: [
                { match: "\\b(TODO|FIXME|XXX)\\b", attr: "comment.todo" },
                { match: "\\*/", attr: "comment", pop: 1 },
            ],
        },
        dq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\\\\(a|b|f|n|r|t|v|\\\\|\"|'|x[0-9A-Fa-f]{2}|[0-7]{1,3})", attr: "string.escape" },
                { match: "\"", attr: "string", pop: 1 },
            ],
        },
        sq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\\\\(a|b|f|n|r|t|v|\\\\|\"|'|x[0-9A-Fa-f]{2}|[0-7]{1,3})", attr: "string.escape" },
                { match: "'", attr: "string", pop: 1 },
            ],
        },
    },
}
