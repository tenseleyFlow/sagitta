# Python 3 syntax.
#
# Triple-quoted strings are always `string`, including docstrings.  Correctly
# identifying statement-position docstrings needs suite history that a line
# state machine does not have; under-styling is safer than painting assigned
# triple strings as documentation.
#
# F-string expressions use the ordinary Python rules and balance nested curly
# braces.  Quotes inside an expression therefore cannot close the outer
# f-string.  Version-dependent expression errors (including pre-3.12
# backslashes) are deliberately styled, not diagnosed.
{
    syntax: 1,

    language: {
        name:       "python",
        extensions: ["py", "pyw", "pyi"],
        filenames:  ["SConstruct", "SConscript", "wscript"],
        shebangs:   ["python", "python2", "python3", "pypy", "pypy3"],
        priority:   20,
        comment:    { line: "#" },
    },

    contexts: {
        main: {
            default: "text",
            rules: [ "include:python" ],
        },

        # Shared by the root, f-string expressions, and nested brace bodies.
        python: {
            rules: [
                # Mixing tabs and spaces in leading indentation is almost
                # always accidental.  Either ordering catches the first
                # transition between the two byte kinds.
                { match: "^([ ]+\\t|\\t+[ ])[ \\t]*", attr: "warning" },
                { match: "^\\s*#\\s*type\\s*:.*$", attr: "comment.doc" },
                { match: "#.*$", attr: "comment" },

                # F-prefixed forms must precede ordinary prefixed strings.
                { match: "\\b([fF][rR]?|[rR][fF])(\"\"\"|''')",
                  attr: "string", set_aux: 2, push: "fstring_triple" },
                { match: "\\b([fF][rR]?|[rR][fF])(\"|')",
                  attr: "string", set_aux: 2, push: "fstring" },
                { match: "(\"\"\"|''')", attr: "string", set_aux: 1,
                  push: "triple" },
                { match: "\\b([rRbBuU]|[rR][bB]|[bB][rR])(\"\"\"|''')",
                  attr: "string", set_aux: 2, push: "triple" },
                { match: "\\b([rR]|[bB]|[uU]|[rR][bB]|[bB][rR])\"",
                  attr: "string", push: "dq" },
                { match: "\\b([rR]|[bB]|[uU]|[rR][bB]|[bB][rR])'",
                  attr: "string", push: "sq" },
                { match: "\"", attr: "string", push: "dq" },
                { match: "'", attr: "string", push: "sq" },

                { match: "(@[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*)",
                  attr: "attribute" },
                { match: "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                  attr: "keyword.storage", captures: { 2: "function" },
                  consume: 2 },
                { match: "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                  attr: "keyword.storage", captures: { 2: "type" },
                  consume: 2 },
                { match: "(->|:)\\s*([A-Za-z_][A-Za-z0-9_.]*)",
                  attr: "punct.delim", captures: { 2: "type" } },

                { match: "\\b(if|elif|else|for|while|break|continue|return|raise|try|except|finally|with|yield|await|match|case)\\b",
                  attr: "keyword.control" },
                { match: "\\b(def|class|lambda|async|from|import|as|global|nonlocal|assert|del|pass)\\b",
                  attr: "keyword.storage" },
                { match: "\\b(and|or|not|in|is)\\b", attr: "keyword.op" },
                { match: "\\b(True|False)\\b", attr: "boolean" },
                { match: "\\b(None|NotImplemented|Ellipsis)\\b",
                  attr: "constant.builtin" },
                { match: "\\b(self|cls)\\b", attr: "variable.builtin" },
                { match: "\\b(abs|aiter|all|anext|any|ascii|bin|bool|breakpoint|bytearray|bytes|callable|chr|classmethod|compile|complex|delattr|dict|dir|divmod|enumerate|eval|exec|filter|float|format|frozenset|getattr|globals|hasattr|hash|help|hex|id|input|int|isinstance|issubclass|iter|len|list|locals|map|max|memoryview|min|next|object|oct|open|ord|pow|print|property|range|repr|reversed|round|set|setattr|slice|sorted|staticmethod|str|sum|super|tuple|type|vars|zip|__import__)\\b",
                  attr: "function.builtin" },

                { match: "\\b0[bB][01]([01_]*[01])?[jJ]?\\b", attr: "number" },
                { match: "\\b0[oO][0-7]([0-7_]*[0-7])?[jJ]?\\b", attr: "number" },
                { match: "\\b0[xX][0-9A-Fa-f]([0-9A-Fa-f_]*[0-9A-Fa-f])?[jJ]?\\b",
                  attr: "number" },
                { match: "((([0-9]([0-9_]*[0-9])?)?\\.[0-9]([0-9_]*[0-9])?|[0-9]([0-9_]*[0-9])?\\.)([eE][+-]?[0-9]([0-9_]*[0-9])?)?|[0-9]([0-9_]*[0-9])?[eE][+-]?[0-9]([0-9_]*[0-9])?)[jJ]?\\b",
                  attr: "number" },
                { match: "\\b[0-9]([0-9_]*[0-9])?[jJ]?\\b", attr: "number" },

                { match: "(\\*\\*|//|<<|>>|:=|==|!=|<=|>=|->|[+*/%@&|^~<>=-])",
                  attr: "operator" },
                { match: "[(){}\\[\\]]", attr: "punct.bracket" },
                { match: "[,;:.]", attr: "punct.delim" },
            ],
        },

        dq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\\\\(N\\{[^}\\n]+\\}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|x[0-9A-Fa-f]{2}|[0-7]{1,3}|[\\\\'\"abfnrtv])",
                  attr: "string.escape" },
                { match: "\\\\.", attr: "string.escape" },
                { match: "\"", attr: "string", pop: 1 },
            ],
        },
        sq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\\\\(N\\{[^}\\n]+\\}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|x[0-9A-Fa-f]{2}|[0-7]{1,3}|[\\\\'\"abfnrtv])",
                  attr: "string.escape" },
                { match: "\\\\.", attr: "string.escape" },
                { match: "'", attr: "string", pop: 1 },
            ],
        },
        triple: {
            default: "string", at_eol: "stay", unit: "atom",
            rules: [
                { match: "\\\\(N\\{[^}\\n]+\\}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|x[0-9A-Fa-f]{2}|[0-7]{1,3}|.)",
                  attr: "string.escape" },
                { aux: "literal", attr: "string", pop: 1 },
            ],
        },

        fstring: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [ "include:fstring_body" ],
        },
        fstring_triple: {
            default: "string", at_eol: "stay", unit: "atom",
            rules: [ "include:fstring_body" ],
        },
        fstring_body: {
            rules: [
                { match: "\\{\\{|\\}\\}", attr: "string.escape" },
                { match: "\\{", attr: "string.interp", push: "fstring_expr" },
                { match: "\\\\.", attr: "string.escape" },
                { aux: "literal", attr: "string", pop: 1 },
            ],
        },
        fstring_expr: {
            default: "text", at_eol: "stay", unit: "span",
            rules: [
                { match: "\\}", attr: "string.interp", pop: 1 },
                { match: "\\{", attr: "punct.bracket", push: "fstring_braces" },
                { match: "![rsa]", attr: "string.special" },
                { match: ":", attr: "string.special", push: "fstring_spec" },
                "include:python",
            ],
        },
        fstring_braces: {
            default: "text", at_eol: "stay", unit: "span",
            rules: [
                { match: "\\}", attr: "punct.bracket", pop: 1 },
                { match: "\\{", attr: "punct.bracket", push: "fstring_braces" },
                "include:python",
            ],
        },
        fstring_spec: {
            default: "string.special", at_eol: "stay", unit: "span",
            rules: [
                { match: "\\{\\{|\\}\\}", attr: "string.escape" },
                { match: "\\{", attr: "string.interp", push: "fstring_expr" },
                { match: "\\}", attr: "string.interp", pop: 2 },
            ],
        },
    },
}
