# Perl syntax.
#
# Quote-like and regex operators are recognized as complete line-bounded
# forms; arbitrary user-selected paired delimiters are not balanced.  Plain
# and quoted heredocs begin on the next line and require column-zero closers.
# Perl's indented <<~ heredoc is intentionally deferred by Sprint 42.5.
{
    syntax: 1,
    language: { name: "perl", extensions: ["pl", "pm", "t"], shebangs: ["perl"], priority: 20, comment: { line: "#" } },
    contexts: {
        main: { default: "text", rules: ["include:perl"] },
        perl: { rules: [
            { match: "#.*$", attr: "comment" },
            { match: "<<\\s*'([A-Za-z_][A-Za-z0-9_]*)'", attr: "operator", captures: { 1: "string" }, set_aux: 1, push: "heredoc_pending_raw" },
            { match: "<<\\s*\"([A-Za-z_][A-Za-z0-9_]*)\"", attr: "operator", captures: { 1: "string" }, set_aux: 1, push: "heredoc_pending" },
            { match: "<<\\s*([A-Za-z_][A-Za-z0-9_]*)", attr: "operator", captures: { 1: "string" }, set_aux: 1, push: "heredoc_pending" },
            { match: "q\\{([^}]|\\\\.)*}", attr: "string.special" },
            { match: "qq\\{([^}]|\\\\.)*}", attr: "string" },
            { match: "s/([^/\\\\]|\\\\.)*/([^/\\\\]|\\\\.)*/[a-z]*", attr: "string.special" },
            { match: "m?/([^/\\\\]|\\\\.)+/[a-z]*", attr: "string.special" },
            { match: "\"", attr: "string", push: "dq" },
            { match: "'", attr: "string.special", push: "sq" },
            { match: "`", attr: "string.special", push: "command" },
            { match: "[$@%][A-Za-z_][A-Za-z0-9_:]*|[$@%][0-9_?!@*#&`'+.-]", attr: "variable" },
            { match: "\\b(my|our|state|local|sub|package|use|require)\\b", attr: "keyword.storage" },
            { match: "\\b(if|elsif|else|unless|while|until|for|foreach|continue|given|when|default|last|next|redo|goto|return|die|exit)\\b", attr: "keyword.control" },
            { match: "\\b(and|or|xor|not|eq|ne|lt|gt|le|ge)\\b", attr: "keyword.op" },
            { match: "\\b(undef|__FILE__|__LINE__|__PACKAGE__|__SUB__)\\b", attr: "constant.builtin" },
            { match: "\\b[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?\\b|\\b0[xX][0-9A-Fa-f_]+\\b", attr: "number" },
            { match: "(=>|=~|!~|==|!=|<=|>=|\\*\\*|&&|\\|\\||//|<<|>>|[+*/%&|^~<>=!-])", attr: "operator" },
            { match: "[(){}\\[\\]]", attr: "punct.bracket" },
            { match: "[,;:.]", attr: "punct.delim" },
            { match: "[A-Za-z_][A-Za-z0-9_]*", attr: "text" },
        ] },
        dq: { default: "string", at_eol: "pop", unit: "atom", rules: ["include:interp", { match: "\\\\.", attr: "string.escape" }, { match: "\"", attr: "string", pop: 1 }] },
        sq: { default: "string.special", at_eol: "pop", unit: "atom", rules: [{ match: "\\\\['\\\\]", attr: "string.escape" }, { match: "'", attr: "string.special", pop: 1 }] },
        command: { default: "string.special", at_eol: "pop", unit: "atom", rules: ["include:interp", { match: "\\\\.", attr: "string.escape" }, { match: "`", attr: "string.special", pop: 1 }] },
        interp: { rules: [{ match: "[$@%][A-Za-z_][A-Za-z0-9_:]*|[$@%][0-9_?!@*#&`'+.-]", attr: "variable" }] },
        heredoc_pending: { default: "text", at_eol: "set:heredoc", rules: [] },
        heredoc_pending_raw: { default: "text", at_eol: "set:heredoc_raw", rules: [] },
        heredoc: { default: "string.special", at_eol: "stay", unit: "atom", rules: [{ aux: "line_eq", attr: "string", pop: 1 }, "include:interp", { match: "\\\\.", attr: "string.escape" }] },
        heredoc_raw: { default: "string.special", at_eol: "stay", unit: "atom", rules: [{ aux: "line_eq", attr: "string", pop: 1 }] },
    },
}
