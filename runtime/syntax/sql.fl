# SQL syntax: portable ANSI core with common PostgreSQL dollar strings.
# Deliberate limits: dialect-specific words are intentionally omitted and
# expression/statement roles are not parsed.  Single/double quoted constructs
# are line-bounded; block comments and dollar strings persist by lexical rule.
{
    syntax: 1,
    language: {
        name: "sql",
        extensions: ["sql"],
        priority: 0,
        comment: { line: "--", block: ["/*", "*/"] },
    },
    contexts: {
        main: {
            default: "text", icase: true,
            rules: [
                { match: "--.*$", attr: "comment" },
                { match: "/\\*", attr: "comment", push: "block_comment" },
                { match: "\\$([A-Za-z_][A-Za-z0-9_]*)?\\$", attr: "string.special",
                  set_aux: 1, push: "dollar_string" },
                { match: "[xXbBnN]'", attr: "string", push: "prefixed_sq" },
                { match: "'", attr: "string", push: "sq" },
                { match: "\"", attr: "string", push: "quoted_ident" },
                { match: "\\b(select|insert|update|delete|merge|from|where|group|by|having|order|limit|offset|fetch|into|values|set|join|inner|left|right|full|cross|natural|on|union|intersect|except|all|distinct|with|recursive|as|case|when|then|else|end|if|begin|commit|rollback|create|alter|drop|truncate|grant|revoke)\\b",
                  attr: "keyword.control" },
                { match: "\\b(table|view|index|schema|database|constraint|primary|foreign|references|unique|check|default|null|not)\\b",
                  attr: "keyword.storage" },
                { match: "\\b(and|or|not|is|in|like|between|exists|any|some)\\b",
                  attr: "keyword.op" },
                { match: "\\b(true|false)\\b", attr: "boolean" },
                { match: "\\b(null|current_date|current_time|current_timestamp|current_user)\\b",
                  attr: "constant.builtin" },
                { match: "\\b(smallint|integer|bigint|decimal|numeric|real|double|float|char|varchar|character|boolean|date|time|timestamp|interval|blob|clob)\\b",
                  attr: "type.builtin" },
                { match: "[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?", attr: "number" },
                { match: "<>|!=|<=|>=|\\|\\||[+*/%=<>-]", attr: "operator" },
                { match: "[()\\[\\]]", attr: "punct.bracket" },
                { match: "[,;.]", attr: "punct.delim" },
                { match: ":[A-Za-z_][A-Za-z0-9_]*|\\?", attr: "variable.param" },
            ],
        },
        block_comment: {
            default: "comment", at_eol: "stay", unit: "atom",
            rules: [
                { match: "\\b(TODO|FIXME|XXX)\\b", attr: "comment.todo" },
                { match: "\\*/", attr: "comment", pop: 1 },
            ],
        },
        sq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                { match: "''", attr: "string.escape" },
                { match: "'", attr: "string", pop: 1 },
            ],
        },
        prefixed_sq: {
            default: "string.special", at_eol: "pop", unit: "atom",
            rules: [
                { match: "''", attr: "string.escape" },
                { match: "'", attr: "string", pop: 1 },
            ],
        },
        quoted_ident: {
            default: "variable.member", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\"\"", attr: "string.escape" },
                { match: "\"", attr: "string", pop: 1 },
            ],
        },
        dollar_string: {
            default: "string.special", at_eol: "stay", unit: "atom",
            rules: [ { aux: "literal", aux_pre: "$", aux_post: "$",
                       attr: "string.special", pop: 1 } ],
        },
    },
}
