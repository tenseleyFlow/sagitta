# HCL / Terraform syntax.
#
# Template expressions are highlighted lexically rather than parsed: nested
# braces inside an expression are not balanced.  They must close on their
# physical line; a malformed template may therefore end heredoc highlighting
# early instead of leaking state.  Quoted templates end at EOL, and otherwise
# heredocs remain bounded by their captured delimiter.  `<<-` accepts leading
# ASCII horizontal whitespace there but does not model the dedent width.
{
    syntax: 1,
    language: {
        name: "hcl",
        extensions: ["hcl", "tf", "tfvars"],
        priority: 0,
        comment: { line: "#", block: ["/*", "*/"] },
    },
    contexts: {
        main: {
            default: "text",
            rules: [
                { match: "//.*$|#.*$", attr: "comment" },
                { match: "/\\*", attr: "comment", push: "block_comment" },
                { match: "<<-\\s*\"([A-Za-z_][A-Za-z0-9_]*)\"",
                  attr: "operator", captures: { 1: "string" }, set_aux: 1,
                  push: "heredoc_ws_pending" },
                { match: "<<-\\s*([A-Za-z_][A-Za-z0-9_]*)",
                  attr: "operator", captures: { 1: "string" }, set_aux: 1,
                  push: "heredoc_ws_pending" },
                { match: "<<\\s*\"([A-Za-z_][A-Za-z0-9_]*)\"",
                  attr: "operator", captures: { 1: "string" }, set_aux: 1,
                  push: "heredoc_pending" },
                { match: "<<\\s*([A-Za-z_][A-Za-z0-9_]*)",
                  attr: "operator", captures: { 1: "string" }, set_aux: 1,
                  push: "heredoc_pending" },
                { match: "\"", attr: "string", push: "dq" },
                { match: "\\b(true|false)\\b", attr: "boolean" },
                { match: "\\b(null)\\b", attr: "constant.builtin" },
                { match: "\\b(for|in|if|else)\\b", attr: "keyword.control" },
                { match: "\\b(resource|data|variable|output|module|provider|terraform|locals)\\b",
                  attr: "keyword.storage" },
                { match: "([A-Za-z_][A-Za-z0-9_-]*)\\s*(=)",
                  captures: { 1: "variable.member", 2: "operator" }, consume: 2 },
                { match: "[+-]?(0[xX][0-9A-Fa-f]+|[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?)",
                  attr: "number" },
                { match: "[{}\\[\\]()]", attr: "punct.bracket" },
                { match: "[?:,]", attr: "punct.delim" },
                { match: "==|!=|<=|>=|&&|\\|\\||=>|[+*/%<>!-]", attr: "operator" },
            ],
        },
        block_comment: {
            default: "comment", at_eol: "stay", unit: "atom",
            rules: [
                { match: "\\b(TODO|FIXME|XXX)\\b", attr: "comment.todo" },
                { match: "\\*/", attr: "comment", pop: 1 },
            ],
        },
        template_rules: {
            rules: [
                { match: "\\$\\{", attr: "string.interp", push: "template_expr" },
                { match: "%\\{", attr: "string.interp", push: "template_directive" },
                { match: "\\$\\$|%%", attr: "string.escape" },
            ],
        },
        dq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\\\\(n|r|t|\"|\\\\)", attr: "string.escape" },
                "include:template_rules",
                { match: "\"", attr: "string", pop: 1 },
            ],
        },
        template_expr: {
            default: "variable", at_eol: "pop:2", unit: "span",
            rules: [
                { match: "\"", attr: "string", push: "expr_string" },
                { match: "\\b(true|false)\\b", attr: "boolean" },
                { match: "[0-9]+(\\.[0-9]+)?", attr: "number" },
                { match: "[.\\[\\]()]", attr: "punct.bracket" },
                { match: "[:,?]", attr: "punct.delim" },
                { match: "[+*/%<>=!-]+", attr: "operator" },
                { match: "}", attr: "string.interp", pop: 1 },
            ],
        },
        expr_string: {
            default: "string", at_eol: "pop:3", unit: "atom",
            rules: [
                { match: "\\\\.", attr: "string.escape" },
                { match: "\"", attr: "string", pop: 1 },
            ],
        },
        template_directive: {
            default: "string.interp", at_eol: "pop:2", unit: "span",
            rules: [
                { match: "\\b(if|else|endif|for|endfor|in)\\b", attr: "keyword.control" },
                { match: "~?}", attr: "string.interp", pop: 1 },
            ],
        },
        heredoc_pending: { default: "text", at_eol: "set:heredoc" },
        heredoc_ws_pending: { default: "text", at_eol: "set:heredoc_ws" },
        heredoc: {
            default: "string.special", at_eol: "stay", unit: "atom",
            rules: [
                { aux: "line_eq", attr: "string", pop: 1 },
                "include:template_rules",
            ],
        },
        heredoc_ws: {
            default: "string.special", at_eol: "stay", unit: "atom",
            rules: [
                { aux: "line_eq_ws", attr: "string", pop: 1 },
                "include:template_rules",
            ],
        },
    },
}
