# Fixed-form Fortran.
#
# Columns 1-5 are the statement-label field, column 6 is continuation, and
# statement text begins in column 7.  C/c/*/! in column 1 is a whole-line
# comment; # in column 1 is a preprocessing directive.  A leading TAB is the
# documented vendor extension meaning "resume in column 7"; a following
# nonzero digit is its continuation marker.
#
# Columns 73+ are compiler-ignored card/sequence text and are styled comment.
# Syntax schema 1 has no current-column predicate, so the exact cutoff uses a
# whole-line capture.  Consequently a line longer than 72 columns gets exact
# ignored-tail styling but generic text (rather than token styling) in its
# first 72 columns.  Short statement lines receive the complete common rules.
#
# Matching is case-insensitive throughout.  Quotes escape only by doubling;
# backslash is ordinary data in standard Fortran.  Hollerith constants,
# INCLUDE-file following, statement functions, and ENTRY-specific parsing are
# outside this definition.
{
    syntax: 1,

    language: {
        name:       "fortran-fixed",
        extensions: ["f", "for", "ftn", "fpp"],
        priority:   20,
        comment:    { line: "!" },
    },

    contexts: {
        main: {
            default: "text",
            icase:   true,
            rules: [
                { match: "^[Cc*!].*$", attr: "comment" },
                { match: "^#.*$", attr: "preproc" },

                # This must precede token rules: after the scanner leaves byte
                # zero, the declarative engine can no longer test a physical
                # source column.  Capture 2 begins at column 73 exactly.
                { match: "^(.{72})(.+)$", attr: "text",
                  captures: { 2: "comment" } },

                # Vendor TAB form.  Highlight the tab as significant and a
                # following nonzero digit as the continuation marker.
                { match: "^(\\t)([1-9])",
                  captures: { 1: "whitespace.special", 2: "operator" } },
                { match: "^\\t", attr: "whitespace.special" },

                # Exact five-column label field followed by column 6.  The
                # alternation proves that at least one label digit occurs.
                { match: "^((?:[0-9][ 0-9]{4}| [0-9][ 0-9]{3}|  [0-9][ 0-9]{2}|   [0-9][ 0-9]|    [0-9]))([^ 0])",
                  attr: "text", captures: { 1: "label", 2: "operator" } },
                { match: "^((?:[0-9][ 0-9]{4}| [0-9][ 0-9]{3}|  [0-9][ 0-9]{2}|   [0-9][ 0-9]|    [0-9]))[ 0]",
                  attr: "text", captures: { 1: "label" } },
                { match: "^( {5})([^ 0])", attr: "text",
                  captures: { 2: "operator" } },
                { match: "^ {5}[ 0]", attr: "text" },

                "include:fortran_common",
            ],
        },

        # Rules mirror fortran.fl.  Cross-definition include/import is not
        # part of syntax schema 1.
        fortran_common: {
            rules: [
                { match: "!.*$", attr: "comment" },
                { match: "\\b[boxz]'[0-9a-f]+'", attr: "number" },
                { match: "'", attr: "string", push: "sq" },
                { match: "\"", attr: "string", push: "dq" },
                { match: "\\.(true|false)\\.", attr: "boolean" },
                { match: "\\.(and|or|not|eq|ne|lt|le|gt|ge|eqv|neqv)\\.",
                  attr: "keyword.op" },
                { match: "((([0-9]+\\.[0-9]*|\\.[0-9]+)([edq][+-]?[0-9]+)?|[0-9]+[edq][+-]?[0-9]+)(_[A-Za-z][A-Za-z0-9_]*|_[0-9]+)?)",
                  attr: "number" },
                { match: "\\b[0-9]+(_[A-Za-z][A-Za-z0-9_]*|_[0-9]+)?\\b",
                  attr: "number" },
                { match: "\\b(double\\s+precision|integer|real|complex|logical|character|type|class)\\b",
                  attr: "type.builtin" },
                { match: "\\b(intent|parameter|allocatable|pointer|target|dimension|optional|pure|impure|elemental|recursive|non_recursive|contiguous|asynchronous|volatile|value|external|intrinsic|protected|bind|save)\\b",
                  attr: "keyword.storage" },
                { match: "\\b(if|then|else|elseif|elsewhere|end|endif|enddo|endwhere|endselect|endassociate|endblock|endcritical|select|case|rank|type|class|default|do|while|concurrent|cycle|exit|return|stop|error\\s+stop|goto|go\\s+to|where|forall|associate|block|critical|continue)\\b",
                  attr: "keyword.control" },
                { match: "\\b(program|module|submodule|subroutine|function|use|import|implicit|none|interface|abstract|procedure|module\\s+procedure|call|result|contains|only|public|private|sequence)\\b",
                  attr: "keyword" },
                { match: "\\b(common|equivalence|data|format|namelist|read|write|print|open|close|inquire|backspace|endfile|rewind|flush|wait|allocate|deallocate|nullify|enum|enumerator|generic)\\b",
                  attr: "keyword" },
                { match: "\\b(final|pass|nopass|deferred|extends|kind|len|codimension|sync|all|images|memory|lock|unlock|event|post|team|change\\s+team|form\\s+team|fail\\s+image)\\b",
                  attr: "keyword" },
                { match: "\\b(abs|achar|acos|acosd|acosh|adjustl|adjustr|aimag|aint|alarm|all|allocated|anint|any|asin|asind|asinh|associated|atan|atan2|atan2d|atand|atanh)\\b",
                  attr: "function.builtin" },
                { match: "\\b(atomic_add|atomic_and|atomic_cas|atomic_define|atomic_fetch_add|atomic_fetch_and|atomic_fetch_or|atomic_fetch_xor|atomic_or|atomic_ref|atomic_xor|bessel_j0|bessel_j1|bessel_jn|bessel_y0|bessel_y1|bessel_yn|bge|bgt|ble|blt|bit_size|btest)\\b",
                  attr: "function.builtin" },
                { match: "\\b(c_associated|c_f_pointer|c_f_procpointer|c_funloc|c_loc|c_sizeof|ceiling|char|cmplx|co_broadcast|co_max|co_min|co_reduce|command_argument_count|compiler_options|compiler_version|conjg|cos|cosd|cosh|count|cpu_time|cshift|date_and_time|dble|digits|dim|dot_product|dprod|dshiftl|dshiftr)\\b",
                  attr: "function.builtin" },
                { match: "\\b(eoshift|epsilon|erf|erfc|erfc_scaled|event_query|execute_command_line|exp|exponent|extends_type_of|findloc|floor|fraction|gamma|get_command|get_command_argument|get_environment_variable|huge)\\b",
                  attr: "function.builtin" },
                { match: "\\b(hypot|iachar|iall|iand|iany|ibclr|ibits|ibset|ichar|ieor|image_index|index|int|ior|iparity|ishft|ishftc|is_iostat_end|is_iostat_eor|kind|lbound|lcobound|leadz|len|len_trim|lge|lgt|lle|llt)\\b",
                  attr: "function.builtin" },
                { match: "\\b(log|log10|log_gamma|logical|maskl|maskr|matmul|max|maxexponent|maxloc|maxval|merge|merge_bits|min|minexponent|minloc|minval|mod|modulo|move_alloc|mvbits|nearest)\\b",
                  attr: "function.builtin" },
                { match: "\\b(new_line|nint|norm2|not|null|num_images|out_of_range|pack|parity|popcnt|poppar|precision|present|product|radix|random_init|random_number|random_seed)\\b",
                  attr: "function.builtin" },
                { match: "\\b(range|rank|real|repeat|reshape|rrspacing|same_type_as|scale|scan|selected_char_kind|selected_int_kind|selected_logical_kind|selected_real_kind|set_exponent|shape|shifta|shiftl|shiftr)\\b",
                  attr: "function.builtin" },
                { match: "\\b(sign|sin|sind|sinh|size|spacing|spread|sqrt|storage_size|sum|system_clock|tan|tand|tanh|this_image|tiny|trailz|transfer|transpose|trim|ubound|ucobound|unpack|verify)\\b",
                  attr: "function.builtin" },
                { match: "([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",
                  captures: { 1: "function" }, consume: 1 },
                { match: "\\.[A-Za-z_][A-Za-z0-9_]*\\.", attr: "operator" },
                { match: "(=>|::|//|\\*\\*|/=|==|<=|>=|[+*/=<>%-])",
                  attr: "operator" },
                { match: "[()\\[\\]]", attr: "punct.bracket" },
                { match: "[,;:]", attr: "punct.delim" },
            ],
        },

        sq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                { match: "''", attr: "string.escape" },
                { match: "'", attr: "string", pop: 1 },
            ],
        },
        dq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\"\"", attr: "string.escape" },
                { match: "\"", attr: "string", pop: 1 },
            ],
        },
    },
}
