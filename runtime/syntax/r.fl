# R syntax.
#
# Raw strings retain the optional dash fence in aux and close only on the
# matching `)` fence quote.  Backtick identifiers and percent operators are
# lexical tokens; parser-level call and namespace distinctions are not guessed.
{
    syntax: 1,
    language: { name: "r", extensions: ["r"], filenames: [".Rprofile"], priority: 20, comment: { line: "#" } },
    contexts: {
        main: { default: "text", rules: [
            { match: "#.*$", attr: "comment" },
            { match: "[rR]\"(-*)\\(", attr: "string.special", set_aux: 1, push: "raw" },
            { match: "\"", attr: "string", push: "dq" },
            { match: "'", attr: "string", push: "sq" },
            { match: "`", attr: "variable", push: "backtick" },
            { match: "%[^%\\n]+%", attr: "operator" },
            { match: "\\b(function|if|else|for|while|repeat|in|next|break|return)\\b", attr: "keyword.control" },
            { match: "\\b(TRUE|FALSE|T|F)\\b", attr: "boolean" },
            { match: "\\b(NULL|NA|NA_integer_|NA_real_|NA_complex_|NA_character_|Inf|NaN)\\b", attr: "constant.builtin" },
            { match: "\\b[0-9][0-9.]*(e[+-]?[0-9]+)?[Li]?\\b", attr: "number", icase: true },
            { match: "(<-|<<-|->>|->|:::+|\\$|@|==|!=|<=|>=|&&|\\|\\||[+*/^:<>=!~-])", attr: "operator" },
            { match: "[(){}\\[\\]]", attr: "punct.bracket" },
            { match: "[,;]", attr: "punct.delim" },
            { match: "[A-Za-z_.][A-Za-z0-9_.]*", attr: "variable" },
        ] },
        dq: { default: "string", at_eol: "pop", unit: "atom", rules: [{ match: "\\\\.", attr: "string.escape" }, { match: "\"", attr: "string", pop: 1 }] },
        sq: { default: "string", at_eol: "pop", unit: "atom", rules: [{ match: "\\\\.", attr: "string.escape" }, { match: "'", attr: "string", pop: 1 }] },
        backtick: { default: "variable", at_eol: "pop", unit: "atom", rules: [{ match: "\\\\.", attr: "string.escape" }, { match: "`", attr: "variable", pop: 1 }] },
        raw: { default: "string.special", at_eol: "stay", unit: "atom", rules: [{ aux: "literal", aux_pre: ")", aux_post: "\"", attr: "string.special", pop: 1 }] },
    },
}
