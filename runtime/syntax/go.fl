# Go syntax.  This is intentionally the plain language-pack template: six
# contexts, no aux state, and no token-history flag.  Backtick strings are
# raw and multiline; a backslash in one is ordinary text.  Struct tags use
# string.special, which is also the honest styling for other raw strings.
{
    syntax: 1,
    language: {
        name: "go",
        extensions: ["go"],
        priority: 0,
        comment: { line: "//", block: ["/*", "*/"] },
    },
    contexts: {
        main: {
            default: "text",
            rules: [
                { match: "^\\s*//go:build\\b.*$", attr: "preproc" },
                { match: "^\\s*//\\s+\\+build\\b.*$", attr: "preproc" },
                { match: "//.*$", attr: "comment" },
                { match: "/\\*", attr: "comment", push: "block_comment" },

                { match: "\\bfunc\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",
                  attr: "keyword.storage", captures: { 1: "function" },
                  consume: 1 },
                { match: "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*:\\s*($|[^=])",
                  captures: { 1: "label" }, consume: 1 },

                { match: "\\b(break|case|continue|default|defer|else|fallthrough|for|go|goto|if|range|return|select|switch)\\b",
                  attr: "keyword.control" },
                { match: "\\b(chan|const|func|import|interface|map|package|struct|type|var)\\b",
                  attr: "keyword.storage" },
                { match: "\\b(append|cap|clear|close|complex|copy|delete|imag|len|make|max|min|new|panic|print|println|real|recover)\\b",
                  attr: "function.builtin" },
                { match: "\\b(any|bool|byte|comparable|complex64|complex128|error|float32|float64|int|int8|int16|int32|int64|rune|string|uint|uint8|uint16|uint32|uint64|uintptr)\\b",
                  attr: "type.builtin" },
                { match: "\\biota\\b", attr: "constant.builtin" },
                { match: "\\b(true|false)\\b", attr: "boolean" },
                { match: "\\bnil\\b", attr: "constant.builtin" },

                { match: "\"", attr: "string", push: "dq" },
                { match: "`", attr: "string.special", push: "raw" },
                { match: "'", attr: "character", push: "rune" },

                { match: "\\b0[xX][0-9A-Fa-f]([0-9A-Fa-f_]*[0-9A-Fa-f])?([pP][+-]?[0-9]([0-9_]*[0-9])?)?i?\\b",
                  attr: "number" },
                { match: "\\b0[bB][01]([01_]*[01])?i?\\b", attr: "number" },
                { match: "\\b0[oO][0-7]([0-7_]*[0-7])?i?\\b", attr: "number" },
                { match: "\\b[0-9]([0-9_]*[0-9])?(\\.[0-9]([0-9_]*[0-9])?)?([eE][+-]?[0-9]([0-9_]*[0-9])?)?i?\\b",
                  attr: "number" },
                { match: "\\.[0-9]([0-9_]*[0-9])?([eE][+-]?[0-9]([0-9_]*[0-9])?)?i?\\b",
                  attr: "number" },

                { match: "(:=|<<=|>>=|&\\^=|\\+\\+|--|==|!=|<=|>=|&&|\\|\\||<-|<<|>>|&\\^|[+*/%&|^<>=!-])",
                  attr: "operator" },
                { match: "[(){}\\[\\]]", attr: "punct.bracket" },
                { match: "[,;:.]", attr: "punct.delim" },
            ],
        },

        block_comment: {
            default: "comment", at_eol: "stay", unit: "atom",
            rules: [ { match: "\\*/", attr: "comment", pop: 1 } ],
        },
        dq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                "include:escapes",
                { match: "\\\\.", attr: "error" },
                { match: "\"", attr: "string", pop: 1 },
            ],
        },
        raw: {
            default: "string.special", at_eol: "stay", unit: "atom",
            rules: [ { match: "`", attr: "string.special", pop: 1 } ],
        },
        rune: {
            default: "character", at_eol: "pop", unit: "atom",
            rules: [
                "include:escapes",
                { match: "\\\\.", attr: "error" },
                { match: "'", attr: "character", pop: 1 },
            ],
        },
        escapes: {
            rules: [
                { match: "\\\\(a|b|f|n|r|t|v|\\\\|\"|'|[0-7]{3}|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
                  attr: "string.escape" },
            ],
        },
    },
}
