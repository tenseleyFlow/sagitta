# CSS syntax.  It highlights selectors, declarations, at-rules, custom
# properties, functions, colors, dimensions, strings, and comments without
# attempting selector or value validation.
{
    syntax: 1,
    language: {
        name: "css",
        extensions: ["css"],
        priority: 0,
        comment: { block: ["/*", "*/"] },
    },
    contexts: {
        main: {
            default: "text", at_eol: "stay",
            rules: [ "include:css_rules" ],
        },
        css_rules: {
            rules: [
                { match: "\\$\\{", attr: "string.interp", push: "js_expr",
                  embed: { lang: "javascript", ctx: "template_expr",
                           end: "inline-root", fallback: "text" } },
                { match: "/\\*", attr: "comment", push: "comment" },
                { match: "\\\\.", attr: "string.escape" },
                { match: "\"", attr: "string", push: "dq" },
                { match: "'", attr: "string", push: "sq" },
                { match: "@[A-Za-z-]+", attr: "preproc" },
                { match: "(--[A-Za-z_][A-Za-z0-9_-]*)\\s*:",
                  captures: { 1: "variable" }, consume: 1 },
                { match: "([A-Za-z_-][A-Za-z0-9_-]*)\\s*:",
                  captures: { 1: "variable.member" }, consume: 1 },
                { match: "(var|calc|min|max|clamp|rgb|rgba|hsl|hsla|url)\\s*\\(",
                  captures: { 1: "function.builtin" }, consume: 1,
                  icase: true },
                { match: "[A-Za-z_-][A-Za-z0-9_-]*\\s*\\(",
                  attr: "function", consume: 0 },
                { match: "#[0-9A-Fa-f]{3,8}\\b", attr: "constant" },
                { match: "[-+]?(\\.[0-9]+|[0-9]+(\\.[0-9]+)?)(%|[A-Za-z]+)?",
                  attr: "number" },
                { match: "!important\\b", attr: "keyword", icase: true },
                { match: "\\b(inherit|initial|revert|revert-layer|unset|none|auto|normal|transparent|currentColor)\\b",
                  attr: "constant.builtin", icase: true },
                { match: "\\{", attr: "punct.bracket", push: "block" },
                { match: "[\\[\\]()]", attr: "punct.bracket" },
                { match: "[,:;]", attr: "punct.delim" },
                { match: "[>+~*=|^$]", attr: "operator" },
                { match: "\\.[A-Za-z_-][A-Za-z0-9_-]*", attr: "type" },
                { match: "#[A-Za-z_-][A-Za-z0-9_-]*", attr: "label" },
                { match: "[A-Za-z_-][A-Za-z0-9_-]*", attr: "tag" },
            ],
        },
        block: {
            default: "text", at_eol: "stay", unit: "span",
            rules: [
                { match: "}", attr: "punct.bracket", pop: 1 },
                "include:css_rules",
            ],
        },
        comment: {
            default: "comment", at_eol: "stay", unit: "atom",
            rules: [
                { match: "\\b(TODO|FIXME|XXX)\\b", attr: "comment.todo" },
                { match: "\\*/", attr: "comment", pop: 1 },
            ],
        },
        dq: {
            default: "string", at_eol: "stay", unit: "atom",
            rules: [
                { match: "\\$\\{", attr: "string.interp", push: "js_expr",
                  embed: { lang: "javascript", ctx: "template_expr",
                           end: "inline-root", fallback: "text" } },
                { match: "\\\\([0-9A-Fa-f]{1,6}[ \\t]?|.)",
                  attr: "string.escape" },
                { match: "\"", attr: "string", pop: 1 },
            ],
        },
        sq: {
            default: "string", at_eol: "stay", unit: "atom",
            rules: [
                { match: "\\$\\{", attr: "string.interp", push: "js_expr",
                  embed: { lang: "javascript", ctx: "template_expr",
                           end: "inline-root", fallback: "text" } },
                { match: "\\\\([0-9A-Fa-f]{1,6}[ \\t]?|.)",
                  attr: "string.escape" },
                { match: "'", attr: "string", pop: 1 },
            ],
        },
        js_expr: {
            default: "text", at_eol: "stay", unit: "span",
            rules: [
                { match: "}", attr: "punct.bracket", pop: 1, end: true },
            ],
        },
    },
}
