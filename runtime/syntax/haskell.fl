# Haskell syntax. Layout, type/value namespace resolution, and fixity are
# parser concerns; operators and qualified names receive stable lexical
# styling. Nested comments retain depth. Literate Bird and LaTeX delimiters
# are recognized, but prose/code selection is deliberately not stateful.
{
    syntax: 1,
    language: {
        name: "haskell", extensions: ["hs", "lhs"], priority: 0,
        comment: { line: "--", block: ["{-", "-}"] },
    },
    contexts: {
        main: {
            default: "text",
            rules: [
                { match: "^\\s*(>|\\\\begin\\{code\\}|\\\\end\\{code\\})", attr: "preproc" },
                { match: "\\{-#", attr: "preproc", push: "pragma" },
                { match: "--.*$", attr: "comment" },
                { match: "\\{-", attr: "comment", push: "block_comment" },
                { match: "\"", attr: "string", push: "dq" },
                { match: "'", attr: "character", push: "char" },
                { match: "\\b(module|import|qualified|as|hiding|where|let|in|case|of|if|then|else|do|class|instance|data|newtype|type|deriving|forall|foreign|default|infix|infixl|infixr)\\b", attr: "keyword.control" },
                { match: "\\b(True|False)\\b", attr: "boolean" },
                { match: "\\b[A-Z][A-Za-z0-9_']*(\\.[A-Z][A-Za-z0-9_']*)+", attr: "namespace" },
                { match: "\\b[A-Z][A-Za-z0-9_']*", attr: "type" },
                { match: "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b", attr: "number" },
                { match: "[!#$%&*+./<=>?@\\\\^|:~-]+", attr: "operator" },
                { match: "[(){}\\[\\]]", attr: "punct.bracket" },
                { match: "[,;]", attr: "punct.delim" },
                { match: "[a-z_][A-Za-z0-9_']*", attr: "variable" },
            ],
        },
        block_comment: {
            default: "comment", at_eol: "stay", unit: "atom",
            rules: [
                { match: "\\{-", attr: "comment", push: "block_comment" },
                { match: "-\\}", attr: "comment", pop: 1 },
            ],
        },
        pragma: {
            default: "preproc", at_eol: "stay", unit: "atom",
            rules: [ { match: "#-\\}", attr: "preproc", pop: 1 } ],
        },
        dq: {
            default: "string", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\\\\(n|r|t|\\\\|\"|'|&|[0-9]+)", attr: "string.escape" },
                { match: "\"", attr: "string", pop: 1 },
            ],
        },
        char: {
            default: "character", at_eol: "pop", unit: "atom",
            rules: [
                { match: "\\\\(n|r|t|\\\\|'|\")", attr: "string.escape" },
                { match: "'", attr: "character", pop: 1 },
            ],
        },
    },
}
