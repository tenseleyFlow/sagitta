.fac/
.claude/
# The Fletch spec is the one thing under .docs/ that is NORMATIVE rather
# than planning: Sprint 28 freezes it, sprints 29-58 cite its sections by
# number, and later sprints amend it in §16.  A frozen contract with no
# history — nothing to diff, blame, or review an amendment against — is
# not frozen, so this one file is tracked while the corpus around it
# stays local.
#
# `.docs/*` rather than `.docs/`: git cannot re-include a file whose
# PARENT DIRECTORY is excluded, so ignoring the directory itself would
# make the negation below silently do nothing.  Excluding the entries
# instead leaves the directory visible and the one exception effective.
.docs/*
!.docs/fletch-spec.md
.git/
.idea/
.vscode/

CLAUDE.md
AGENTS.md

#
# EVERY build directory, not an enumerated few.
#
# The list used to name build/, build-san/, build-clang/, build-cov/ and
# build-vg/ individually, so the first ad-hoc tree that did not match --
# build-sanc/, from a one-off clang sanitizer run -- committed 24 MB of
# instrumented binaries before anyone noticed.  A glob costs nothing and
# cannot be outrun by the next invented name.
#
build*/
compile_commands.json
*.a
*.o
*.d

# Editor and operating-system droppings.
*~
*.swp
*.swo
.#*
.DS_Store

# Minimized fuzz inputs land here at runtime.  The directory itself is
# tracked (via .gitkeep) because fuzzlib writes into it and a fresh
# clone must have it; the artifacts are not.
tests/fuzz/crashes/*
!tests/fuzz/crashes/.gitkeep
